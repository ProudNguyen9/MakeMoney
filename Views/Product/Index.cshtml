@functions {
    string ToCategorySlug(string? categoryName)
    {
        if (string.IsNullOrWhiteSpace(categoryName))
        {
            return "tat-ca";
        }

        var normalized = categoryName.Trim().ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var builder = new System.Text.StringBuilder();

        foreach (var character in normalized)
        {
            var unicodeCategory = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(character);

            if (unicodeCategory == System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                continue;
            }

            var convertedCharacter = character switch
            {
                'đ' => 'd',
                _ => character
            };

            if (char.IsLetterOrDigit(convertedCharacter))
            {
                builder.Append(convertedCharacter);
            }
            else if (builder.Length == 0 || builder[^1] != '-')
            {
                builder.Append('-');
            }
        }

        return builder.ToString().Trim('-');
    }
}


