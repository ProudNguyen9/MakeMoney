            .form-select {
                font-size: 0.8rem !important;
            }
        }
    </style>
}

<div class="pricing-page">
    <main>
        <section class="hero-section text-center">
            <div class="container">
                <div class="hero-inner">
                    <span class="hero-kicker">
                        <span class="material-symbols-outlined">monitoring</span>
                        BẢNG GIÁ CẬP NHẬT MỚI
                    </span>
                    <div class="section-header mb-0 pricing-hero-heading">
                        <h2 class="materials-title">Bảng Giá Phế Liệu Hôm Nay</h2>
                    </div>
                    <p class="hero-summary mb-0">
                        Theo dõi biến động giá mới nhất, đối chiếu đơn vị thu mua dễ dàng và chủ động hơn trước khi liên
                        hệ chốt giá.
                    </p>
                </div>
            </div>
        </section>

        <div class="container-fluid px-3 px-lg-4 pb-5">
            <div class="card pricing-card mx-lg-3">
                <div class="filter-bar">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-6 col-lg-7">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0">
                                    <span class="material-symbols-outlined text-muted">search</span>
                                </span>
                                <input id="pricingSearchInput" class="form-control border-0 bg-light"
                                       placeholder="Tìm kiếm tên phế liệu..." type="text" />
                            </div>
                        </div>
                        <div class="col-md-4 col-lg-3">
                            <select id="pricingCategoryFilter" class="form-select border-0 bg-light"
                                    style="font-size: 0.8rem;">
                                <option value="">Tất cả danh mục</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-lg-2">
                            <a class="btn btn-secondary-yellow w-100 d-flex align-items-center justify-content-center px-3 py-2 text-nowrap"
                                   href="@pricingQuoteButtonLink"
                                   aria-label="@pricingQuoteButtonText">
                                <span class="material-symbols-outlined fs-5">request_quote</span>
                                @pricingQuoteButtonText
                            </a>
                        </div>
                    </div>
                </div>

                <div class="table-container">
                    <div class="pricing-list">
                        @if (Model?.Prices != null && Model.Prices.Any())
                        {
                            string? currentCategoryName = null;
                            var categoryOrderNumber = 0;

                            foreach (var item in Model.Prices)
                            {
                                if (!string.Equals(currentCategoryName, item.CategoryName, StringComparison.OrdinalIgnoreCase))
                                {
                                    currentCategoryName = item.CategoryName;
                                    categoryOrderNumber = 0;

                                    <div class="category-group-row" data-category-group="@item.CategoryName">
                                        <div class="category-group-label">
                                            <div class="category-group-header">
                                                <span class="category-group-title">
                                                    <span class="category-group-name">@item.CategoryName</span>
                                                </span>
                                                <span class="category-column-label category-column-label--price">Giá</span>
                                                <span class="category-column-meta">
                                                    <span class="category-column-label category-column-label--unit">Đơn vị</span>
                                                    <span class="category-column-label category-column-label--status">Tình trạng</span>
                                                    <span class="category-column-label category-column-label--date">Cập nhật</span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                }

                                categoryOrderNumber++;

                                <div class="pricing-row"
                                     data-product-name="@item.ProductName"
                                     data-category-name="@item.CategoryName">
                                    <div class="price-card">
                                        <div class="price-main">
                                            <span class="price-order">@categoryOrderNumber.ToString("D2")</span>
                                            <span class="price-name">@item.ProductName</span>
                                        </div>
                                        <span class="price-value">@item.PriceText</span>
                                        <div class="price-meta">
                                            <span class="price-unit">@item.UnitText</span>
                                            <span class="price-status badge-status @item.StatusCssClass">@item.StatusText</span>
                                            <span class="price-date date">@item.UpdatedText</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-row text-center text-muted py-4">Chưa có dữ liệu bảng giá.</div>
                        }
                    </div>
                </div>

                <div class="card-footer bg-white border-0 text-center pb-4">
                    <p class="text-muted small mb-0 d-flex align-items-center justify-content-center gap-1">
                        <span class="material-symbols-outlined fs-6">info</span>
                        Giá thực tế có thể thay đổi tùy theo số lượng và vị trí thu mua.
                    </p>
                </div>
            </div>
        </div>

        @await Component.InvokeAsync("FeaturedProductsSection", new { viewName = "Pricing" })
 
        <script>
                    (() => {
                        const searchInput = document.getElementById('pricingSearchInput');
                        const categoryFilter = document.getElementById('pricingCategoryFilter');
                        const rows = Array.from(document.querySelectorAll('.pricing-page .pricing-row'));
                        const categoryGroupRows = Array.from(document.querySelectorAll('.pricing-page .category-group-row'));

                        if (!searchInput || !categoryFilter || rows.length === 0) {
                            return;
                        }

                        const normalizeText = (value) => (value || '')
                            .toString()
                            .trim()
                            .toLowerCase()
                            .normalize('NFD')
                            .replace(/[\u0300-\u036f]/g, '');

                        const categories = [...new Set(rows
                            .map((row) => row.dataset.categoryName || '')
                            .filter((value) => value.trim().length > 0))].sort((a, b) => a.localeCompare(b, 'vi'));

                        categories.forEach((category) => {
                            const option = document.createElement('option');
                            option.value = category;
                            option.textContent = category;
                            categoryFilter.appendChild(option);
                        });

                        const emptyRow = document.createElement('div');
                        emptyRow.id = 'pricingEmptyState';
                        emptyRow.hidden = true;
                        emptyRow.className = 'empty-row text-center text-muted py-4';
                        emptyRow.textContent = 'Không tìm thấy dữ liệu phù hợp.';

                        const list = rows[0].closest('.pricing-list');
                        if (list) {
                            list.appendChild(emptyRow);
                        }

                        const applyFilters = () => {
                            const keyword = normalizeText(searchInput.value);
                            const selectedCategory = normalizeText(categoryFilter.value);
                            let visibleCount = 0;
                            const visibleCategories = new Set();

                            rows.forEach((row) => {
                                const productName = normalizeText(row.dataset.productName);
                                const categoryName = normalizeText(row.dataset.categoryName);
                                const matchesKeyword = !keyword || productName.includes(keyword);
                                const matchesCategory = !selectedCategory || categoryName === selectedCategory;
                                const isVisible = matchesKeyword && matchesCategory;

                                row.hidden = !isVisible;
                                if (isVisible) {
                                    visibleCount += 1;
                                    visibleCategories.add(categoryName);
                                }
                            });

                            categoryGroupRows.forEach((row) => {
                                const categoryName = normalizeText(row.dataset.categoryGroup);
                                row.hidden = !visibleCategories.has(categoryName);
                            });

                            if (emptyRow) {
                                emptyRow.hidden = visibleCount !== 0;
                            }
                        };

                        searchInput.addEventListener('input', applyFilters);
                        categoryFilter.addEventListener('change', applyFilters);
                        applyFilters();
                    })();
        </script>
            
