@inject WebThuMuaPheLieu.helpper.IContactInfoHelper ContactInfoHelper
@model WebThuMuaPheLieu.ViewModels.RecentNewsSectionComponentViewModel
@using System.Net
@using System.Text.RegularExpressions
@{
    var recentBlogPosts = Model?.Posts?.ToList() ?? new List<WebThuMuaPheLieu.Models.BlogCardViewModel>();
    var contactInfo = await ContactInfoHelper.GetContactInfoAsync();
}

<style>
    #recent-news .news-card-media {
        position: relative;
        overflow: hidden;
    }

    #recent-news .materials-phone-overlay {
        position: absolute;
        right: 10px;
        bottom: 12px;
        z-index: 2;
        color: #ffd54a;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
        pointer-events: none;
    }
</style>

@functions {
    string NormalizeBlogImagePath(string? coverImage)
    {
        if (string.IsNullOrWhiteSpace(coverImage))
        {
            return "/assets/img/blog/blog-1.jpg";
        }

        var normalized = coverImage.Replace("\\", "/").Trim();

        if (normalized.StartsWith("~/"))
        {
            return $"/{normalized[2..]}";
        }

        if (normalized.StartsWith("http://") || normalized.StartsWith("https://") || normalized.StartsWith("/"))
        {
            return normalized;
        }

        return $"/{normalized.TrimStart('/')}";
    }

    string BuildBlogSummary(WebThuMuaPheLieu.Models.BlogCardViewModel post)
    {
        var summary = post.Summary;

        if (string.IsNullOrWhiteSpace(summary))
        {
            return "Nội dung bài viết đang được cập nhật.";
        }

        summary = WebUtility.HtmlDecode(summary);
        summary = Regex.Replace(summary, "<.*?>", string.Empty);
        summary = Regex.Replace(summary, @"\s+", " ").Trim();

        if (string.IsNullOrWhiteSpace(summary))
        {
            return "Nội dung bài viết đang được cập nhật.";
        }

        return summary.Length > 160 ? $"{summary[..157]}..." : summary;
    }
}

<section id="recent-news" class="services py-5 home-card-section">
    <div class="container-fluid home-section-shell" data-aos="fade-up">
        <div class="section-header">
            <h2>Tin tức gần đây</h2>
            <p>Nội dung tin tức được xây dựng rõ ràng để khách hàng dễ theo dõi và nắm bắt nhanh hơn trong quá trình tìm
                hiểu thị trường: chúng tôi thường xuyên cập nhật giá phế liệu, kinh nghiệm phân loại, mẹo chuẩn bị trước
                khi thanh lý và các lưu ý thực tế, giúp khách cá nhân, cửa hàng, kho xưởng và doanh nghiệp chủ động hơn
                trước khi bán hàng.</p>
            </div>

            @if (recentBlogPosts.Any())
            {
                <div class="home-cards-grid">
                    @for (var index = 0; index < recentBlogPosts.Count; index++)
                    {
                        var post = recentBlogPosts[index];
                        var publishDate = post.PublishedAt;
                        var animationDelay = 100 + (index % 4) * 100;

                        <div data-aos="fade-up" data-aos-delay="@animationDelay">
                            <article class="news-card-v2">
                                <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@(!string.IsNullOrWhiteSpace(post.Slug) ? post.Slug : post.Id.ToString())" class="news-card-media">
                                 <img src="@NormalizeBlogImagePath(post.CoverImage)" alt="@(post.Title ?? "Tin tức phế liệu")"
                                      class="img-fluid w-100 materials-hover-image js-blog-card-image"
                                      data-image-sequence="@string.Join("|", post.ImageSequence ?? new List<string>())"
                                      data-default-image="@NormalizeBlogImagePath(post.CoverImage)"
                                      loading="lazy">
                                    <span class="materials-phone-overlay">@contactInfo.Phone</span>
                                     <span class="news-badge"><i class="bi bi-newspaper"></i> Tin tức</span>
                                 </a>
                                <div class="news-card-body">
                                    <div class="news-card-meta">
                                        <span><i class="bi bi-calendar3"></i> @(publishDate?.ToString("dd/MM/yyyy") ?? "Đang cập nhật")</span>
                                        <span><i class="bi bi-journal-text"></i> Bài viết mới</span>
                                    </div>
                                    <h3 class="news-card-title">@(post.Title ?? "Tin tức đang cập nhật")</h3>
                                    <p>@BuildBlogSummary(post)</p>
                                    <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@(!string.IsNullOrWhiteSpace(post.Slug) ? post.Slug : post.Id.ToString())" class="readmore">Xem bài viết <i class="bi bi-arrow-right"></i></a>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="col-12 text-center py-4">
                    <p class="text-muted mb-0">Đang cập nhật tin tức mới nhất...</p>
                </div>
            }
        </div>
    </section>

<script>
    (() => {
        document.querySelectorAll('#recent-news .js-blog-card-image').forEach((imageElement) => {
            const sequence = (imageElement.dataset.imageSequence || '')
                .split('|')
                .map((item) => item.trim())
                .filter((item) => item.length > 0);

            if (sequence.length <= 1 || imageElement.dataset.rotationInitialized === 'true') {
                return;
            }

            const defaultImage = imageElement.dataset.defaultImage || sequence[0];
            let currentIndex = 0;
            let intervalId = null;

            const startHoverRotation = () => {
                if (intervalId !== null) {
                    return;
                }

                intervalId = window.setInterval(() => {
                    currentIndex = (currentIndex + 1) % sequence.length;
                    imageElement.src = sequence[currentIndex];
                }, 850);
            };

            const stopHoverRotation = () => {
                if (intervalId !== null) {
                    window.clearInterval(intervalId);
                    intervalId = null;
                }

                currentIndex = 0;
                imageElement.src = defaultImage;
            };

            imageElement.dataset.rotationInitialized = 'true';
            const mediaElement = imageElement.closest('.news-card-media');
            mediaElement?.addEventListener('mouseenter', startHoverRotation);
            mediaElement?.addEventListener('mouseleave', stopHoverRotation);
        });
    })();
</script>
