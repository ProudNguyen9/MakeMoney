@using Microsoft.EntityFrameworkCore
@using WebThuMuaPheLieu.helpper
@inject IContactInfoHelper ContactInfoHelper
@inject WebThuMuaPheLieu.Models.AppDbContext DbContext
@{
    var contact = await ContactInfoHelper.GetContactInfoAsync();
    var footerPhone = !string.IsNullOrWhiteSpace(contact.Phone) ? contact.Phone : "0909 686 889";
    var footerPhoneDigits = new string(footerPhone.Where(char.IsDigit).ToArray());
    var footerPhoneHref = string.IsNullOrWhiteSpace(footerPhoneDigits) ? "tel:0909686889" : $"tel:{footerPhoneDigits}";
    var footerEmail = !string.IsNullOrWhiteSpace(contact.Gmail) ? contact.Gmail : "info@phelieuthanhphat.vn";
    var footerAddress = !string.IsNullOrWhiteSpace(contact.Address) ? contact.Address : "88 Quốc lộ 1A, P. An Phú Đông, Quận 12, TP. Hồ Chí Minh";
    var facebookLink = string.IsNullOrWhiteSpace(contact.Facebook) ? "#" : (contact.Facebook.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || contact.Facebook.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ? contact.Facebook : $"https://{contact.Facebook.TrimStart('/')}");
    var zaloLink = string.IsNullOrWhiteSpace(contact.Zalo) ? "#" : (contact.Zalo.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || contact.Zalo.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ? contact.Zalo : $"https://zalo.me/{contact.Zalo.TrimStart('/')}");
    var featuredProducts = await DbContext.Products
        .AsNoTracking()
        .Where(p => p.Status == "active")
        .OrderByDescending(p => p.IsFeatured)
        .ThenByDescending(p => p.CreatedAt)
        .Take(5)
        .Select(p => new
        {
            p.Name,
            p.Slug,
            p.Id
        })
        .ToListAsync();

    var topServicePosts = await DbContext.BlogPostCategories
        .AsNoTracking()
        .Where(mapping => mapping.Post != null
            && mapping.Category != null
            && mapping.Post.Status == "published"
            && ((mapping.Category.Name ?? string.Empty) == "Dịch vụ"
                || (mapping.Category.Slug ?? string.Empty) == "dich-vu"
                || (mapping.Category.Slug ?? string.Empty) == "service"))
        .Select(mapping => mapping.Post!)
        .Distinct()
        .OrderByDescending(post => post.LikeCount ?? 0)
        .ThenByDescending(post => post.PublishedAt ?? post.CreatedAt)
        .Take(5)
        .Select(post => new
        {
            post.Title,
            post.Slug,
            post.Id
        })
        .ToListAsync();

    string BuildProductUrl(string? slug, int id)
    {
        return Url.Action("Detail", "Home", new { slug, id }) ?? "/";
    }

    string BuildBlogUrl(string? slug, int id)
    {
        var normalizedSlug = !string.IsNullOrWhiteSpace(slug) ? slug.Trim() : id.ToString();
        return Url.Action("Detail", "Blog", new { slug = normalizedSlug }) ?? "/Blog";
    }
}

<footer id="footer" class="footer">
    <div class="footer-content position-relative">
        <div class="container">
            <div class="row">

                <div class="col-lg-4 col-md-6">
                    <div class="footer-info">
                        <h3>Phế Liệu Thành Trung</h3>
                        <p>
                            @footerAddress<br><br>
                            <strong>Hotline:</strong> @footerPhone<br>
                            <strong>Email:</strong> @footerEmail<br>
                        </p>
                        <div class="social-links d-flex mt-3">
                            <a href="@facebookLink" class="d-flex align-items-center justify-content-center" target="_blank" rel="noopener noreferrer"><i
                                class="bi bi-facebook"></i></a>
                                <a href="@zaloLink" class="d-flex align-items-center justify-content-center" target="_blank" rel="noopener noreferrer"><i
                                     class="bi bi-instagram"></i></a>
                                    <a href="@zaloLink" class="d-flex align-items-center justify-content-center" target="_blank" rel="noopener noreferrer"><i
                                         class="bi bi-youtube"></i></a>
                                        <a href="@footerPhoneHref" class="d-flex align-items-center justify-content-center"><i
                                             class="bi bi-telephone"></i></a>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-3 footer-links">
                                    <h4>Liên kết nhanh</h4>
                                    <ul>
                                        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                                        <li><a asp-controller="Home" asp-action="About">Giới thiệu</a></li>
                                        <li><a href="~/services.html">Dịch vụ</a></li>
                                        <li><a href="~/projects.html">Mặt hàng</a></li>
                                        <li><a asp-controller="Contact" asp-action="Index">Liên hệ</a></li>
                                    </ul>
                                </div>

                                 <div class="col-lg-2 col-md-3 footer-links">
                                     <h4>Mặt hàng</h4>
                                     <ul>
                                         @foreach (var product in featuredProducts)
                                         {
                                             <li><a href="@BuildProductUrl(product.Slug, product.Id)">@product.Name</a></li>
                                         }
                                     </ul>
                                 </div>

                                 <div class="col-lg-2 col-md-3 footer-links">
                                     <h4>Dịch vụ</h4>
                                     <ul>
                                         @foreach (var post in topServicePosts)
                                         {
                                             <li><a href="@BuildBlogUrl(post.Slug, post.Id)">@post.Title</a></li>
                                         }
                                     </ul>
                                 </div>

                                <div class="col-lg-2 col-md-3 footer-links">
                                    <h4>Khu vực phục vụ</h4>
                                    <ul>
                                        <li><a asp-controller="Contact" asp-action="Index">TP. Hồ Chí Minh</a></li>
                                        <li><a asp-controller="Contact" asp-action="Index">Bình Dương</a></li>
                                        <li><a asp-controller="Contact" asp-action="Index">Đồng Nai</a></li>
                                        <li><a asp-controller="Contact" asp-action="Index">Long An</a></li>
                                        <li><a asp-controller="Contact" asp-action="Index">Tây Ninh</a></li>
                                    </ul>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="footer-legal text-center position-relative">
                        <div class="container">
                            <div class="copyright">
                                &copy; Copyright <strong><span>Phế Liệu Thành Trung</span></strong>. All Rights Reserved
                            </div>
                            <div class="credits">
                                Giao diện trang chủ đã được chuyển đổi sang mô hình website thu mua phế liệu.
                            </div>
                        </div>
                    </div>
                </footer>

                <div class="social-button is-open">
                    <div class="social-button-content">
                        <a href="@footerPhoneHref" class="call-icon" rel="nofollow" aria-label="Hotline @footerPhone">
                            <i class="fas fa-phone-alt" aria-hidden="true"></i>
                            <div class="animated alo-circle"></div>
                            <div class="animated alo-circle-fill"></div>
                            <span>Hotline: @footerPhone</span>
                        </a>
                        <a href="@facebookLink" class="mes" aria-label="Nhắn tin Facebook" target="_blank" rel="noopener noreferrer">
                            <i class="fab fa-facebook-messenger" aria-hidden="true"></i>
                            <div class="animated alo-circle"></div>
                            <div class="animated alo-circle-fill"></div>
                            <span>Nhắn tin Facebook</span>
                        </a>
                        <a href="@zaloLink" class="zalo" aria-label="Zalo @footerPhone" target="_blank" rel="noopener noreferrer">
                            <span class="social-button-zalo-text">Zalo</span>
                            <div class="animated alo-circle"></div>
                            <div class="animated alo-circle-fill"></div>
                            <span>Zalo: @footerPhone</span>
                        </a>
                    </div>
                </div>


<div id="preloader"></div>
