                overflow: hidden;
                transform: translateZ(0);
                backface-visibility: hidden;
            }

            #materials .materials-grid-swiper .materials-card-media {
                aspect-ratio: 16 / 10;
                height: auto;
                min-height: 220px;
                position: relative;
                overflow: hidden;
                transform: translateZ(0);
