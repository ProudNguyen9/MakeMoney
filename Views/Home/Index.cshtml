 @using System.IO
@inject WebThuMuaPheLieu.Services.IStructuredDataService StructuredDataService
@model WebThuMuaPheLieu.ViewModels.HomeIndexViewModel
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Trang chủ";
    ViewData["Description"] = "Phế Liệu Thành Trung chuyên thu mua phế liệu giá cao tận nơi, hỗ trợ khảo sát nhanh, báo giá minh bạch và thanh toán linh hoạt tại TP.HCM, Bình Dương, Đồng Nai.";
    ViewData["Canonical"] = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";
    ViewData["OgType"] = "website";
    var structuredDataJson = StructuredDataService.SerializeSchemas(StructuredDataService.BuildHomeSchemas(Context));

    var heroBanner = Model?.Banner;
    var contactInfo = Model?.ContactInfo ?? new WebThuMuaPheLieu.helpper.ContactInfoSettings();
    var heroLine1 = !string.IsNullOrWhiteSpace(heroBanner?.TitleLine1) ? heroBanner.TitleLine1 : "Chuyên thu mua";
    var heroLine2 = !string.IsNullOrWhiteSpace(heroBanner?.TitleLine2) ? heroBanner.TitleLine2 : "phế liệu giá cao";
    var heroLine3 = !string.IsNullOrWhiteSpace(heroBanner?.TitleLine3) ? heroBanner.TitleLine3 : "uy tín hàng đầu";
    var heroLine4 = !string.IsNullOrWhiteSpace(heroBanner?.TitleLine4) ? heroBanner.TitleLine4 : "cho doanh nghiệp";
    var referralPhoneNumber = !string.IsNullOrWhiteSpace(contactInfo.Phone) ? contactInfo.Phone : "0888.03.7777";
    var referralPhoneHref = $"tel:{new string(referralPhoneNumber.Where(char.IsDigit).ToArray())}";
    var referralZaloValue = string.IsNullOrWhiteSpace(contactInfo.Zalo) ? "0888037777" : contactInfo.Zalo.Trim();
    var referralZaloLink = referralZaloValue.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
        || referralZaloValue.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
        ? referralZaloValue
        : $"https://zalo.me/{referralZaloValue.TrimStart('/')}";
    var referralContactLink = Url.Action("Index", "Contact") ?? "/Contact";
    var heroButtonPrimaryText = !string.IsNullOrWhiteSpace(heroBanner?.ButtonPrimaryText) ? heroBanner.ButtonPrimaryText : "Nhận báo giá ngay";
    var heroButtonPrimaryLink = referralPhoneHref;
    var heroButtonSecondaryText = !string.IsNullOrWhiteSpace(heroBanner?.ButtonSecondaryText) ? heroBanner.ButtonSecondaryText : "Xem mặt hàng thu mua";
    var heroButtonSecondaryLink = Url.Action("Index", "Product") ?? "/Product";
    var heroImages = (heroBanner?.Images ?? Array.Empty<WebThuMuaPheLieu.helpper.BannerInjectImageSettings>())
        .Where(image => !string.IsNullOrWhiteSpace(image.ImageUrl))
        .OrderBy(image => image.OrderIndex)
        .ThenBy(image => image.Id)
        .ToList();
    var defaultHeroImages = new[]
    {
        new { Url = Url.Content("~/assets/img/satthep.png"), Alt = "Thu mua sắt thép phế liệu tại kho bãi" },
        new { Url = Url.Content("~/assets/img/dongnhom.jpg"), Alt = "Thu mua đồng nhôm và kim loại màu" },
        new { Url = Url.Content("~/assets/img/maymoc.jpg"), Alt = "Thu mua máy móc công nghiệp và phế liệu cơ khí" }
    };

    var heroLcpImageUrl = heroImages.Any()
        ? ResolveBannerImageUrl(heroImages[0].ImageUrl)
        : defaultHeroImages[0].Url;

    var heroLcpAlt = heroImages.Any()
        ? (string.IsNullOrWhiteSpace(heroImages[0].Caption) ? heroLine1 : heroImages[0].Caption)
        : defaultHeroImages[0].Alt;

    var (heroLcpWidth, heroLcpHeight) = GetImageDimensions(heroLcpImageUrl, 1280, 720);

    string ResolveBannerImageUrl(string? imageUrl)
    {
        var normalizedUrl = NormalizeAssetPath(imageUrl);

        if (string.IsNullOrWhiteSpace(normalizedUrl))
        {
            return Url.Content(normalizedUrl);
        }

        var relativePath = normalizedUrl.Replace("~/", string.Empty).TrimStart('/').Replace('/', System.IO.Path.DirectorySeparatorChar);
        var physicalPath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", relativePath);

        if (!System.IO.File.Exists(physicalPath))
        {
            var fileNameWithoutExtension = System.IO.Path.GetFileNameWithoutExtension(relativePath);
            var directoryPath = System.IO.Path.GetDirectoryName(physicalPath);

            if (!string.IsNullOrWhiteSpace(fileNameWithoutExtension) && !string.IsNullOrWhiteSpace(directoryPath) && Directory.Exists(directoryPath))
            {
                var matchedFile = Directory.GetFiles(directoryPath, $"{fileNameWithoutExtension}.*")
                    .OrderBy(path => path)
                    .FirstOrDefault();

                if (!string.IsNullOrWhiteSpace(matchedFile))
                {
                    var relativeDirectory = normalizedUrl.Replace("~/", string.Empty).TrimStart('/');
                    relativeDirectory = relativeDirectory[..relativeDirectory.LastIndexOf('/')];
                    var fileName = System.IO.Path.GetFileName(matchedFile);
                    normalizedUrl = $"~/{relativeDirectory}/{fileName}";
                    relativePath = normalizedUrl.Replace("~/", string.Empty).TrimStart('/').Replace('/', System.IO.Path.DirectorySeparatorChar);
                    physicalPath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", relativePath);
                }
            }
        }

        var contentUrl = Url.Content(normalizedUrl);

        if (!System.IO.File.Exists(physicalPath))
        {
            return contentUrl;
        }

        var version = System.IO.File.GetLastWriteTimeUtc(physicalPath).Ticks;
        var separator = contentUrl.Contains('?') ? '&' : '?';
        return $"{contentUrl}{separator}v={version}";
    }
}

@section Head {
    <partial name="_StructuredData" model="structuredDataJson" />
    <link rel="preload"
          as="image"
          href="@heroLcpImageUrl"
          fetchpriority="high" />
}

<section id="hero" class="hero scrap-hero d-flex align-items-center">
    <div class="container-fluid home-wide-shell position-relative">
        <div class="row align-items-center gy-5">
            <div class="col-lg-5 hero-content">
                <h1 class="visually-hidden">Thu mua phế liệu giá cao tận nơi - Phế Liệu Thành Trung</h1>
                <h2 class="hero-title"><span class="hero-title-line">@heroLine1</span><span>@heroLine2</span><span class="hero-title-line">@heroLine3</span><span class="hero-title-tail">@heroLine4</span></h2>
                <div class="hero-actions">
                    <a href="@heroButtonPrimaryLink" class="hero-btn-primary"><i class="bi bi-telephone-fill"></i> @heroButtonPrimaryText</a>
                    <a href="@heroButtonSecondaryLink" class="hero-btn-secondary"><i class="bi bi-arrow-down-circle"></i> @heroButtonSecondaryText</a>
                </div>
            </div> 
            <div class="col-lg-7 mt-mobile-2">
                <div class="hero-visual-wrap">
                    <div class="hero-illustration">
                        <div class="hero-illustration-mask">
                            <div class="slides-1 swiper hero-banner-slider">
                                <div class="swiper-wrapper">
                                                @if (heroImages.Any())
                                                {
                                                    @for (var heroIndex = 0; heroIndex < heroImages.Count; heroIndex++)
                                                    {
                                                        var image = heroImages[heroIndex];
                                                        var imageUrl = ResolveBannerImageUrl(image.ImageUrl);
                                                        var imageAlt = string.IsNullOrWhiteSpace(image.Caption) ? heroLine1 : image.Caption;
                                                        var (imageWidth, imageHeight) = heroIndex == 0
                                                            ? (heroLcpWidth, heroLcpHeight)
                                                            : GetImageDimensions(imageUrl, 1280, 720);

                                                        <div class="swiper-slide">
                                                            <img src="@imageUrl"
                                                                 alt="@imageAlt"
                                                                 class="img-fluid w-100"
                                                                 width="@imageWidth"
                                                                 height="@imageHeight"
                                                                 loading="@(heroIndex == 0 ? "eager" : "lazy")"
                                                                 decoding="async"
                                                                 fetchpriority="@(heroIndex == 0 ? "high" : "auto")"
                                                                 sizes="(max-width: 991.98px) 100vw, 58vw">
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    @for (var heroIndex = 0; heroIndex < defaultHeroImages.Length; heroIndex++)
                                                    {
                                                        var image = defaultHeroImages[heroIndex];
                                                        var (imageWidth, imageHeight) = heroIndex == 0
                                                            ? (heroLcpWidth, heroLcpHeight)
                                                            : GetImageDimensions(image.Url, 1280, 720);

                                                        <div class="swiper-slide">
                                                            <img src="@image.Url"
                                                                 alt="@image.Alt"
                                                                 class="img-fluid w-100"
                                                                 width="@imageWidth"
                                                                 height="@imageHeight"
                                                                 loading="@(heroIndex == 0 ? "eager" : "lazy")"
                                                                 decoding="async"
                                                                 fetchpriority="@(heroIndex == 0 ? "high" : "auto")"
                                                                 sizes="(max-width: 991.98px) 100vw, 58vw">
                                                        </div>
                                                    }
                                                }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <main id="main">
                            <section id="materials" class="services home-card-section">
    <div class="container-fluid home-section-shell" data-aos="fade-up">
        <style>
            #materials .materials-header-row {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 18px;
                margin-bottom: 20px;
            }

            #materials .materials-header-row .section-header {
                flex: 1 1 0;
            }

            #materials .materials-category-shortcut {
                flex: 0 0 260px;
                max-width: 260px;
                align-self: center;
            }

            #materials .materials-category-shortcut-label {
                display: block;
                margin-bottom: 8px;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: rgba(15, 23, 42, 0.65);
            }

            #materials .materials-category-shortcut select {
                width: 100%;
                min-height: 44px;
                border-radius: 999px;
                border: 1px solid rgba(25, 135, 84, 0.18);
                background: linear-gradient(135deg, #ffffff 0%, #f7fbf8 100%);
                box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
                padding: 10px 42px 10px 16px;
                font-size: 14px;
                font-weight: 600;
                color: #1f2937;
                appearance: none;
                -webkit-appearance: none;
                -moz-appearance: none;
                background-image:
                    linear-gradient(135deg, transparent 50%, #198754 50%),
                    linear-gradient(45deg, #198754 50%, transparent 50%);
                background-position:
                    calc(100% - 18px) calc(50% - 3px),
                    calc(100% - 12px) calc(50% - 3px);
                background-size: 6px 6px, 6px 6px;
                background-repeat: no-repeat;
                cursor: pointer;
                transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
            }

            #materials .materials-category-shortcut select:focus {
                outline: none;
                border-color: rgba(25, 135, 84, 0.42);
                box-shadow: 0 0 0 4px rgba(25, 135, 84, 0.12), 0 10px 24px rgba(15, 23, 42, 0.08);
            }

            #materials .materials-category-shortcut select:hover {
                transform: translateY(-1px);
            }

            #materials .materials-grid-swiper {
                overflow: hidden;
                padding: 4px 2px 36px;
                cursor: grab;
                user-select: none;
                -webkit-user-select: none;
                touch-action: pan-y;
                -webkit-tap-highlight-color: transparent;
            }

            #materials .materials-grid-swiper.swiper-grabbing {
                cursor: grabbing;
            }

            #materials .materials-grid-swiper .swiper-wrapper {
                align-items: stretch;
                will-change: transform;
                transition-property: transform;
                transition-timing-function: cubic-bezier(0.25, 0.8, 0.25, 1) !important;
            }

            #materials .materials-grid-swiper .swiper-slide {
                height: auto;
                display: flex;
                transform: translateZ(0);
                backface-visibility: hidden;
            }

            #materials .materials-grid-swiper .materials-card-v2 {
                width: 100%;
                height: 100%;
                display: flex !important;
                flex-direction: column;
