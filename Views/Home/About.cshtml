@using WebThuMuaPheLieu.helpper
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Giới thiệu";
    ViewData["BodyClass"] = "about-page";
    var contactInfo = ViewData["ContactInfo"] as ContactInfoSettings ?? new ContactInfoSettings();
    var aboutPhone = !string.IsNullOrWhiteSpace(contactInfo.Phone) ? contactInfo.Phone : "0909 123 456";
    var aboutPhoneHref = $"tel:{new string(aboutPhone.Where(char.IsDigit).ToArray())}";
}

<section id="about-hero" class="about-hero scrap-hero d-flex align-items-center">
    <div class="container-fluid home-wide-shell position-relative">
        <div class="row align-items-start gy-5 about-hero-layout-row">
            <div class="col-lg-7 hero-content" data-aos="fade-right" data-aos-delay="100">
           
                <div class="about-hero-gallery" data-about-gallery>
                    <div class="about-hero-gallery__main">
                        <img src="~/assets/img/satthep.png"
                             alt="Thu mua sắt thép phế liệu"
                             class="about-hero-gallery__image"
                             data-gallery-image />
                        <div class="about-hero-gallery__overlay">
                            <span>Hình ảnh thu mua thực tế</span>
                        </div>
                    </div>

                    <div class="about-hero-gallery__thumbs">
                        <button type="button"
                                class="about-hero-thumb is-active"
                                data-image-src="@Url.Content("~/assets/img/satthep.png")"
                                data-image-alt="Thu mua sắt thép phế liệu">
                            <img src="~/assets/img/satthep.png" alt="Sắt thép" />
                        
                        </button>
                        <button type="button"
                                class="about-hero-thumb"
                                data-image-src="@Url.Content("~/assets/img/dongnhom.jpg")"
                                data-image-alt="Thu mua đồng nhôm inox">
                            <img src="~/assets/img/dongnhom.jpg" alt="Đồng nhôm inox" />
                          
                        </button>
                        <button type="button"
                                class="about-hero-thumb"
                                data-image-src="@Url.Content("~/assets/img/maymoc.jpg")"
                                data-image-alt="Thu mua máy móc cũ và kho xưởng">
                            <img src="~/assets/img/maymoc.jpg" alt="Máy móc cũ" />
                          
                        </button>
                    </div>
                </div>
                <div class="hero-actions about-hero-actions--mobile d-lg-none">
                    <a asp-controller="Contact" asp-action="Index" class="hero-btn-primary">
                        <i class="bi bi-send-fill"></i> Liên hệ ngay
                    </a>
                    <a href="@aboutPhoneHref" class="hero-btn-secondary">
                        <i class="bi bi-telephone-fill"></i> @aboutPhone
                    </a>
                </div>
            </div>

            <div class="col-lg-5" data-aos="fade-left" data-aos-delay="180">
                <div class="about-hero-panel-wrap">
                    <div class="about-hero-panel">
                        <div class="about-hero-panel__card">
                            <span class="about-panel-kicker"><i class="bi bi-patch-check-fill"></i> Điểm nổi bật</span>
                            <h3>Phế liệu Thành Trung. Thu mua đáng tin, khách gọi lần đầu đã thấy yên tâm.</h3>
                            <div class="about-panel-list">
                                <div class="about-panel-item">
                                    <i class="bi bi-check2-circle"></i>
                                    <span>Báo giá rõ và tư vấn theo đúng thực tế lô hàng.</span>
                                </div>
                                <div class="about-panel-item">
                                    <i class="bi bi-check2-circle"></i>
                                    <span>Hỗ trợ thu mua từ dân dụng đến công nghiệp.</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="about-hero-panel__floating" 
                                 style="    width: 95%;
                                            position: absolute;
                                            left: 20px;
                                            right: 0;
                                            bottom: -70px;">
                            <span><i class="bi bi-lightning-charge-fill"></i> Ưu tiên hỗ trợ nhanh tại TP.HCM, Bình Dương, Đồng Nai</span>
                        </div>
                    </div>

                    <div class="hero-actions about-hero-actions--panel d-none d-lg-flex">
                        <a asp-controller="Contact" asp-action="Index" class="hero-btn-primary">
                            <i class="bi bi-send-fill"></i> Liên hệ ngay
                        </a>
                        <a href="@aboutPhoneHref" class="hero-btn-secondary">
                            <i class="bi bi-telephone-fill"></i> @aboutPhone
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<main id="main" class="about-page-main">
    <section id="about-company" class="about-company-section home-card-section">
        <div class="container-fluid home-section-shell" data-aos="fade-up">
            <div class="row gy-4 align-items-stretch">
                <div class="col-lg-7" data-aos="fade-right" data-aos-delay="80">
                    <div class="about-story-card h-100">
                        <div class="about-story-card__eyebrow">Về chúng tôi</div>
                        <h3>Chúng tôi theo đuổi cách thu mua hiện đại, trình bày dễ nhìn và tạo cảm giác chuyên nghiệp hơn cho khách hàng.</h3>
                        <p>
                            Phế Liệu Hoàng Doanh tiếp nhận nhu cầu từ hộ gia đình, cửa hàng, công trình, kho bãi và doanh nghiệp.
                            Thế mạnh là phản hồi nhanh, phân loại tốt, đưa ra hướng xử lý phù hợp với từng nhóm hàng và từng quy mô thu mua.
                        </p>
                        <div class="about-story-grid">
                            <div class="about-story-point">
                                <strong>Phạm vi</strong>
                                <span>TP.HCM và các tỉnh lân cận</span>
                            </div>
                            <div class="about-story-point">
                                <strong>Nhóm hàng</strong>
                                <span>Sắt thép, đồng nhôm, inox, giấy, nhựa, máy móc cũ</span>
                            </div>
                            <div class="about-story-point">
                                <strong>Phong cách</strong>
                                <span>Gọn gàng, rõ ràng, dễ làm việc lâu dài</span>
                            </div>
                            <div class="about-story-point">
                                <strong>Mục tiêu</strong>
                                <span>Tối ưu thời gian và giá trị thu hồi cho khách</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5" data-aos="fade-left" data-aos-delay="120">
                    <div class="about-highlight-stack h-100">
                        <div class="about-highlight-card">
                            <i class="bi bi-globe2"></i>
                            <h4>Tiếp nhận linh hoạt</h4>
                            <p>Khách có thể gửi thông tin nhanh để được tư vấn hướng thu mua phù hợp ngay từ đầu.</p>
                        </div>
                        <div class="about-highlight-card">
                            <i class="bi bi-geo-alt-fill"></i>
                            <h4>Triển khai thực tế</h4>
                            <p>Ưu tiên khu vực TP.HCM, Bình Dương, Đồng Nai và các địa bàn thuận tiện vận chuyển.</p>
                        </div>
                        <div class="about-highlight-card">
                            <i class="bi bi-clipboard2-check-fill"></i>
                            <h4>Quy trình rõ ràng</h4>
                            <p>Từ tiếp nhận thông tin, khảo sát đến thu gom đều được trao đổi ngắn gọn và dễ hiểu.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="about-services" class="about-services-section home-card-section">
        <div class="container-fluid home-section-shell" data-aos="fade-up">
            <div class="section-header">
               
                <h2>Chuyên thu mua đầy đủ tất cả loại phế liệu.</h2>
            
            </div>

            <div class="row gy-4 about-services-grid">
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="80">
                    <article class="about-service-card h-100">
                        <span class="about-service-card__icon"><i class="bi bi-building-fill-gear"></i></span>
                        <h3>Thu mua sắt thép</h3>
                        <p>Nhận sắt dân dụng, hàng công trình, vật tư cũ và lô hàng kho bãi cần xử lý nhanh.</p>
                    </article>
                </div>
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="120">
                    <article class="about-service-card h-100">
                        <span class="about-service-card__icon"><i class="bi bi-lightning-charge-fill"></i></span>
                        <h3>Thu mua kim loại màu</h3>
                        <p>Hỗ trợ đồng, nhôm, inox và nhiều nhóm kim loại cần phân loại để báo giá rõ ràng hơn.</p>
                    </article>
                </div>
                <div class="col-lg-4 col-md-12" data-aos="fade-up" data-aos-delay="160">
                    <article class="about-service-card h-100">
                        <span class="about-service-card__icon"><i class="bi bi-truck-flatbed"></i></span>
                        <h3>Thanh lý kho xưởng</h3>
                        <p>Phù hợp cho máy móc cũ, hàng cồng kềnh, nhà xưởng và các nhu cầu thanh lý tổng hợp.</p>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <section id="about-reasons" class="about-reasons-section home-card-section">
        <div class="container-fluid home-section-shell" data-aos="fade-up">
            <div class="section-header about-section-header">        
                <h2>Quy trình làm việc chuyên nghiệp</h2>         
            </div>
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="80">
                    <div class="reason-card h-100">
                        <div class="reason-card__icon"><i class="bi bi-speedometer2"></i></div>
                        <h3>Phản hồi nhanh</h3>
                        <p>Tiếp nhận sớm, đánh giá nhu cầu nhanh và gợi ý phương án phù hợp.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="120">
                    <div class="reason-card h-100">
                        <div class="reason-card__icon"><i class="bi bi-cash-coin"></i></div>
                        <h3>Làm việc minh bạch</h3>
                        <p>Thông tin báo giá, nhóm hàng và quy trình thu mua được trình bày rõ ràng.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-12" data-aos="fade-up" data-aos-delay="160">
                    <div class="reason-card h-100">
                        <div class="reason-card__icon"><i class="bi bi-people-fill"></i></div>
                        <h3>Dễ hợp tác lâu dài</h3>
                        <p>Tác phong gọn gàng, phù hợp cho khách cần đối tác ổn định và phối hợp thuận tiện.</p>
                    </div>
                </div>
            </div>

            <div class="about-cta-box" data-aos="fade-up" data-aos-delay="220">
                <div class="row gy-4 align-items-center">
                    <div class="col-lg-8">
                        <span class="about-cta-box__badge"><i class="bi bi-chat-dots-fill"></i> Tư vấn nhanh</span>
                        <h3>Cần báo giá hoặc muốn gửi thông tin lô hàng?</h3>
                        <p>
                            Chỉ cần gửi khu vực, nhóm hàng và khối lượng ước tính, đội ngũ sẽ phản hồi sớm để bạn có hướng xử lý rõ ràng hơn.
                        </p>
                    </div>
                    <div class="col-lg-4">
                        <div class="about-cta-box__actions">
                            <a asp-controller="Contact" asp-action="Index" class="hero-btn-primary">
                                <i class="bi bi-send-fill"></i> Gửi yêu cầu
                            </a>
                            <a href="tel:0909686889" class="hero-btn-secondary">
                                <i class="bi bi-telephone-fill"></i> Gọi hotline
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

@section Styles {
    <style>
        .about-page-main {
            padding-bottom: 32px;
        }

        body.about-page .about-hero-layout-row {
            --bs-gutter-x: 1.25rem;
        }

        body.about-page .hero-content {
            padding-right: 10px;
        }

        body.about-page .about-hero-gallery {
            margin: 14px 0 12px;
            max-width: 100%;
        }

        body.about-page .about-hero-gallery__main {
            position: relative;
            overflow: hidden;
            border-radius: 24px;
            background: rgba(255, 255, 255, 0.88);
            box-shadow: 0 22px 46px rgba(8, 27, 19, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.68);
            min-height: 330px;
        }

        body.about-page .about-hero-gallery__image {
            width: 100%;
            height: 470px;
            object-fit: cover;
            display: block;
            filter: saturate(0.95);
        }

        body.about-page .about-hero-gallery__overlay {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: flex-end;
            padding: 14px 18px;
            background: linear-gradient(180deg, rgba(15, 23, 42, 0.02) 0%, rgba(15, 23, 42, 0.28) 100%);
        }

        body.about-page .about-hero-gallery__overlay span {
            display: inline-flex;
            align-items: center;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.9);
            color: #163526;
            font-size: 13px;
            font-weight: 800;
        }

       body.about-page .about-hero-gallery__thumbs {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            margin-top: 14px;
        }

        body.about-page .about-hero-gallery__thumbs img {
            height: 180px;       /* tăng lên 140px / 160px tùy bạn */
            object-fit: cover;   /* giữ ảnh không bị méo */
            border-radius: 8px;
        }

        body.about-page .about-hero-thumb {
            border: 0;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.96);
            box-shadow: 0 16px 34px rgba(8, 27, 19, 0.10);
            padding: 9px;
            min-height: 98px;
            text-align: left;
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
            border: 2px solid transparent;
            cursor: pointer;
        }

        body.about-page .about-hero-thumb:hover,
        body.about-page .about-hero-thumb.is-active {
            transform: translateY(-4px);
            box-shadow: 0 22px 44px rgba(8, 27, 19, 0.18);
            border-color: rgba(245, 189, 47, 0.9);
        }

        body.about-page .about-hero-thumb img {
            width: 100%;
            height: 110px;
            object-fit: cover;
            border-radius: 16px;
            display: block;
            margin-bottom: 8px;
        }

        body.about-page .about-hero-thumb span {
            display: block;
            color: #163526;
            font-weight: 800;
            font-size: 13px;
            line-height: 1.3;
        }

        body.about-page .about-hero-panel-wrap {
            display: grid;
            gap: 12px;
            position: relative;
            z-index: 2;
            padding-top: 8px;
        }

        body.about-page .about-hero-panel {
            width: 100%;
        }

        body.about-page .about-hero-panel__card {
            width: 100%;
            max-width: 100%;
            margin-left: 0;
            border-radius: 34px;
            padding: 36px 38px 24px;
            box-shadow: 0 20px 44px rgba(8, 27, 19, 0.10);
        }

        body.about-page .about-hero-panel__card h3 {
            margin-bottom: 20px;
            font-size: clamp(2.2rem, 2.65vw, 3.2rem);
            line-height: 1.18;
            letter-spacing: -0.03em;
        }

        body.about-page .about-panel-list {
            display: grid;
            gap: 16px;
        }

        body.about-page .about-panel-item {
            min-height: 78px;
            border-radius: 22px;
            padding: 18px 18px;
        }

        body.about-page .about-panel-item span {
            font-size: 1.02rem;
            line-height: 1.5;
        }

        body.about-page .about-hero-panel__floating {
            width: 100%;
            margin-left: 15px;
            margin-top: -4px;
            min-height: 58px;
            padding: 14px 100px;
        }

        body.about-page .about-hero-actions--panel {
            margin-top: 70px;
            justify-content: flex-start;
            gap: 20px;
            flex-wrap: nowrap;
            padding-left: 90px;
        }

        body.about-page .about-hero-actions--mobile {
            margin-top: 20px;
            gap: 14px;
            flex-wrap: wrap;
        }

        body.about-page .about-hero-actions--panel .hero-btn-primary,
        body.about-page .about-hero-actions--panel .hero-btn-secondary,
        body.about-page .about-hero-actions--mobile .hero-btn-primary,
        body.about-page .about-hero-actions--mobile .hero-btn-secondary {
            min-width: 0;
            min-height: 60px;
            padding: 16px 22px;
            flex: 1 1 0;
            justify-content: center;
            align-items: center;
            font-size: 1.02rem;
        }

        body.about-page .about-story-card,
        body.about-page .about-highlight-card,
        body.about-page .about-service-card,
        body.about-page .reason-card,
        body.about-page .about-cta-box,
        body.about-page .about-hero-panel__card {
            height: 100%;
        }

        body.about-page .about-story-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
            margin-top: 28px;
        }

        body.about-page .about-story-point {
            background: #f8fafc;
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 18px;
            padding: 18px 20px;
        }

        body.about-page .about-story-point strong {
            display: block;
            color: #0f172a;
            font-size: 1rem;
            margin-bottom: 6px;
        }

        body.about-page .about-story-point span {
            color: #475569;
            line-height: 1.65;
        }

        body.about-page .about-highlight-stack {
            display: grid;
            gap: 18px;
        }

        body.about-page .about-cta-box {
            margin-top: 32px;
        }

        @@media (max-width: 991.98px) {
            body.about-page .about-hero-layout-row {
                --bs-gutter-x: 1.5rem;
            }

            body.about-page .hero-content {
                padding-right: calc(var(--bs-gutter-x) * .5);
            }

            body.about-page .about-hero-gallery {
                max-width: 100%;
            }

            body.about-page .about-hero-gallery__main {
                min-height: 220px;
            }

            body.about-page .about-hero-gallery__image {
                height: 220px;
            }

            body.about-page .about-hero-panel-wrap {
                padding-top: 0;
            }

            body.about-page .about-hero-panel__card {
                padding: 30px 24px 22px;
            }

            body.about-page .about-hero-panel__card h3 {
                font-size: clamp(1.9rem, 5vw, 2.5rem);
            }

            body.about-page .about-hero-gallery__thumbs,
            body.about-page .about-story-grid {
                grid-template-columns: 1fr;
            }

            body.about-page .about-hero-actions--panel {
                flex-direction: column;
                flex-wrap: wrap;
                padding-left: 0;
            }
        }

        @@media (max-width: 575.98px) {
            body.about-page .about-hero-gallery__main {
                min-height: 180px;
                border-radius: 18px;
            }

            body.about-page .about-hero-gallery__image {
                height: 180px;
            }

            body.about-page .about-hero-thumb {
                border-radius: 18px;
                min-height: 100px;
            }

            body.about-page .about-hero-thumb img {
                height: 72px;
            }

            body.about-page .about-story-point {
                padding: 16px;
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.body.classList.add('about-page');

        document.querySelectorAll('[data-about-gallery]').forEach(function (gallery) {
            var mainImage = gallery.querySelector('[data-gallery-image]');
            var thumbs = gallery.querySelectorAll('.about-hero-thumb');

            thumbs.forEach(function (thumb) {
                thumb.addEventListener('click', function () {
                    var imageSrc = thumb.getAttribute('data-image-src');
                    var imageAlt = thumb.getAttribute('data-image-alt');

                    if (mainImage && imageSrc) {
                        mainImage.setAttribute('src', imageSrc);
                    }

                    if (mainImage && imageAlt) {
                        mainImage.setAttribute('alt', imageAlt);
                    }

                    thumbs.forEach(function (item) {
                        item.classList.remove('is-active');
                    });

                    thumb.classList.add('is-active');
                });
            });
        });
    </script>
}
