@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<header class="topbar" id="marketing-seo-section">
    <div class="topbar__title-wrap">
        <button class="sidebar-toggle" type="button" aria-label="Mở menu">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <div>
            <p class="eyebrow">Admin / Marketing</p>
            <h2>Banner & SEO</h2>
            <div class="overview-hero__chips">
                <span>Banner</span>
                <span>SEO</span>
            </div>
        </div>
    </div>
</header>

<section class="panel" id="marketing-panel">
    <div class="panel__head">
        <div>
            <p class="eyebrow">Scaffold</p>
            <h3>Quản lý nội dung marketing</h3>
        </div>
        <div class="panel__head-actions">
            <button type="button">Thêm banner</button>
        </div>
    </div>
    <div class="table-shell">
        <table class="product-table">
            <thead>
                <tr>
                    <th>Hạng mục</th>
                    <th>Mô tả</th>
                    <th>Kênh</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <div class="product-info"><strong>Banner trang chủ</strong><span>Khung quản trị marketing đã sẵn
                            sàng.</span></div>
                        </td>
                        <td>Chờ bind dữ liệu banner và SEO.</td>
                        <td>Website</td>
                        <td>Ready</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
