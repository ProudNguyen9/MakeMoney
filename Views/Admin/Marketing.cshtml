@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var bannerCacheVersion = DateTime.UtcNow.Ticks;
    var bannerImage1Url = $"{Url.Content(Model.BannerImage1 ?? "~/assets/img/satthep.png")}?v={bannerCacheVersion}";
    var bannerImage2Url = $"{Url.Content(Model.BannerImage2 ?? "~/assets/img/dongnhom.jpg")}?v={bannerCacheVersion}";
    var bannerImage3Url = $"{Url.Content(Model.BannerImage3 ?? "~/assets/img/maymoc.jpg")}?v={bannerCacheVersion}";
    var seoOgImageUrl = $"{Url.Content(Model.OgImage ?? "~/assets/img/satthep.png")}?v={bannerCacheVersion}";
}

@model WebThuMuaPheLieu.ViewModels.AdminMarketingViewModel

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/assets/css/main.css" asp-append-version="true" />
    <style>
        .marketing-section-group--banner .marketing-panel {
            overflow: hidden;
        }

        .marketing-section-group--banner .marketing-banner-preview-shell {
            border-radius: 28px;
            overflow: hidden;
            background: linear-gradient(180deg, #f8fafc 0%, #eef6ff 100%);
            border: 1px solid rgba(148, 163, 184, 0.18);
        }

        .marketing-panel__actions {
            display: flex;
            align-items: center;
            gap: 12px;
            justify-content: flex-end;
            margin-top: 18px;
            padding-top: 18px;
            border-top: 1px solid rgba(226, 232, 240, 0.9);
            flex-wrap: wrap;
        }

        .marketing-field {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .marketing-field label {
            font-size: 0.86rem;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: 0.01em;
        }

        .marketing-field input,
        .marketing-field textarea {
            width: 100%;
            border: 1px solid rgba(148, 163, 184, 0.2);
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
            border-radius: 16px;
            padding: 14px 16px;
            font-size: 0.96rem;
            color: #0f172a;
            outline: none;
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
            transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease, background 0.18s ease;
        }

        .marketing-field textarea {
            min-height: 112px;
            resize: vertical;
            line-height: 1.6;
        }

        .marketing-field input::placeholder,
        .marketing-field textarea::placeholder {
            color: #94a3b8;
        }

        .marketing-field input:hover,
        .marketing-field textarea:hover {
            border-color: rgba(96, 165, 250, 0.4);
            box-shadow: 0 10px 22px rgba(37, 99, 235, 0.06);
        }

        .marketing-field input:focus,
        .marketing-field textarea:focus {
            border-color: rgba(37, 99, 235, 0.45);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12), 0 12px 24px rgba(37, 99, 235, 0.08);
            transform: translateY(-1px);
        }

        .marketing-action-btn {
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 12px;
            padding: 10px 16px;
            font-size: 0.88rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
        }

        .marketing-action-btn:hover {
            transform: translateY(-1px);
        }

        .marketing-action-btn--primary {
            color: #2563eb;
            border-color: rgba(37, 99, 235, 0.4);
            background: #eff6ff;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.08);
        }

        .marketing-action-btn--primary:hover {
            color: #1d4ed8;
            border-color: rgba(29, 78, 216, 0.5);
            background: #dbeafe;
            box-shadow: 0 8px 14px rgba(37, 99, 235, 0.12);
        }

        .marketing-action-btn--secondary {
            color: #334155;
            background: #fff;
            box-shadow: 0 4px 10px rgba(15, 23, 42, 0.04);
        }

        .marketing-action-btn--secondary:hover {
            color: #0f172a;
            border-color: rgba(100, 116, 139, 0.34);
            background: #f8fafc;
            box-shadow: 0 8px 14px rgba(15, 23, 42, 0.08);
        }

        .marketing-section-group--banner .marketing-banner-config {
            padding: 0 24px 24px;
        }

        .marketing-section-group--banner .marketing-banner-card-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin-top: 16px;
            align-items: stretch;
            justify-content: stretch;
        }

        .marketing-section-group--banner .marketing-banner-upload-card {
            border: 1px solid rgba(59, 130, 246, 0.16);
            border-radius: 14px;
            background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.08);
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            height: 100%;
            position: relative;
        }

        .marketing-section-group--banner .marketing-banner-upload-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 18px 36px rgba(15, 23, 42, 0.12);
            border-color: rgba(59, 130, 246, 0.28);
        }

        .marketing-section-group--banner .marketing-banner-upload-card__preview {
            aspect-ratio: 1.45 / 1;
            overflow: hidden;
            background: #dbeafe;
            position: relative;
        }

        .marketing-section-group--banner .marketing-banner-upload-card__preview::after {
            content: '';
            position: absolute;
            inset: auto 0 0 0;
            height: 42%;
            background: linear-gradient(180deg, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0.38) 100%);
        }

        .marketing-section-group--banner .marketing-banner-upload-card__preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .marketing-section-group--banner .marketing-banner-upload-card__body {
            padding: 8px 10px 10px;
            min-height: 56px;
        }

        .marketing-section-group--banner .marketing-banner-upload-card__body label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 2px;
            text-align: center;
        }

        .marketing-section-group--banner .marketing-banner-upload-card__meta {
            font-size: 0.68rem;
            color: #64748b;
            line-height: 1.35;
            text-align: center;
        }

        .marketing-section-group--banner .marketing-banner-upload-card__body input {
            display: none;
        }

        .marketing-section-group--banner .marketing-banner-upload-card__status {
            margin-top: 8px;
            font-size: 0.72rem;
            color: #64748b;
            text-align: center;
        }

        .marketing-section-group--banner .marketing-banner-upload-card__button {
            margin-top: 10px;
            width: 100%;
            border: 1px dashed rgba(37, 99, 235, 0.28);
            background: #eff6ff;
            color: #1d4ed8;
            border-radius: 12px;
            padding: 9px 12px;
            font-size: 0.8rem;
            font-weight: 700;
            transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
        }

        .marketing-section-group--banner .marketing-banner-upload-card__button:hover {
            background: #dbeafe;
            border-color: rgba(29, 78, 216, 0.38);
            transform: translateY(-1px);
        }

        .marketing-seo-image-picker {
            margin-top: 8px;
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 16px;
            background: #fff;
            padding: 14px;
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }

        .marketing-seo-image-picker__top {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .marketing-seo-image-picker__preview {
            width: 96px;
            height: 96px;
            flex: 0 0 96px;
            border-radius: 14px;
            overflow: hidden;
            background: #e2e8f0;
            border: 1px solid rgba(148, 163, 184, 0.18);
        }

        .marketing-seo-image-picker__preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .marketing-seo-image-picker__details {
            display: flex;
            flex-direction: column;
            gap: 6px;
            min-width: 0;
        }

        .marketing-seo-image-picker__content strong {
            display: block;
            font-size: 0.9rem;
            color: #0f172a;
            margin-bottom: 2px;
        }

        .marketing-seo-image-picker__content span {
            font-size: 0.78rem;
            color: #64748b;
            line-height: 1.45;
        }

        .marketing-seo-image-picker__path {
            font-size: 0.75rem;
            color: #475569;
            background: #f8fafc;
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 10px;
            padding: 8px 10px;
            word-break: break-all;
        }

        .marketing-seo-image-picker__actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            flex-wrap: wrap;
            padding-top: 10px;
            border-top: 1px solid rgba(226, 232, 240, 0.9);
        }

        .marketing-seo-image-picker__button {
            border: 0;
            border-radius: 10px;
            background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
            color: #fff;
            padding: 8px 12px;
            font-size: 0.78rem;
            font-weight: 600;
            white-space: nowrap;
            box-shadow: 0 8px 16px rgba(37, 99, 235, 0.18);
        }

        .marketing-seo-image-picker__hint {
            font-size: 0.72rem;
            color: #64748b;
        }

        .marketing-section-group--banner .marketing-banner-preview-shell .hero.scrap-hero {
            margin: 0;
            min-height: auto;
            padding: 32px 28px;
        }

        .marketing-section-group--banner .marketing-banner-preview-shell .container-fluid.home-wide-shell {
            max-width: 100%;
            padding-left: 0;
            padding-right: 0;
        }

        .marketing-section-group--banner .marketing-banner-preview-shell .row {
            --bs-gutter-x: 1.25rem;
            --bs-gutter-y: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: nowrap;
        }

        .marketing-section-group--banner .marketing-banner-preview-shell .hero-title {
            font-size: clamp(28px, 2.5vw, 42px);
            margin-bottom: 0;
            max-width: 380px;
        }

        .marketing-section-group--banner .marketing-banner-preview-shell .hero-content {
            width: 38%;
            flex: 0 0 38%;
            max-width: 38%;
            padding-right: 8px;
        }

        .marketing-section-group--banner .marketing-banner-preview-shell .col-lg-7 {
            width: 62%;
            flex: 0 0 62%;
            max-width: 62%;
            margin-left: auto;
        }

        .marketing-section-group--banner .marketing-banner-preview-shell .hero-actions {
            display: none;
        }

        .marketing-section-group--banner .marketing-banner-preview-shell .hero-visual-wrap,
        .marketing-section-group--banner .marketing-banner-preview-shell .hero-illustration {
            min-height: 300px;
        }

        .marketing-section-group--banner .marketing-banner-preview-shell .hero-illustration-mask {
            inset: 12px 14px;
        }

        .marketing-section-group--banner .marketing-banner-preview-shell .hero-banner-slider .swiper-slide,
        .marketing-section-group--banner .marketing-banner-preview-shell .hero-banner-slider img {
            min-height: 240px;
        }

        .marketing-section-group--banner .marketing-banner-preview-shell .hero-illustration img {
            object-fit: cover;
        }

        @@media (max-width: 991px) {
            .marketing-section-group--banner .marketing-banner-preview-shell .row {
                flex-wrap: wrap;
            }

            .marketing-section-group--banner .marketing-banner-preview-shell .hero-content,
            .marketing-section-group--banner .marketing-banner-preview-shell .col-lg-7 {
                width: 100%;
                flex: 0 0 100%;
                max-width: 100%;
            }
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/assets/js/main.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toast = typeof Swal !== 'undefined'
                ? Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 2600,
                    timerProgressBar: true
                })
                : null;

            const showToast = function (icon, title) {
                if (toast) {
                    toast.fire({ icon, title });
                }
            };

            const toClientUrl = function (url) {
                if (!url) {
                    return url;
                }

                return url.startsWith('~/') ? url.substring(1) : url;
            };

            const appendCacheBuster = function (url) {
                if (!url) {
                    return url;
                }

                const separator = url.includes('?') ? '&' : '?';
                return `${url}${separator}v=${Date.now()}`;
            };

            const marketingRoot = document.querySelector('.marketing-section-group--banner');
            if (marketingRoot) {
                marketingRoot.addEventListener('submit', function (event) {
                    event.preventDefault();
                });
            }

            if (typeof Swiper === 'undefined') {
                return;
            }

            const adminBanner = document.querySelector('.marketing-banner-preview-shell .hero-banner-slider');
            if (!adminBanner) {
                return;
            }

            if (adminBanner.swiper) {
                adminBanner.swiper.destroy(true, true);
            }

            const adminBannerSwiper = new Swiper(adminBanner, {
                speed: 600,
                loop: true,
                autoplay: {
                    delay: 3500,
                    disableOnInteraction: false
                },
                slidesPerView: 1,
                pagination: {
                    el: adminBanner.querySelector('.swiper-pagination'),
                    type: 'bullets',
                    clickable: true
                }
            });

            const titleInputs = [
                document.querySelector('#banner-line-1'),
                document.querySelector('#banner-line-2'),
                document.querySelector('#banner-line-3'),
                document.querySelector('#banner-line-4')
            ];

            const titlePreviewTargets = [
                document.querySelector('[data-banner-line="1"]'),
                document.querySelector('[data-banner-line="2"]'),
                document.querySelector('[data-banner-line="3"]'),
                document.querySelector('[data-banner-line="4"]')
            ];

            titleInputs.forEach(function (input, index) {
                if (!input || !titlePreviewTargets[index]) {
                    return;
                }

                input.addEventListener('input', function () {
                    titlePreviewTargets[index].textContent = input.value || ' ';
                });
            });

            const uploadForms = document.querySelectorAll('[data-temp-upload-form]');
            const getBannerPayload = function () {
                const imageInputs = Array.from(document.querySelectorAll('[data-image-path-input]'));

                return {
                    bannerId: Number.parseInt(document.querySelector('#banner-id')?.value || '', 10) || null,
                    bannerLine1: document.querySelector('#banner-line-1')?.value || '',
                    bannerLine2: document.querySelector('#banner-line-2')?.value || '',
                    bannerLine3: document.querySelector('#banner-line-3')?.value || '',
                    bannerLine4: document.querySelector('#banner-line-4')?.value || '',
                    bannerImage1: imageInputs[0]?.value || '',
                    bannerImage2: imageInputs[1]?.value || '',
                    bannerImage3: imageInputs[2]?.value || ''
                };
            };

            const getContactPayload = function () {
                return {
                    phone: document.querySelector('#contact-phone')?.value || '',
                    zalo: document.querySelector('#contact-zalo')?.value || '',
                    messenger: document.querySelector('#contact-messenger')?.value || '',
                    facebook: document.querySelector('#contact-facebook')?.value || '',
                    email: document.querySelector('#contact-email')?.value || '',
                    address: document.querySelector('#contact-address')?.value || '',
                    purchaseAreas: document.querySelector('#contact-purchase-areas')?.value || ''
                };
            };

            const applyContactState = function (state) {
                const map = {
                    '#contact-phone': state.phone,
                    '#contact-zalo': state.zalo,
                    '#contact-messenger': state.messenger,
                    '#contact-facebook': state.facebook,
                    '#contact-email': state.email,
                    '#contact-address': state.address,
                    '#contact-purchase-areas': state.purchaseAreas
                };

                Object.entries(map).forEach(function ([selector, value]) {
                    const element = document.querySelector(selector);
                    if (element) {
                        element.value = value || '';
                    }
                });
            };

            const getSeoPayload = function () {
                return {
                    metaTitle: document.querySelector('#seo-meta-title')?.value || '',
                    metaDescription: document.querySelector('#seo-meta-description')?.value || '',
                    seoKeywords: document.querySelector('#seo-keywords')?.value || '',
                    ogTitle: document.querySelector('#seo-og-title')?.value || '',
                    ogImage: document.querySelector('#seo-og-image')?.value || ''
                };
            };

            const applySeoState = function (state) {
                const map = {
                    '#seo-meta-title': state.metaTitle,
                    '#seo-meta-description': state.metaDescription,
                    '#seo-keywords': state.seoKeywords,
                    '#seo-og-title': state.ogTitle,
                    '#seo-og-image': state.ogImage
                };

                Object.entries(map).forEach(function ([selector, value]) {
                    const element = document.querySelector(selector);
                    if (element) {
                        element.value = value || '';
                    }
                });

                const seoPreviewPath = document.querySelector('[data-seo-og-path]');
                const seoPreviewImage = document.querySelector('[data-seo-og-preview]');
                if (seoPreviewPath) {
                    seoPreviewPath.textContent = state.ogImage || '';
                }
                if (seoPreviewImage && state.ogImage) {
                    seoPreviewImage.src = toClientUrl(state.ogImage);
                }
            };

            const seoOgFileInput = document.querySelector('#seo-og-file');
            const seoOgTrigger = document.querySelector('[data-trigger-seo-og-upload]');
            if (seoOgFileInput && seoOgTrigger) {
                seoOgTrigger.addEventListener('click', function (event) {
                    event.preventDefault();
                    seoOgFileInput.click();
                });

                seoOgFileInput.addEventListener('change', async function () {
                    const file = seoOgFileInput.files && seoOgFileInput.files[0];
                    if (!file) {
                        return;
                    }

                    const localPreviewUrl = URL.createObjectURL(file);
                    const seoPreviewImage = document.querySelector('[data-seo-og-preview]');
                    const seoPreviewPath = document.querySelector('[data-seo-og-path]');
                    const seoOgImageInput = document.querySelector('#seo-og-image');

                    if (seoPreviewImage) {
                        seoPreviewImage.src = localPreviewUrl;
                    }

                    const formData = new FormData();
                    formData.append('file', file);

                    try {
                        const response = await fetch('/admin/marketing/upload-seo-image', {
                            method: 'POST',
                            body: formData
                        });

                        const result = await response.json();
                        if (!response.ok || !result.success || !result.url) {
                            throw new Error('Upload ảnh SEO thất bại');
                        }

                        if (seoPreviewImage) {
                            seoPreviewImage.src = toClientUrl(result.url);
                        }

                        if (seoPreviewPath) {
                            seoPreviewPath.textContent = result.url;
                        }

                        if (seoOgImageInput) {
                            seoOgImageInput.value = result.url;
                        }

                        URL.revokeObjectURL(localPreviewUrl);
                    } catch (error) {
                        URL.revokeObjectURL(localPreviewUrl);
                    } finally {
                        seoOgFileInput.value = '';
                    }
                });
            }

            const applyBannerState = function (state) {
                const line1Input = document.querySelector('#banner-line-1');
                const line2Input = document.querySelector('#banner-line-2');
                const line3Input = document.querySelector('#banner-line-3');
                const line4Input = document.querySelector('#banner-line-4');
                const bannerIdInput = document.querySelector('#banner-id');

                if (bannerIdInput) bannerIdInput.value = state.bannerId ?? '';
                if (line1Input) line1Input.value = state.bannerLine1 || '';
                if (line2Input) line2Input.value = state.bannerLine2 || '';
                if (line3Input) line3Input.value = state.bannerLine3 || '';
                if (line4Input) line4Input.value = state.bannerLine4 || '';

                const titleTargets = [
                    document.querySelector('[data-banner-line="1"]'),
                    document.querySelector('[data-banner-line="2"]'),
                    document.querySelector('[data-banner-line="3"]'),
                    document.querySelector('[data-banner-line="4"]')
                ];

                [state.bannerLine1, state.bannerLine2, state.bannerLine3, state.bannerLine4].forEach(function (value, index) {
                    if (titleTargets[index]) {
                        titleTargets[index].textContent = value || ' ';
                    }
                });

                const imageValues = [state.bannerImage1, state.bannerImage2, state.bannerImage3];
                const previewImages = Array.from(document.querySelectorAll('[data-preview-image]'));
                const imageInputs = Array.from(document.querySelectorAll('[data-image-path-input]'));

                previewImages.forEach(function (image, index) {
                        if (imageValues[index]) {
                            image.src = appendCacheBuster(toClientUrl(imageValues[index]));
                        }
                    });

                imageInputs.forEach(function (input, index) {
                    if (imageValues[index]) {
                        input.value = imageValues[index];
                    }
                });

                if (adminBannerSwiper) {
                    adminBannerSwiper.removeAllSlides();
                    adminBannerSwiper.appendSlide([
                        `<div class="swiper-slide"><img src="${appendCacheBuster(toClientUrl(imageValues[0]))}" data-banner-slider-image="1" alt="Banner 1" class="img-fluid w-100"></div>`,
                        `<div class="swiper-slide"><img src="${appendCacheBuster(toClientUrl(imageValues[1]))}" data-banner-slider-image="2" alt="Banner 2" class="img-fluid w-100"></div>`,
                        `<div class="swiper-slide"><img src="${appendCacheBuster(toClientUrl(imageValues[2]))}" data-banner-slider-image="3" alt="Banner 3" class="img-fluid w-100"></div>`
                    ]);
                    adminBannerSwiper.update();
                    adminBannerSwiper.slideToLoop(0, 0, false);
                    adminBannerSwiper.autoplay?.stop();
                    adminBannerSwiper.autoplay?.start();
                }
            };
            uploadForms.forEach(function (form) {
                const fileInput = form.querySelector('input[type="file"]');
                const triggerButton = form.querySelector('[data-trigger-upload]');
                const previewImage = form.querySelector('[data-preview-image]');
                const sliderImage = document.querySelector(form.getAttribute('data-slider-target'));
                const pathInput = form.querySelector('[data-image-path-input]');
                const statusText = form.querySelector('[data-upload-status]');

                if (!fileInput || !previewImage || !sliderImage || !pathInput) {
                    return;
                }

                if (triggerButton) {
                    triggerButton.addEventListener('click', function (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        fileInput.click();
                    });
                }

                form.addEventListener('click', function (event) {
                    const clickedAction = event.target.closest('button, input, textarea, a');
                    if (clickedAction) {
                        return;
                    }

                    fileInput.click();
                });

                fileInput.addEventListener('change', async function () {
                    const file = fileInput.files && fileInput.files[0];
                    if (!file) {
                        return;
                    }

                    const localPreviewUrl = URL.createObjectURL(file);
                    previewImage.src = localPreviewUrl;

                    const bannerIndex = Number.parseInt(form.getAttribute('data-banner-index') || '0', 10) || 0;

                    if (adminBannerSwiper) {
                        adminBannerSwiper.removeAllSlides();
                        adminBannerSwiper.appendSlide([
                            `<div class="swiper-slide"><img src="${bannerIndex === 0 ? localPreviewUrl : document.querySelectorAll('[data-image-path-input]')[0]?.value || '@Model.BannerImage1'}" data-banner-slider-image="1" alt="Banner 1" class="img-fluid w-100"></div>`,
                            `<div class="swiper-slide"><img src="${bannerIndex === 1 ? localPreviewUrl : document.querySelectorAll('[data-image-path-input]')[1]?.value || '@Model.BannerImage2'}" data-banner-slider-image="2" alt="Banner 2" class="img-fluid w-100"></div>`,
                            `<div class="swiper-slide"><img src="${bannerIndex === 2 ? localPreviewUrl : document.querySelectorAll('[data-image-path-input]')[2]?.value || '@Model.BannerImage3'}" data-banner-slider-image="3" alt="Banner 3" class="img-fluid w-100"></div>`
                        ]);
                        adminBannerSwiper.update();
                        adminBannerSwiper.slideToLoop(bannerIndex, 0, false);
                        adminBannerSwiper.autoplay?.stop();
                        adminBannerSwiper.autoplay?.start();
                    }

                    const formData = new FormData();
                    formData.append('file', file);
                    formData.append('bannerIndex', String(bannerIndex + 1));

                    if (statusText) {
                            statusText.textContent = 'Đang tải ảnh...';
                    }

                    try {
                        const response = await fetch('/admin/marketing/upload-active-image', {
                            method: 'POST',
                            body: formData
                        });

                        if (!response.ok) {
                            throw new Error('Upload ảnh banner thất bại');
                        }

                        const result = await response.json();
                        if (!result.success || !result.url) {
                            throw new Error('Không nhận được đường dẫn ảnh banner');
                        }

                        previewImage.src = appendCacheBuster(toClientUrl(result.url));
                        pathInput.value = result.url;

                        if (adminBannerSwiper) {
                            const currentBannerValues = Array.from(document.querySelectorAll('[data-image-path-input]')).map(function (input, index) {
                                return index === bannerIndex ? result.url : input.value;
                            });

                            adminBannerSwiper.removeAllSlides();
                            adminBannerSwiper.appendSlide([
                                `<div class="swiper-slide"><img src="${appendCacheBuster(toClientUrl(currentBannerValues[0] || '@Model.BannerImage1'))}" data-banner-slider-image="1" alt="Banner 1" class="img-fluid w-100"></div>`,
                                `<div class="swiper-slide"><img src="${appendCacheBuster(toClientUrl(currentBannerValues[1] || '@Model.BannerImage2'))}" data-banner-slider-image="2" alt="Banner 2" class="img-fluid w-100"></div>`,
                                `<div class="swiper-slide"><img src="${appendCacheBuster(toClientUrl(currentBannerValues[2] || '@Model.BannerImage3'))}" data-banner-slider-image="3" alt="Banner 3" class="img-fluid w-100"></div>`
                            ]);
                            adminBannerSwiper.update();
                            adminBannerSwiper.slideToLoop(bannerIndex, 0, false);
                            adminBannerSwiper.autoplay?.stop();
                            adminBannerSwiper.autoplay?.start();
                        }
                        URL.revokeObjectURL(localPreviewUrl);

                        if (statusText) {
                            statusText.textContent = 'Đã cập nhật ảnh banner';
                        }
                    } catch (error) {
                        URL.revokeObjectURL(localPreviewUrl);
                        if (statusText) {
                            statusText.textContent = 'Tải ảnh banner thất bại';
                        }
                    } finally {
                        fileInput.value = '';
                    }
                });
            });

            const saveBannerButton = document.querySelector('[data-save-banner]');
            if (saveBannerButton) {
                saveBannerButton.addEventListener('click', async function () {
                    saveBannerButton.disabled = true;

                    try {
                        const response = await fetch('/admin/marketing/save-banner', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(getBannerPayload())
                        });

                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            throw new Error('Lưu banner thất bại');
                        }

                        applyBannerState(result);
                        showToast('success', 'Đã lưu banner thành công');
                    } catch (error) {
                        showToast('error', 'Lưu banner thất bại');
                    } finally {
                        saveBannerButton.disabled = false;
                    }
                });
            }

            const reloadBannerButton = document.querySelector('[data-reload-banner]');
            if (reloadBannerButton) {
                reloadBannerButton.addEventListener('click', async function () {
                    reloadBannerButton.disabled = true;

                    try {
                        const response = await fetch('/admin/marketing/banner-state');
                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            throw new Error('Tải lại banner thất bại');
                        }

                        applyBannerState(result);
                        showToast('success', 'Đã tải lại banner');
                    } catch (error) {
                        showToast('error', 'Tải lại banner thất bại');
                    } finally {
                        reloadBannerButton.disabled = false;
                    }
                });
            }

            const saveContactButton = document.querySelector('[data-save-contact]');
            if (saveContactButton) {
                saveContactButton.addEventListener('click', async function () {
                    saveContactButton.disabled = true;
                    try {
                        const response = await fetch('/admin/marketing/save-contact', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(getContactPayload())
                        });
                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            throw new Error('Lưu liên hệ thất bại');
                        }

                        applyContactState(result);
                        showToast('success', 'Đã lưu thông tin liên hệ');
                    } catch (error) {
                        showToast('error', 'Lưu thông tin liên hệ thất bại');
                    } finally {
                        saveContactButton.disabled = false;
                    }
                });
            }

            const reloadContactButton = document.querySelector('[data-reload-contact]');
            if (reloadContactButton) {
                reloadContactButton.addEventListener('click', async function () {
                    reloadContactButton.disabled = true;
                    try {
                        const response = await fetch('/admin/marketing/contact-state');
                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            throw new Error('Tải lại liên hệ thất bại');
                        }

                        applyContactState(result);
                        showToast('success', 'Đã tải lại thông tin liên hệ');
                    } catch (error) {
                        showToast('error', 'Tải lại thông tin liên hệ thất bại');
                    } finally {
                        reloadContactButton.disabled = false;
                    }
                });
            }

            const saveSeoButton = document.querySelector('[data-save-seo]');
            if (saveSeoButton) {
                saveSeoButton.addEventListener('click', async function () {
                    saveSeoButton.disabled = true;
                    try {
                        const response = await fetch('/admin/marketing/save-seo', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(getSeoPayload())
                        });
                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            throw new Error('Lưu SEO thất bại');
                        }

                        applySeoState(result);
                        showToast('success', 'Đã lưu cấu hình SEO');
                    } catch (error) {
                        showToast('error', 'Lưu cấu hình SEO thất bại');
                    } finally {
                        saveSeoButton.disabled = false;
                    }
                });
            }

            const reloadSeoButton = document.querySelector('[data-reload-seo]');
            if (reloadSeoButton) {
                reloadSeoButton.addEventListener('click', async function () {
                    reloadSeoButton.disabled = true;
                    try {
                        const response = await fetch('/admin/marketing/seo-state');
                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            throw new Error('Tải lại SEO thất bại');
                        }

                        applySeoState(result);
                        showToast('success', 'Đã tải lại cấu hình SEO');
                    } catch (error) {
                        showToast('error', 'Tải lại cấu hình SEO thất bại');
                    } finally {
                        reloadSeoButton.disabled = false;
                    }
                });
            }
        });
    </script>
}

