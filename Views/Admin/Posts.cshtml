@model WebThuMuaPheLieu.Models.AdminPostsPageViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var publishedAtValue = Model.Editor.Input.PublishedAt?.ToString("yyyy-MM-ddTHH:mm");
    var currentStatusRoute = string.IsNullOrWhiteSpace(Model.SelectedStatus) ? null : Model.SelectedStatus;
    var currentCategoryRoute = Model.SelectedCategoryId;
    var currentPostsPage = Model.CurrentPage > 0 ? Model.CurrentPage : 1;
    var postsPageUrl = Url.Action("Posts", "Admin", new
    {
        searchTerm = Model.SearchTerm,
        status = currentStatusRoute,
        categoryId = currentCategoryRoute,
        page = currentPostsPage > 1 ? (int?)currentPostsPage : null
    }) ?? "/Admin/Posts";
    var createPostUrl = $"{postsPageUrl}#editor-panel";
    var postsListUrl = $"{postsPageUrl}#posts-panel";
    var paginationStartPage = Math.Max(1, currentPostsPage - 2);
    var paginationEndPage = Math.Min(Model.TotalPages, paginationStartPage + 4);
    paginationStartPage = Math.Max(1, paginationEndPage - 4);
    var shouldOpenEditor = Model.Editor.IsEditing || (!ViewData.ModelState.IsValid && string.IsNullOrWhiteSpace(Model.ActiveSection));
    var initialSection = !string.IsNullOrWhiteSpace(Model.ActiveSection)
        ? Model.ActiveSection
        : shouldOpenEditor ? "editor" : "posts";
}


@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="posts-flash posts-flash--success">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="posts-flash posts-flash--error">@Model.ErrorMessage</div>
}

<nav class="posts-section-nav" aria-label="Điều hướng quản trị blog" data-posts-nav>
    <a href="#posts-panel"
       class="posts-section-nav__item js-posts-section-trigger @(initialSection == "posts" ? "is-active" : null)"
       data-section-target="posts"
       aria-controls="posts-panel">
        <span class="posts-section-nav__eyebrow">Chính</span>
        <strong>Danh sách bài viết</strong>
        <small>Tìm kiếm, lọc và thao tác bài viết</small>
    </a>

    <a href="#overview-panel"
       class="posts-section-nav__item js-posts-section-trigger @(initialSection == "overview" ? "is-active" : null)"
       data-section-target="overview"
       aria-controls="overview-panel">
        <span class="posts-section-nav__eyebrow">Tổng quan</span>
        <strong>Tổng quan</strong>
        <small>Chỉ số, quy trình và thao tác nhanh</small>
    </a>

    <a href="#editor-panel"
       class="posts-section-nav__item js-posts-section-trigger @(initialSection == "editor" ? "is-active" : null)"
       data-section-target="editor"
       aria-controls="editor-panel">
        <span class="posts-section-nav__eyebrow">Biên tập</span>
        <strong>Trình soạn thảo</strong>
        <small>Mở khi tạo mới hoặc chỉnh sửa</small>
    </a>

    <a href="#categories-panel"
       class="posts-section-nav__item js-posts-section-trigger @(initialSection == "categories" ? "is-active" : null)"
       data-section-target="categories"
       aria-controls="categories-panel">
        <span class="posts-section-nav__eyebrow">Phân loại</span>
        <strong>Chuyên mục</strong>
        <small>Quản lý chuyên mục và điều hướng lọc</small>
    </a>
</nav>

<div class="posts-section-shell" data-posts-sections data-initial-section="@initialSection">
    <section class="posts-section-panel @(initialSection == "posts" ? "is-active" : null)" id="posts-panel" data-section-panel="posts">
        <div class="panel posts-panel posts-panel--table">
            <div class="panel__head posts-panel__head posts-panel__head--stacked">
                <div>
                    <p class="eyebrow">Kho bài viết</p>
                    <h3>Danh sách bài viết</h3>
                </div>

                <div class="posts-panel__actions">
                    <a href="#categories-panel" class="btn-ghost-posts js-posts-section-trigger" data-section-target="categories">Xem chuyên mục</a>
                    <a href="@createPostUrl" class="btn-primary-posts">Tạo bài viết</a>
                </div>
            </div>

            <form method="get" asp-action="Posts" asp-controller="Admin" class="posts-toolbar">
                <label class="search-box posts-search-box" aria-label="Tìm bài viết">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="7"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Tìm theo tiêu đề, slug, category, author..." />
                </label>

                <select name="status" class="posts-select">
                    @foreach (var filter in Model.StatusFilters)
                    {
                        <option value="@filter.Value" selected="@(filter.Selected ? "selected" : null)">@filter.Label</option>
                    }
                </select>

                <select name="categoryId" class="posts-select">
                    @foreach (var option in Model.CategoryFilters)
                    {
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Label</option>
                    }
                </select>

                <div class="posts-topbar__buttons">
                    <button type="submit" class="btn-secondary-posts">Lọc dữ liệu</button>
                    <a asp-action="Posts" asp-controller="Admin" class="btn-ghost-posts">Làm mới</a>
                </div>
            </form>

            <div class="posts-filter-row">
                @foreach (AdminFilterOptionViewModel filter in Model.StatusFilters)
                {
                    <a asp-action="Posts"
                       asp-controller="Admin"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-status="@(string.IsNullOrWhiteSpace(filter.Value) ? null : filter.Value)"
                       asp-route-categoryId="@Model.SelectedCategoryId"
                       class="@(filter.Selected ? "is-active" : null)">
                        @filter.Label
                    </a>
                }
            </div>

            <div class="table-shell posts-table-shell">
                <table class="product-table posts-table">
                    <thead>
                        <tr>
                            <th>Bài viết</th>
                            <th>Chuyên mục</th>
                            <th>Lịch xuất bản</th>
                            <th>Tài nguyên</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Posts.Count == 0)
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="posts-empty-state">
                                        <strong>Không có bài viết phù hợp bộ lọc hiện tại.</strong>
                                        <span>Hãy thay đổi từ khoá tìm kiếm, trạng thái hoặc chuyên mục để xem dữ liệu khác.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var post in Model.Posts)
                            {
                                var editPostUrl = $"{Url.Action("Posts", "Admin", new { searchTerm = Model.SearchTerm, status = currentStatusRoute, categoryId = currentCategoryRoute, editId = post.Id, page = currentPostsPage > 1 ? (int?)currentPostsPage : null })}#editor-panel";

                                <tr>
                                    <td>
                                        <div class="posts-table__main">
                                            <div class="posts-table__title-row">
                                                <strong>@post.Title</strong>
                                                <span class="posts-table__id">#@post.Id</span>
                                            </div>
                                            <span class="posts-table__slug">/@post.Slug</span>
                                            <p>@post.Excerpt</p>
                                            <div class="posts-inline-meta">
                                                <span>Tác giả: @post.Author</span>
                                                <span>Tạo: @post.CreatedText</span>
                                                <span>Cập nhật: @post.UpdatedText</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="posts-table__category">
                                            <strong>@post.Category</strong>
                                            <span>@post.CategorySlug</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="posts-table__schedule">
                                            <strong>@post.PublishText</strong>
                                            <span>@post.PublishHint</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="posts-resource-stack">
                                            <span class="posts-pill posts-pill--@post.CoverClass">@post.CoverText</span>
                                            <span class="posts-pill">@post.GalleryImages ảnh </span>
                                            <span class="posts-pill">@post.RelatedProducts sản phẩm liên quan</span>
                                            <span class="posts-pill">@post.Likes lượt thích</span>
                                        </div>
                                        <small class="posts-resource-note">@post.RelatedProductSummary</small>
                                    </td>
                                    <td>
                                        <span class="posts-status-badge posts-status-badge--@post.StatusClass">@post.StatusLabel</span>
                                    </td>
                                    <td>
                                        <div class="posts-table__actions">
                                            <a href="@editPostUrl">Chỉnh sửa</a>

                                            @if (!string.IsNullOrWhiteSpace(post.PublicUrl))
                                            {
                                                <a href="@post.PublicUrl" target="_blank" rel="noreferrer" class="is-muted">Xem thực tế</a>
                                            }

                                            <form asp-action="ChangePostStatus" asp-controller="Admin" method="post" class="posts-action-inline-form">
                                                <input type="hidden" name="id" value="@post.Id" />
                                                <input type="hidden" name="status" value="@post.PrimaryActionValue" />
                                                <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                                <input type="hidden" name="returnStatus" value="@Model.SelectedStatus" />
                                                <input type="hidden" name="returnCategoryId" value="@Model.SelectedCategoryId" />
                                                <input type="hidden" name="editId" value="@Model.Editor.Input.Id" />
                                                <input type="hidden" name="returnPage" value="@Model.CurrentPage" />
                                                <button type="submit">@post.PrimaryAction</button>
                                            </form>

                                            <form asp-action="ChangePostStatus" asp-controller="Admin" method="post" class="posts-action-inline-form">
                                                <input type="hidden" name="id" value="@post.Id" />
                                                <input type="hidden" name="status" value="@post.SecondaryActionValue" />
                                                <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                                <input type="hidden" name="returnStatus" value="@Model.SelectedStatus" />
                                                <input type="hidden" name="returnCategoryId" value="@Model.SelectedCategoryId" />
                                                <input type="hidden" name="editId" value="@Model.Editor.Input.Id" />
                                                <input type="hidden" name="returnPage" value="@Model.CurrentPage" />
                                                <button type="submit" class="is-muted">@post.SecondaryAction</button>
                                            </form>

                                            <form asp-action="DeletePost" asp-controller="Admin" method="post" class="posts-action-inline-form" onsubmit="return confirm('Xóa bài viết này và toàn bộ liên kết liên quan?');">
                                                <input type="hidden" name="id" value="@post.Id" />
                                                <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                                <input type="hidden" name="returnStatus" value="@Model.SelectedStatus" />
                                                <input type="hidden" name="returnCategoryId" value="@Model.SelectedCategoryId" />
                                                <input type="hidden" name="editId" value="@Model.Editor.Input.Id" />
                                                <input type="hidden" name="returnPage" value="@Model.CurrentPage" />
                                                <button type="submit" class="is-danger">Xóa</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="posts-pagination">
                <div class="posts-pagination__summary">
                    @if (Model.TotalFilteredPosts > 0)
                    {
                        <span>Hiển thị @Model.StartItemIndex-@Model.EndItemIndex trên @Model.TotalFilteredPosts bài viết</span>
                    }
                    else
                    {
                        <span>Không có bài viết nào trong bộ lọc hiện tại</span>
                    }

                    <strong>Trang @Model.CurrentPage/@Model.TotalPages</strong>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="posts-pagination__nav" aria-label="Phân trang danh sách bài viết">
                        <a href="@(Model.CurrentPage > 1 ? $"{Url.Action("Posts", "Admin", new { searchTerm = Model.SearchTerm, status = currentStatusRoute, categoryId = currentCategoryRoute, page = Model.CurrentPage - 1 })}#posts-panel" : "#")"
                           class="posts-pagination__link @(Model.CurrentPage == 1 ? "is-disabled" : null)"
                           aria-disabled="@(Model.CurrentPage == 1 ? "true" : "false")">Trước</a>

                        @for (var pageNumber = paginationStartPage; pageNumber <= paginationEndPage; pageNumber++)
                        {
                            <a href="@($"{Url.Action("Posts", "Admin", new { searchTerm = Model.SearchTerm, status = currentStatusRoute, categoryId = currentCategoryRoute, page = pageNumber })}#posts-panel")"
                               class="posts-pagination__link @(pageNumber == Model.CurrentPage ? "is-current" : null)"
                               aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                        }

                        <a href="@(Model.CurrentPage < Model.TotalPages ? $"{Url.Action("Posts", "Admin", new { searchTerm = Model.SearchTerm, status = currentStatusRoute, categoryId = currentCategoryRoute, page = Model.CurrentPage + 1 })}#posts-panel" : "#")"
                           class="posts-pagination__link @(Model.CurrentPage == Model.TotalPages ? "is-disabled" : null)"
                           aria-disabled="@(Model.CurrentPage == Model.TotalPages ? "true" : "false")">Sau</a>
                    </nav>
                }
            </div>
        </div>
    </section>

    <section class="posts-section-panel @(initialSection == "overview" ? "is-active" : null)" id="overview-panel" data-section-panel="overview">
        <div class="posts-dashboard-grid posts-dashboard-grid--overview">
            <div class="posts-dashboard-main posts-dashboard-main--overview">
                <section class="panel posts-panel posts-panel--overview-hero">
                    <div class="panel__head posts-panel__head posts-panel__head--stacked">
                        <div>
                            <p class="eyebrow">Tổng quan</p>
                            <h3>Tổng quan vận hành nội dung</h3>
                            <p class="posts-panel__summary">Gom toàn bộ chỉ số và quy trình làm việc vào một khu vực riêng để người quản trị xem nhanh tình trạng của hệ thống blog mà không bị lẫn với bảng dữ liệu.</p>
                        </div>
                        <a href="#posts-panel" class="btn-ghost-posts js-posts-section-trigger" data-section-target="posts">Đến danh sách bài viết</a>
                    </div>

                    <section class="posts-metrics-grid" aria-label="Chỉ số bài viết blog">
                        @foreach (var metric in Model.MetricCards)
                        {
                            <article class="posts-metric-card posts-metric-card--@metric.Tone">
                                <span class="posts-metric-card__label">@metric.Label</span>
                                <strong class="posts-metric-card__value">
                                    @metric.Value@if (metric.Label == "SEO trung bình")
                                    {
                                        <span>/100</span>
                                    }
                                </strong>
                                <span class="posts-metric-card__meta">@metric.Meta</span>
                            </article>
                        }
                    </section>
                </section>

                <div class="posts-overview-split">
                    <section class="panel posts-panel posts-panel--overview-flow">
                    <div class="panel__head posts-panel__head">
                        <div>
                            <p class="eyebrow">Quy trình biên tập</p>
                            <h3>Trạng thái vận hành nội dung</h3>
                        </div>
                        <span class="posts-panel__tag">Quy trình · xuất bản · phương tiện</span>
                    </div>

                    <div class="posts-workflow-grid">
                        @foreach (var item in Model.WorkflowItems)
                        {
                            <article class="posts-workflow-card posts-workflow-card--@item.Tone">
                                <div class="posts-workflow-card__top">
                                    <span>@item.Label</span>
                                    <strong>@item.Count</strong>
                                </div>
                                <p>@item.Hint</p>
                            </article>
                        }
                    </div>

                    <div class="posts-action-grid">
                        @foreach (var action in Model.QuickActions)
                        {
                            <article class="posts-action-card">
                                <h4>@action.Title</h4>
                                <p>@action.Description</p>
                                <a href="@action.ActionUrl" class="btn-secondary-posts">@action.Cta</a>
                            </article>
                        }
                    </div>
                    </section>

                    <section class="panel posts-panel posts-panel--overview-note">
                        <div class="panel__head posts-panel__head posts-panel__head--stacked">
                            <div>
                                <p class="eyebrow">Điều hướng nhanh</p>
                                <h3>Thao tác được dùng nhiều</h3>
                                <p class="posts-panel__summary">Tập trung các bước hay dùng để đi từ tổng quan sang khu vực xử lý bài viết nhanh hơn.</p>
                            </div>
                        </div>

                        <div class="posts-overview-note-list">
                            <article class="posts-overview-note-item">
                                <strong>Xem tình trạng nội dung</strong>
                                <span>Theo dõi số lượng bài viết, chất lượng SEO và tiến độ xử lý ngay ở cụm chỉ số phía trên.</span>
                            </article>
                            <article class="posts-overview-note-item">
                                <strong>Kiểm tra quy trình biên tập</strong>
                                <span>Quan sát các trạng thái quan trọng để biết bài nào đang chờ xử lý, chờ xuất bản hoặc cần bổ sung hình ảnh.</span>
                            </article>
                            <article class="posts-overview-note-item">
                                <strong>Thực hiện thao tác nhanh</strong>
                                <span>Dùng các thẻ hành động để chuyển thẳng sang danh sách bài viết, tạo bài mới hoặc mở khu vực biên tập.</span>
                            </article>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </section>

    <section class="posts-section-panel @(initialSection == "editor" ? "is-active" : null)" id="editor-panel" data-section-panel="editor">
        <section class="panel posts-panel posts-editor-panel">
            <div class="panel__head posts-panel__head posts-panel__head--stacked">
                <div>
                    <p class="eyebrow">Trình biên tập</p>
                    <h3>@Model.Editor.FormTitle</h3>
                    <p class="posts-panel__summary">Trình biên tập được tách riêng như một không gian làm việc độc lập để thao tác tạo mới hoặc chỉnh sửa bài viết mà không bị phân tâm bởi bảng tổng quan và danh sách dài.</p>
                </div>

                <div class="posts-panel__actions">
                    @if (Model.Editor.IsEditing)
                    {
                        <span class="posts-panel__tag">Đang chỉnh sửa bài viết #@Model.Editor.Input.Id</span>
                    }
                    <a href="@postsListUrl" class="btn-ghost-posts">Quay lại danh sách</a>
                </div>
            </div>

            <form asp-action="SavePost" asp-controller="Admin" method="post" enctype="multipart/form-data" class="posts-editor-form" id="posts-editor-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="posts-validation-summary"></div>

                <input asp-for="Editor.Input.Id" type="hidden" />
                <input asp-for="Editor.Input.SearchTerm" type="hidden" value="@Model.SearchTerm" />
                <input asp-for="Editor.Input.ReturnStatus" type="hidden" value="@Model.SelectedStatus" />
                <input asp-for="Editor.Input.ReturnCategoryId" type="hidden" value="@Model.SelectedCategoryId" />
                <input asp-for="Editor.Input.ReturnPage" type="hidden" value="@Model.CurrentPage" />

                <div class="posts-editor-grid">
                    <div class="posts-editor-card posts-editor-card--span-2">
                        <h4>Thông tin cơ bản</h4>
                        <div class="posts-form-grid posts-form-grid--2">
                            <div class="posts-field posts-field--span-2">
                                <label asp-for="Editor.Input.Title">Tiêu đề bài viết</label>
                                <input asp-for="Editor.Input.Title" class="posts-input" placeholder="Ví dụ: Thu mua phế liệu công trình giá cao tại TP.HCM" data-title-input />
                                <small class="posts-editor-hint">Nhập tiêu đề rõ ràng để hệ thống tự gợi ý slug bên dưới.</small>
                                <span asp-validation-for="Editor.Input.Title" class="field-validation-error"></span>
                            </div>
                            <div class="posts-field posts-field--span-2">
                                <label asp-for="Editor.Input.Slug">Đường dẫn bài viết</label>
                                <input asp-for="Editor.Input.Slug" class="posts-input" placeholder="tu-dong-tao-tu-tieu-de" autocomplete="off" data-slug-input />
                                <span asp-validation-for="Editor.Input.Slug" class="field-validation-error"></span>
                            </div>
                            <div class="posts-field posts-field--span-2">
                                <label for="ImageFiles">Ảnh bài viết</label>
                                <input asp-for="Editor.Input.CoverImage" type="hidden" data-cover-url-input />
                                <div class="posts-cover-upload posts-cover-upload--unified" data-cover-upload>
                                    <div class="posts-cover-upload__controls">
                                        <div class="posts-gallery-dropzone posts-gallery-dropzone--media" data-media-dropzone tabindex="0" role="button" aria-controls="ImageFiles">
                                            <div class="posts-gallery-dropzone__content">
                                                <strong>Kéo thả hoặc chọn ảnh bài viết</strong>
                                                <span>Ảnh đầu tiên sẽ làm ảnh đại diện. Các ảnh còn lại sẽ tự chuyển vào gallery để bạn thêm mô tả nếu cần.</span>
                                                <div class="posts-gallery-dropzone__chips">
                                                    <span>1 luồng upload duy nhất</span>
                                                    <span>Ảnh đầu = Ảnh đại diện</span>
                                                    <span>Ảnh còn lại = Thư viện ảnh</span>
                                                </div>
                                            </div>
                                            <input id="ImageFiles" name="imageFiles" type="file" multiple class="posts-input posts-input--file js-cover-file-input" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-cover-file-input data-media-file-input />
                                        </div>
                                        @Html.ValidationMessage("ImageFiles", null, new { @class = "field-validation-error" })

                                    
                                    </div>
                                    <div class="posts-cover-preview @(string.IsNullOrWhiteSpace(Model.Editor.Input.CoverImage) ? "is-empty" : null)" data-cover-preview>
                                        <img src="@(string.IsNullOrWhiteSpace(Model.Editor.Input.CoverImage) ? "" : Model.Editor.Input.CoverImage)"
                                             alt="Xem trước ảnh đại diện"
                                             class="posts-cover-preview__image"
                                             data-cover-preview-image
                                             @(string.IsNullOrWhiteSpace(Model.Editor.Input.CoverImage) ? "hidden" : null) />
                                        <div class="posts-cover-preview__placeholder" data-cover-preview-placeholder>
                                            <strong>Xem trước ảnh đại diện</strong>
                                            <span>Ảnh đại diện sẽ hiện ở đây sau khi bạn chọn file. Các ảnh còn lại sẽ xuất hiện trong gallery bên dưới.</span>
                                        </div>
                                        <div class="posts-cover-preview__meta">
                                            <span data-cover-preview-label>@(string.IsNullOrWhiteSpace(Model.Editor.Input.CoverImage) ? "Chưa có ảnh được chọn" : Model.Editor.Input.CoverImage)</span>
                                            <button type="button" class="btn-ghost-posts posts-cover-preview__clear" data-clear-upload hidden>Xoá file đã chọn</button>
                                        </div>
                                        <div class="posts-cover-files-list" data-cover-files-list hidden></div>
                                    </div>
                                </div>
                            </div>
                            <div class="posts-field posts-field--span-2">
                                <label asp-for="Editor.Input.Excerpt">Mô tả ngắn</label>
                                <textarea asp-for="Editor.Input.Excerpt" class="posts-textarea posts-textarea--sm" placeholder="Tóm tắt ngắn gọn 1-2 câu để hiển thị ở danh sách bài viết và khi chia sẻ liên kết"></textarea>
                            </div>
                            <div class="posts-field posts-field--span-2">
                                <label asp-for="Editor.Input.Content">Nội dung bài viết</label>
                                <div class="posts-rich-editor-shell is-loading" data-rich-editor-shell>
                                    <div class="posts-rich-editor-toolbar">
                                        <strong>Soạn nội dung như Word</strong>
                                        <span data-rich-editor-status>Đang tải trình soạn thảo trực quan...</span>
                                    </div>
                                    <div class="posts-editor-capabilities" aria-label="Tính năng trình soạn thảo">
                                        <span>H1 · H2 · H3</span>
                                        <span>In đậm / in nghiêng</span>
                                        <span>Danh sách</span>
                                        <span>Chèn link</span>
                                        <span>Chèn ảnh trực tiếp</span>
                                    </div>
                                    <textarea asp-for="Editor.Input.Content"
                                              class="posts-textarea posts-textarea--editor"
                                              placeholder="Bắt đầu viết nội dung bài blog tại đây. Hãy chia bài viết thành từng đoạn rõ ràng để người đọc dễ theo dõi."
                                              data-rich-editor></textarea>
                                </div>
                                <span asp-validation-for="Editor.Input.Content" class="field-validation-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="posts-editor-card">
                        <h4>Xuất bản & tác giả</h4>
                        <div class="posts-form-grid">
                            <div class="posts-field">
                                <label asp-for="Editor.Input.AuthorId">Tác giả</label>
                                <select asp-for="Editor.Input.AuthorId" class="posts-select">
                                    <option value="">Chưa gán tác giả</option>
                                    @foreach (var author in Model.Editor.AuthorOptions)
                                    {
                                        <option value="@author.Id" selected="@(author.Selected ? "selected" : null)">@author.Label</option>
                                    }
                                </select>
                                <span asp-validation-for="Editor.Input.AuthorId" class="field-validation-error"></span>
                            </div>
                            <div class="posts-field">
                                <label asp-for="Editor.Input.Status">Trạng thái</label>
                                <select asp-for="Editor.Input.Status" class="posts-select">
                                    <option value="draft">Bản nháp</option>
                                    <option value="review">Chờ duyệt</option>
                                    <option value="published">Đã xuất bản</option>
                                    <option value="hidden">Đang ẩn</option>
                                </select>
                                <span asp-validation-for="Editor.Input.Status" class="field-validation-error"></span>
                            </div>
                            <div class="posts-field">
                                <label asp-for="Editor.Input.PublishedAt">Lịch xuất bản</label>
                                <input asp-for="Editor.Input.PublishedAt" class="posts-input" type="datetime-local" value="@publishedAtValue" />
                            </div>
                        </div>
                    </div>

                    <div class="posts-editor-card">
                        <h4>Chuyên mục</h4>
                        <p class="posts-editor-hint">Mỗi bài nên có ít nhất một chuyên mục. </p>
                        <div class="posts-field">
                            <label asp-for="Editor.Input.PrimaryCategoryId">Chuyên mục lưu ảnh</label>
                            <select asp-for="Editor.Input.PrimaryCategoryId" class="posts-select" data-primary-category-select>
                                <option value="">Tự động dùng chuyên mục đầu tiên đã chọn</option>
                                @foreach (var category in Model.Editor.CategoryOptions)
                                {
                                    <option value="@category.Id">@category.Label (@category.MetaValue)</option>
                                }
                            </select>
                            <span asp-validation-for="Editor.Input.PrimaryCategoryId" class="field-validation-error"></span>
                        </div>
                        <div class="posts-checkbox-grid">
                            @foreach (var category in Model.Editor.CategoryOptions)
                            {
                                <label class="posts-checkbox-card">
                                    <input type="checkbox" name="Editor.Input.SelectedCategoryIds" value="@category.Id" checked="@(category.Selected ? "checked" : null)" />
                                    <span>
                                        <strong>@category.Label</strong>
                                        <small>@category.Description</small>
                                        <small>@category.MetaValue</small>
                                    </span>
                                </label>
                            }
                        </div>
                        @Html.ValidationMessage("Editor.Input.SelectedCategoryIds", null, new { @class = "field-validation-error" })
                    </div>

                    <div class="posts-editor-card" id="editor-products">
                        <div class="posts-related-products-head posts-related-products-head--compact">
                            <div class="posts-related-products-label">
                                <h4>Sản phẩm liên quan</h4>
                                <span class="posts-editor-hint posts-related-products-description" data-related-products-description>Chưa chọn sản phẩm</span>
                            </div>
                            <button type="button"
                                    class="btn-primary-posts posts-related-products-trigger"
                                    data-related-products-open
                                    aria-haspopup="dialog"
                                    aria-expanded="false"
                                    aria-controls="editor-products-modal">
                                + Thêm sản phẩm liên quan
                            </button>
                        </div>

                        <div class="posts-related-products-summary" data-related-products-summary>
                            <strong class="posts-related-products-count" data-related-products-count hidden>0 sản phẩm đã chọn</strong>
                            <div class="posts-related-products-summary__chips" data-related-products-chips>
                                <span class="posts-related-products-chip posts-related-products-chip--empty">Chưa chọn sản phẩm</span>
                            </div>
                        </div>

                        @Html.ValidationMessage("Editor.Input.SelectedProductIds", null, new { @class = "field-validation-error" })

                    </div>

                    <div class="posts-editor-card posts-editor-card--span-2" id="editor-media">
                        <h4>Thư viện ảnh</h4>
                        <textarea asp-for="Editor.Input.GalleryInput" class="posts-textarea posts-textarea--md posts-gallery-legacy-input" hidden data-gallery-input></textarea>
                        <span asp-validation-for="Editor.Input.GalleryInput" class="field-validation-error"></span>
                        @Html.ValidationMessage("GalleryFiles", null, new { @class = "field-validation-error" })

                        <div class="posts-gallery-builder" data-gallery-builder>
                            <div class="posts-gallery-toolbar">
                                <strong>Xem trước thư viện ảnh</strong>
                                <span data-gallery-toolbar-note>Chưa tải lên file. Bạn có thể dùng URL ảnh đại diện và GalleryInput thủ công ở phần dự phòng bên trên.</span>
                            </div>
                            <div class="posts-gallery-canvas" data-gallery-list>
                                @if (Model.Editor.GalleryItems.Count == 0)
                                {
                                    <div class="posts-gallery-empty">
                                        <strong>Chưa có ảnh thư viện</strong>
                                        <span>Chọn nhiều ảnh để tạo thư viện tự động, hoặc nhập dữ liệu thủ công nếu bạn không tải file lên.</span>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var item in Model.Editor.GalleryItems)
                                    {
                                        <article class="posts-gallery-card">
                                            <div class="posts-gallery-card__preview">
                                                <span class="posts-gallery-card__order">@item.OrderIndex.ToString("00")</span>
                                                <img src="@item.ImageUrl" alt="Ảnh gallery @item.OrderIndex" class="posts-gallery-card__image" />
                                            </div>
                                            <div class="posts-gallery-card__body">
                                                <div class="posts-gallery-card__meta">
                                                    <strong>@item.ImageUrl</strong>
                                                    <span class="posts-gallery-card__badge">Đang có sẵn</span>
                                                    <span>@(string.IsNullOrWhiteSpace(item.Caption) ? "Chưa có caption" : item.Caption)</span>
                                                </div>
                                            </div>
                                        </article>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="posts-editor-actions">
                    <button type="submit" class="btn-primary-posts">@Model.Editor.SubmitLabel</button>
                    @if (Model.Editor.IsEditing)
                    {
                        <a href="@($"{Model.Editor.CancelUrl}#posts-panel")" class="btn-ghost-posts">Huỷ chỉnh sửa</a>
                    }
                    else
                    {
                        <a href="@postsListUrl" class="btn-ghost-posts">Quay lại danh sách</a>
                    }
                </div>
            </form>

            <div class="posts-modal" id="editor-products-modal" data-related-products-modal hidden aria-hidden="true" tabindex="-1">
                <div class="posts-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="editor-products-modal-title">
                    <div class="posts-modal__header">
                        <div class="posts-modal__header-copy">
                            <span class="posts-modal__eyebrow">Liên kết sản phẩm</span>
                            <h5 id="editor-products-modal-title">Chọn sản phẩm liên quan</h5>
                            <p>Chọn nhanh các sản phẩm cần điều hướng từ bài viết sang trang bán hàng. Bạn có thể nhấp trực tiếp vào toàn bộ card để chọn hoặc bỏ chọn.</p>
                        </div>
                        <div class="posts-modal__header-actions">
                            <span class="posts-modal__selection-badge" data-related-products-modal-count>Chưa chọn sản phẩm</span>
                            <button type="button" class="btn-ghost-posts" data-related-products-close>Đóng</button>
                        </div>
                    </div>
                    <div class="posts-modal__body">
                        <div class="posts-modal__toolbar">
                            <strong>Danh sách sản phẩm</strong>
                            <span>Nhấp vào card để chọn nhanh. Hệ thống vẫn giữ nguyên binding dữ liệu hiện tại khi lưu bài viết.</span>
                        </div>
                        <div class="posts-checkbox-grid posts-checkbox-grid--products">
                            @foreach (var product in Model.Editor.ProductOptions)
                            {
                                var hasProductMeta = !string.IsNullOrWhiteSpace(product.Description);
                                <label class="posts-checkbox-card posts-checkbox-card--product @(product.Selected ? "is-selected" : null)">
                                    <input type="checkbox"
                                           name="Editor.Input.SelectedProductIds"
                                           value="@product.Id"
                                           form="posts-editor-form"
                                           checked="@(product.Selected ? "checked" : null)"
                                           data-related-product-checkbox
                                           data-product-label="@product.Label" />
                                    <span class="posts-checkbox-card__content">
                                        <strong>@product.Label</strong>
                                        <small class="posts-checkbox-card__meta-label">@(hasProductMeta ? "Giá / thông tin" : "Trạng thái")</small>
                                        <small class="posts-checkbox-card__meta-value">@(hasProductMeta ? product.Description : "Chưa có thông tin bổ sung")</small>
                                    </span>
                                    <span class="posts-checkbox-card__state" data-related-product-state>@(product.Selected ? "Đã chọn" : "Nhấn để chọn")</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="posts-modal__footer">
                        <span class="posts-editor-hint">Có thể chọn nhiều sản phẩm cùng lúc, sau đó bấm <strong>Xong</strong> để quay lại form.</span>
                        <div class="posts-modal__actions">
                            <button type="button" class="btn-ghost-posts" data-related-products-close>Huỷ</button>
                            <button type="button" class="btn-primary-posts" data-related-products-apply>Xong</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </section>

    <section class="posts-section-panel @(initialSection == "categories" ? "is-active" : null)" id="categories-panel" data-section-panel="categories">
        <div class="posts-dashboard-grid">
            <div class="posts-dashboard-main">
                <section class="panel posts-panel" id="taxonomy-panel">
                    <div class="panel__head posts-panel__head posts-panel__head--stacked">
                        <div>
                            <p class="eyebrow">Taxonomy</p>
                            <h3>Chuyên mục blog</h3>
                        </div>
                        <a href="#posts-panel" class="btn-ghost-posts js-posts-section-trigger" data-section-target="posts">Quay lại bài viết</a>
                    </div>

                    <section class="panel posts-panel posts-panel--side posts-category-create-panel">
                        <div class="panel__head posts-panel__head">
                            <div>
                                <p class="eyebrow">Tạo mới</p>
                              
                                <h3>Thêm chuyên mục</h3>
                            </div>
                        </div>

                        <form asp-action="SaveCategory" asp-controller="Admin" method="post" class="posts-category-form">
                            @Html.AntiForgeryToken()
                            <input asp-for="CategoryEditor.Input.SearchTerm" type="hidden" value="@Model.SearchTerm" />
                            <input asp-for="CategoryEditor.Input.ReturnStatus" type="hidden" value="@Model.SelectedStatus" />
                            <input asp-for="CategoryEditor.Input.ReturnCategoryId" type="hidden" value="@Model.SelectedCategoryId" />
                            <input asp-for="CategoryEditor.Input.ReturnPage" type="hidden" value="@Model.CurrentPage" />

                            <div class="posts-form-grid">
                                <div class="posts-field">
                                    <label asp-for="CategoryEditor.Input.Name">Tên chuyên mục</label>
                                    <input asp-for="CategoryEditor.Input.Name" class="posts-input" placeholder="Ví dụ: Thu mua nhà xưởng" />
                                    <span asp-validation-for="CategoryEditor.Input.Name" class="field-validation-error"></span>
                                </div>
                                <div class="posts-field">
                                    <label asp-for="CategoryEditor.Input.Slug">Đường dẫn tĩnh</label>
                                    <input asp-for="CategoryEditor.Input.Slug" class="posts-input" placeholder="de-trong-se-tu-sinh-tu-ten" />
                                    <span asp-validation-for="CategoryEditor.Input.Slug" class="field-validation-error"></span>
                                </div>
                                <div class="posts-field">
                                    <label asp-for="CategoryEditor.Input.Description">Mô tả</label>
                                    <textarea asp-for="CategoryEditor.Input.Description" class="posts-textarea posts-textarea--sm" placeholder="Mô tả ngắn giúp phân loại nội dung dễ hơn"></textarea>
                                </div>
                            </div>
                            <br/>
                            <div class="posts-editor-actions posts-editor-actions--compact mt-2">
                                <button type="submit" class="btn-primary-posts">@Model.CategoryEditor.SubmitLabel</button>
                          
                            </div>
                        </form>
                    </section>

                    <div class="posts-category-grid">
                        @foreach (var category in Model.Categories)
                        {
                            var categoryFilterUrl = string.IsNullOrWhiteSpace(category.FilterUrl)
                                ? postsListUrl
                                : $"{category.FilterUrl}#posts-panel";

                            <article class="posts-category-card posts-category-card--@category.Tone">
                                <div class="posts-category-card__head">
                                    <div>
                                        <h4>@category.Name</h4>
                                        <span>/@category.Slug</span>
                                    </div>
                                    <strong>@category.TotalPosts bài</strong>
                                </div>
                                <p>@category.Description</p>
                                <div class="posts-category-card__footer">
                                    <span>Taxonomy động</span>
                                    <a href="@categoryFilterUrl" class="btn-ghost-posts">Lọc bài</a>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            </div>

            <aside class="posts-dashboard-side">
                <section class="panel posts-panel posts-panel--side">
                    <div class="panel__head posts-panel__head">
                        <div>
                            <p class="eyebrow">Phạm vi</p>
                            <h3>Nhóm chức năng blog</h3>
                        </div>
                    </div>

                    <div class="posts-feature-list">
                        @foreach (var item in Model.FeatureItems)
                        {
                            <div class="posts-feature-list__item">
                                <strong>@item.Title</strong>
                                <span>@item.Description</span>
                            </div>
                        }
                    </div>
                </section>

                <section class="panel posts-panel posts-panel--side">
                    <div class="panel__head posts-panel__head">
                        <div>
                            <p class="eyebrow">Ghi chú phân loại</p>
                            <h3>Liên kết quản trị</h3>
                        </div>
                    </div>

                    <div class="posts-side-note posts-side-note--compact">
                        <p>Sử dụng nút lọc trên từng card để quay về danh sách bài viết với bộ lọc chuyên mục tương ứng, giúp điều hướng giữa taxonomy và content list nhanh hơn.</p>
                    </div>
                </section>
            </aside>
        </div>
    </section>
</div>

@section Styles {
    <style>
        .topbar--posts {
            grid-template-columns: minmax(0, 1fr);
            gap: 18px;
            margin-bottom: 18px;
        }

        .posts-hero {
            align-items: flex-start;
        }

        .posts-hero__content {
            width: 100%;
            display: grid;
            gap: 14px;
        }

        .posts-hero__headline {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            align-items: flex-start;
        }

        .posts-hero__chips {
            flex-wrap: wrap;
        }

        .posts-hero__actions,
        .posts-panel__actions,
        .posts-topbar__buttons,
        .posts-editor-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .posts-section-nav {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 18px;
        }

        .posts-section-nav__item {
            display: grid;
            gap: 6px;
            padding: 18px 20px;
            text-decoration: none;
            border-radius: 22px;
            border: 1px solid rgba(148, 163, 184, 0.18);
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.96));
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.05);
            color: #0f172a;
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, background 0.2s ease;
        }

        .posts-section-nav__item:hover {
            transform: translateY(-1px);
            border-color: rgba(37, 99, 235, 0.2);
        }

        .posts-section-nav__item strong {
            font-size: 1rem;
        }

        .posts-section-nav__item small,
        .posts-section-nav__eyebrow,
        .posts-panel__summary,
        .posts-side-note p,
        .posts-feature-list__item span,
        .posts-resource-board__card p,
        .posts-editor-hint,
        .posts-resource-note,
        .posts-empty-state {
            color: #64748b;
            line-height: 1.6;
        }

        .posts-section-nav__eyebrow {
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 700;
            font-size: 0.72rem;
        }

        .posts-section-nav__item.is-active {
            background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(79, 70, 229, 0.1));
            border-color: rgba(79, 70, 229, 0.22);
            box-shadow: 0 18px 38px rgba(37, 99, 235, 0.12);
        }

        .posts-section-panel {
            display: none;
        }

        .posts-section-panel.is-active {
            display: block;
        }

        .posts-dashboard-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.85fr);
            gap: 18px;
        }

        .posts-dashboard-main,
        .posts-dashboard-side {
            display: grid;
            gap: 18px;
        }

        .posts-dashboard-grid--overview {
            grid-template-columns: minmax(0, 1fr);
        }

        .posts-dashboard-main--overview {
            gap: 20px;
        }

        .posts-overview-split {
            display: grid;
            grid-template-columns: minmax(0, 1.7fr) minmax(280px, 0.9fr);
            gap: 18px;
            align-items: start;
        }

        .posts-panel--overview-hero {
            padding: 22px;
        }

        .posts-panel--overview-flow,
        .posts-panel--overview-note {
            height: 100%;
        }

        .posts-overview-note-list {
            display: grid;
            gap: 14px;
            margin-top: 18px;
        }

        .posts-overview-note-item {
            padding: 16px 18px;
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 18px;
            background: linear-gradient(180deg, rgba(248, 250, 252, 0.98), #ffffff);
            display: grid;
            gap: 8px;
        }

        .posts-overview-note-item strong {
            color: #0f172a;
            font-size: 0.96rem;
        }

        .posts-overview-note-item span {
            color: #64748b;
            line-height: 1.6;
        }

        .posts-toolbar {
            display: grid;
            grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(180px, 0.55fr)) auto;
            gap: 12px;
            align-items: center;
            margin-top: 18px;
        }

        .posts-search-box,
        .posts-select,
        .posts-input,
        .posts-textarea {
            width: 100%;
            border: 1px solid rgba(148, 163, 184, 0.24);
            border-radius: 16px;
            background: #fff;
            color: #0f172a;
        }

        .posts-select,
        .posts-input {
            min-height: 48px;
            padding: 0.8rem 1rem;
        }

        .posts-textarea {
            padding: 0.9rem 1rem;
            resize: vertical;
        }

        .posts-textarea--sm {
            min-height: 110px;
        }

        .posts-textarea--md {
            min-height: 150px;
        }

        .posts-textarea--lg {
            min-height: 260px;
        }

        .posts-textarea--editor {
            min-height: 560px;
            padding: 1.15rem 1.25rem;
            font-size: 1rem;
            line-height: 1.85;
            font-family: inherit;
            border-radius: 20px;
            background: linear-gradient(180deg, #ffffff, #f8fafc);
        }

        .posts-rich-editor-shell {
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 22px;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.98));
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.92);
            overflow: hidden;
        }

        .posts-rich-editor-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 14px 18px 12px;
            border-bottom: 1px solid rgba(226, 232, 240, 0.88);
            background: rgba(248, 250, 252, 0.94);
        }

        .posts-rich-editor-toolbar strong {
            color: #0f172a;
            font-size: 0.98rem;
        }

        .posts-rich-editor-toolbar span {
            color: #64748b;
            font-size: 0.86rem;
            font-weight: 600;
        }

        .posts-rich-editor-shell.is-ready [data-rich-editor-status] {
            color: #15803d;
        }

        .posts-rich-editor-shell.has-error [data-rich-editor-status] {
            color: #be123c;
        }

        .posts-editor-capabilities {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            padding: 12px 18px 0;
        }

        .posts-editor-capabilities span {
            display: inline-flex;
            align-items: center;
            min-height: 34px;
            padding: 0.45rem 0.8rem;
            border-radius: 999px;
            background: rgba(37, 99, 235, 0.08);
            color: #1d4ed8;
            font-size: 0.83rem;
            font-weight: 700;
        }

        .posts-rich-editor-shell .posts-textarea--editor {
            min-height: 320px;
            border: 0;
            border-radius: 0;
            background: transparent;
        }

