<script src="https://cdn.jsdelivr.net/npm/tinymce@7/tinymce.min.js" referrerpolicy="origin"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var shell = document.querySelector('[data-posts-sections]');
        if (!shell) {
            return;
        }

        var navItems = Array.prototype.slice.call(document.querySelectorAll('[data-posts-nav] .js-posts-section-trigger'));
        var panels = Array.prototype.slice.call(shell.querySelectorAll('[data-section-panel]'));
        var allowedSections = ['posts', 'overview', 'editor', 'categories'];
        var coverFileInput = document.querySelector('[data-media-file-input]');
        var coverUrlInput = document.querySelector('[data-cover-url-input]');
        var coverPreview = document.querySelector('[data-cover-preview]');
        var coverPreviewImage = document.querySelector('[data-cover-preview-image]');
        var coverPreviewLabel = document.querySelector('[data-cover-preview-label]');
        var coverFilesList = document.querySelector('[data-cover-files-list]');
        var clearUploadButton = document.querySelector('[data-clear-upload]');
        var manualMediaPanel = document.querySelector('[data-manual-media-panel]');
        var manualGalleryInput = document.querySelector('[data-manual-gallery-input]');
        var galleryInput = document.querySelector('[data-gallery-input]');
        var galleryList = document.querySelector('[data-gallery-list]');
        var galleryToolbarNote = document.querySelector('[data-gallery-toolbar-note]');
        var mediaDropzone = document.querySelector('[data-media-dropzone]');
        var contentTextarea = document.querySelector('[data-rich-editor]');
        var richEditorShell = document.querySelector('[data-rich-editor-shell]');
        var contentEditorStatus = document.querySelector('[data-rich-editor-status]');
        var editorForm = shell.querySelector('.posts-editor-form');
        var categoryCheckboxes = Array.prototype.slice.call(document.querySelectorAll('input[name="Editor.Input.SelectedCategoryIds"]'));
        var primaryCategorySelect = document.querySelector('[data-primary-category-select]');
        var titleInput = editorForm ? editorForm.querySelector('[data-title-input]') : null;
        var slugInput = editorForm ? editorForm.querySelector('[data-slug-input]') : null;
        var relatedProductsModal = document.querySelector('[data-related-products-modal]');
        var relatedProductsDialog = relatedProductsModal ? relatedProductsModal.querySelector('.posts-modal__dialog') : null;
        var relatedProductsOpenButton = document.querySelector('[data-related-products-open]');
        var relatedProductsCloseButtons = Array.prototype.slice.call(document.querySelectorAll('[data-related-products-close]'));
        var relatedProductsApplyButton = document.querySelector('[data-related-products-apply]');
        var relatedProductCheckboxes = Array.prototype.slice.call(document.querySelectorAll('[data-related-product-checkbox]'));
        var relatedProductsCount = document.querySelector('[data-related-products-count]');
        var relatedProductsModalCount = document.querySelector('[data-related-products-modal-count]');
        var relatedProductsDescription = document.querySelector('[data-related-products-description]');
        var relatedProductsChips = document.querySelector('[data-related-products-chips]');
        var uploadEntries = [];
        var persistedGalleryItems = [];
        var itemSeed = 0;
        var hasManualSlugOverride = false;

        function normalizeSectionName(value) {
            if (!value) {
                return null;
            }

            var normalized = value.replace('#', '').replace('-panel', '').trim().toLowerCase();
            return allowedSections.indexOf(normalized) >= 0 ? normalized : null;
        }

        function activateSection(name, shouldUpdateHash) {
            var target = normalizeSectionName(name) || 'posts';

            panels.forEach(function (panel) {
                var isActive = panel.getAttribute('data-section-panel') === target;
                panel.classList.toggle('is-active', isActive);
                panel.hidden = !isActive;
            });

            navItems.forEach(function (item) {
                var isActive = item.getAttribute('data-section-target') === target;
                item.classList.toggle('is-active', isActive);
                item.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });

            if (shouldUpdateHash) {
                var newHash = '#' + target + '-panel';
                if (window.location.hash !== newHash) {
                    history.replaceState(null, '', newHash);
                }
            }
        }

        function createItemId(prefix) {
            itemSeed += 1;
            return prefix + '-' + itemSeed;
        }

        function showContentEditorStatus(message, tone) {
            if (!contentEditorStatus || !richEditorShell) {
                return;
            }

            contentEditorStatus.textContent = message;
            richEditorShell.classList.remove('is-loading', 'is-ready', 'has-error');

            if (tone === 'ready') {
                richEditorShell.classList.add('is-ready');
            }
            else if (tone === 'error') {
                richEditorShell.classList.add('has-error');
            }
        }

        function readFileAsDataUrl(file) {
            return new Promise(function (resolve, reject) {
                var reader = new FileReader();

                reader.onload = function () {
                    resolve(reader.result);
                };

                reader.onerror = function () {
                    reject(new Error('Không thể đọc file ảnh.'));
                };

                reader.readAsDataURL(file);
            });
        }

        function pickInlineImage(callback) {
            var picker = document.createElement('input');
            picker.type = 'file';
            picker.accept = 'image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp';

            picker.addEventListener('change', function () {
                var file = picker.files && picker.files[0] ? picker.files[0] : null;
                if (!file) {
                    return;
                }

                readFileAsDataUrl(file)
                    .then(function (dataUrl) {
                        callback(dataUrl, file);
                    })
                    .catch(function () {
                        showContentEditorStatus('Không thể chèn ảnh vừa chọn. Vui lòng thử lại.', 'error');
                    });
            });

            picker.click();
        }

        function initializeRichEditor() {
            if (!contentTextarea) {
                return;
            }

            if (typeof tinymce === 'undefined') {
                showContentEditorStatus('Không tải được trình soạn thảo trực quan. Hệ thống đang dùng ô nhập nội dung mặc định.', 'error');
                return;
            }

            tinymce.init({
                target: contentTextarea,
                promotion: false,
                branding: false,
                menubar: 'file edit view insert format tools table help',
                plugins: 'autolink autoresize charmap code fullscreen image link lists table wordcount',
                toolbar: 'undo redo | blocks | bold italic underline | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image | removeformat code fullscreen',
                toolbar_sticky: true,
                min_height: 560,
                autoresize_bottom_margin: 24,
                block_formats: 'Đoạn văn=p; Tiêu đề 1=h1; Tiêu đề 2=h2; Tiêu đề 3=h3',
                contextmenu: 'undo redo | bold italic | link image table',
                paste_data_images: true,
                automatic_uploads: true,
                image_title: true,
                image_caption: true,
                images_file_types: 'jpg,jpeg,png,webp',
                file_picker_types: 'image',
                file_picker_callback: function (callback, value, meta) {
                    if (!meta || meta.filetype !== 'image') {
                        return;
                    }

                    pickInlineImage(function (dataUrl, file) {
                        callback(dataUrl, { alt: file.name });
                        showContentEditorStatus('Ảnh đã được chèn trực tiếp vào nội dung bài viết.', 'ready');
                    });
                },
                images_upload_handler: function (blobInfo, progress) {
                    return new Promise(function (resolve, reject) {
                        if (typeof progress === 'function') {
                            progress(100);
                        }

                        readFileAsDataUrl(blobInfo.blob())
                            .then(function (dataUrl) {
                                showContentEditorStatus('Ảnh đã được nhúng trực tiếp vào nội dung bài viết.', 'ready');
                                resolve(dataUrl);
                            })
                            .catch(function () {
                                reject('Không thể xử lý ảnh để chèn vào nội dung.');
                            });
                    });
                },
                content_style: 'body { font-family: "Plus Jakarta Sans", Arial, sans-serif; font-size: 16px; line-height: 1.8; color: #1f2937; padding: 18px 22px; } img { max-width: 100%; height: auto; } figure { margin: 1.6rem 0; }',
                setup: function (editor) {
                    editor.on('init', function () {
                        showContentEditorStatus('Trình soạn thảo đã sẵn sàng. Bạn có thể viết bài như Word.', 'ready');
                    });

                    editor.on('change input undo redo SetContent', function () {
                        editor.save();
                    });

                    editor.on('drop paste', function () {
                        showContentEditorStatus('Bạn có thể dán hoặc kéo thả ảnh trực tiếp vào vùng nội dung.', 'ready');
                    });
                }
            });
        }

        function buildSlug(value) {
            return (value || '')
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd')
                .replace(/[^a-z0-9\s-]/g, ' ')
                .replace(/[\s_-]+/g, '-')
                .replace(/^-+|-+$/g, '');
        }

        function refreshSlugOverrideState() {
            if (!slugInput) {
                return;
            }

            var generatedFromTitle = buildSlug(titleInput ? titleInput.value : '');
            var normalizedSlug = buildSlug(slugInput.value);
            slugInput.value = normalizedSlug;
            hasManualSlugOverride = normalizedSlug.length > 0 && normalizedSlug !== generatedFromTitle;
        }

        function syncSlugFromTitle() {
            if (!titleInput || !slugInput || hasManualSlugOverride) {
                return;
            }

            slugInput.value = buildSlug(titleInput.value);
        }

        function syncPrimaryCategorySelect() {
            if (!primaryCategorySelect) {
                return;
            }

            var selectedCategoryValues = categoryCheckboxes
                .filter(function (checkbox) {
                    return checkbox.checked;
                })
                .map(function (checkbox) {
                    return checkbox.value;
                });

            Array.prototype.slice.call(primaryCategorySelect.options).forEach(function (option) {
                if (!option.value) {
                    option.disabled = false;
                    return;
                }

                option.disabled = selectedCategoryValues.indexOf(option.value) === -1;
            });

            if (!primaryCategorySelect.value || selectedCategoryValues.indexOf(primaryCategorySelect.value) === -1) {
                primaryCategorySelect.value = selectedCategoryValues.length > 0 ? selectedCategoryValues[0] : '';
            }
        }

        function syncRelatedProductCardStates() {
            relatedProductCheckboxes.forEach(function (checkbox) {
                var card = checkbox.closest('.posts-checkbox-card');
                if (!card) {
                    return;
                }

                var state = card.querySelector('[data-related-product-state]');
                card.classList.toggle('is-selected', checkbox.checked);

                if (state) {
                    state.textContent = checkbox.checked ? 'Đã chọn' : 'Nhấn để chọn';
                }
            });
        }

        function updateRelatedProductsSummary() {
            if (!relatedProductsCount || !relatedProductsDescription || !relatedProductsChips) {
                return;
            }

            var selectedProducts = relatedProductCheckboxes
                .filter(function (checkbox) {
                    return checkbox.checked;
                })
                .map(function (checkbox) {
                    return {
                        id: checkbox.value,
                        label: checkbox.getAttribute('data-product-label') || checkbox.value
                    };
                });

            if (relatedProductsModalCount) {
                relatedProductsModalCount.textContent = selectedProducts.length > 0
                    ? selectedProducts.length + ' sản phẩm đã chọn'
                    : 'Chưa chọn sản phẩm';
            }

            relatedProductsChips.innerHTML = '';

            if (selectedProducts.length === 0) {
                relatedProductsCount.hidden = true;
                relatedProductsCount.textContent = '0 sản phẩm đã chọn';
                relatedProductsDescription.textContent = 'Chưa chọn sản phẩm';

                var emptyChip = document.createElement('span');
                emptyChip.className = 'posts-related-products-chip posts-related-products-chip--empty';
                emptyChip.textContent = 'Chưa chọn sản phẩm';
                relatedProductsChips.appendChild(emptyChip);
                syncRelatedProductCardStates();
                return;
            }

            relatedProductsCount.hidden = false;
            relatedProductsCount.textContent = selectedProducts.length + ' sản phẩm đã chọn';
            relatedProductsDescription.textContent = 'Có thể bấm vào tag để bỏ nhanh sản phẩm hoặc mở danh sách để chọn thêm.';

            selectedProducts.forEach(function (product) {
                var chip = document.createElement('button');
                var label = document.createElement('span');
                var removeIcon = document.createElement('span');

                chip.type = 'button';
                chip.className = 'posts-related-products-chip';
                chip.setAttribute('data-related-products-remove', product.id);
                chip.setAttribute('aria-label', 'Bỏ sản phẩm ' + product.label);

                label.className = 'posts-related-products-chip__label';
                label.textContent = product.label;

                removeIcon.className = 'posts-related-products-chip__remove';
                removeIcon.setAttribute('aria-hidden', 'true');
                removeIcon.textContent = '×';

                chip.appendChild(label);
                chip.appendChild(removeIcon);
                relatedProductsChips.appendChild(chip);
            });

            syncRelatedProductCardStates();
        }

        function toggleRelatedProductsModal(shouldOpen) {
            if (!relatedProductsModal) {
                return;
            }

            relatedProductsModal.hidden = !shouldOpen;
            relatedProductsModal.setAttribute('aria-hidden', shouldOpen ? 'false' : 'true');
            document.body.classList.toggle('posts-modal-open', shouldOpen);

            if (relatedProductsOpenButton) {
                relatedProductsOpenButton.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
            }

            if (shouldOpen) {
                var focusTarget = relatedProductCheckboxes.filter(function (checkbox) {
                    return checkbox.checked;
                })[0] || relatedProductCheckboxes[0] || relatedProductsDialog || relatedProductsModal;

                window.setTimeout(function () {
                    if (focusTarget && typeof focusTarget.focus === 'function') {
                        focusTarget.focus();
                    }
                }, 0);

                return;
            }

            if (relatedProductsOpenButton) {
                relatedProductsOpenButton.focus();
            }
        }

        function parseLegacyGalleryInput(rawValue) {
            return (rawValue || '')
                .split(/\r?\n/)
                .map(function (line) {
                    return line.trim();
                })
                .filter(function (line) {
                    return line.length > 0;
                })
                .map(function (line) {
                    var separatorIndex = line.indexOf('|');
                    var imageUrl = separatorIndex >= 0 ? line.slice(0, separatorIndex).trim() : line;
                    var caption = separatorIndex >= 0 ? line.slice(separatorIndex + 1).trim() : '';

                    if (!imageUrl) {
                        return null;
                    }

                    return {
                        id: createItemId('existing'),
                        kind: 'existing',
                        url: imageUrl,
                        caption: caption
                    };
                })
                .filter(function (item) {
                    return !!item;
                });
        }

        function serializeLegacyGalleryItems(items) {
            return items
                .map(function (item) {
                    var url = (item.url || '').trim();
                    var caption = (item.caption || '').trim();

                    if (!url) {
                        return '';
                    }

                    return caption ? url + ' | ' + caption : url;
                })
                .filter(function (line) {
                    return line.length > 0;
                })
                .join('\r\n');
        }

        function syncImageFiles() {
            if (!coverFileInput || typeof DataTransfer === 'undefined') {
                return;
            }

            var dataTransfer = new DataTransfer();
            uploadEntries.forEach(function (entry) {
                dataTransfer.items.add(entry.file);
            });

            coverFileInput.files = dataTransfer.files;
        }

        function syncGalleryInput() {
            if (!galleryInput) {
                return;
            }

            var uploadLines = uploadEntries.slice(1).map(function (entry, index) {
                var token = '__UPLOAD__' + (index + 1);
                var caption = (entry.caption || '').trim();
                return caption ? token + ' | ' + caption : token;
            });

            var persistedLines = serializeLegacyGalleryItems(persistedGalleryItems);
            var allLines = uploadLines.slice();

            if (persistedLines) {
                allLines.push(persistedLines);
            }

            galleryInput.value = allLines.filter(function (line) {
                return line && line.length > 0;
            }).join('\r\n');

            if (manualGalleryInput) {
                manualGalleryInput.value = serializeLegacyGalleryItems(persistedGalleryItems);
            }
        }

        function setManualModeState() {
            var hasUploads = uploadEntries.length > 0;

            if (manualMediaPanel) {
                manualMediaPanel.classList.toggle('is-hidden', hasUploads);
            }

            if (coverUrlInput) {
                coverUrlInput.disabled = hasUploads;
            }

            if (manualGalleryInput) {
                manualGalleryInput.disabled = hasUploads;
            }

            if (galleryToolbarNote) {
                galleryToolbarNote.textContent = hasUploads
                    ? 'Ảnh đầu tiên đang được dùng làm ảnh đại diện. Các ảnh còn lại đang nằm trong phần xem trước thư viện bên dưới.'
                    : 'Chưa có ảnh tải lên. Hãy chọn một hoặc nhiều ảnh để tạo thư viện tự động.';
            }

            if (clearUploadButton) {
                clearUploadButton.hidden = !hasUploads;
            }
        }

        function setCoverPreviewState(source, labelText) {
            if (!coverPreview || !coverPreviewImage || !coverPreviewLabel) {
                return;
            }

            var hasSource = !!source;
            coverPreview.classList.toggle('is-empty', !hasSource);
            coverPreviewImage.hidden = !hasSource;
            coverPreviewImage.src = hasSource ? source : '';
            coverPreviewLabel.textContent = labelText || (hasSource ? source : 'Chưa có ảnh được chọn');
        }

        function renderSelectedFiles() {
            if (!coverFilesList) {
                return;
            }

            coverFilesList.innerHTML = '';

            if (uploadEntries.length === 0) {
                coverFilesList.hidden = true;
                return;
            }

            uploadEntries.forEach(function (entry, index) {
                var item = document.createElement('div');
                item.className = 'posts-cover-files-list__item';

                var badge = document.createElement('span');
                badge.className = 'posts-cover-files-list__badge ' + (index === 0 ? 'is-cover' : 'is-gallery');
                badge.textContent = index === 0 ? 'Ảnh đại diện' : 'Thư viện ' + index;

                var content = document.createElement('div');
                content.className = 'posts-cover-files-list__content';

                var title = document.createElement('strong');
                title.textContent = entry.file.name;

                var meta = document.createElement('small');
                meta.textContent = Math.max(1, Math.round(entry.file.size / 1024)) + ' KB';

                content.appendChild(title);
                content.appendChild(meta);
                item.appendChild(badge);
                item.appendChild(content);
                coverFilesList.appendChild(item);
            });

            coverFilesList.hidden = false;
        }

        function updateCoverPreview() {
            if (uploadEntries.length > 0) {
                var coverEntry = uploadEntries[0];
                var label = uploadEntries.length === 1
                    ? coverEntry.file.name + ' · Ảnh đại diện'
                    : coverEntry.file.name + ' · Ảnh đại diện · +' + (uploadEntries.length - 1) + ' ảnh thư viện';

                setCoverPreviewState(coverEntry.previewUrl, label);
                return;
            }

            var url = coverUrlInput ? (coverUrlInput.value || '').trim() : '';
            setCoverPreviewState(url, url || 'Chưa có ảnh được chọn');
        }

        function createGalleryEmptyState() {
            var empty = document.createElement('div');
            empty.className = 'posts-gallery-empty';

            var title = document.createElement('strong');
            title.textContent = uploadEntries.length > 0
                ? 'Chưa có ảnh thư viện từ file upload'
                : 'Chưa có ảnh thư viện';

            var description = document.createElement('span');
            description.textContent = uploadEntries.length > 0
                ? 'Hiện chỉ có ảnh đại diện. Hãy chọn thêm ảnh để bổ sung thư viện tự động.'
                : 'Chọn nhiều ảnh để tạo thư viện tự động cho bài viết.';

            empty.appendChild(title);
            empty.appendChild(description);
            return empty;
        }

        function removeUploadEntry(entryId) {
            uploadEntries = uploadEntries.filter(function (entry) {
                if (entry.id === entryId) {
                    if (entry.previewUrl && entry.previewUrl.indexOf('blob:') === 0) {
                        URL.revokeObjectURL(entry.previewUrl);
                    }

                    return false;
                }

                return true;
            });

            syncImageFiles();
            setManualModeState();
            updateCoverPreview();
            renderSelectedFiles();
            renderGalleryItems();
        }

        function removePersistedGalleryItem(itemId) {
            persistedGalleryItems = persistedGalleryItems.filter(function (item) {
                return item.id !== itemId;
            });

            syncGalleryInput();
            renderGalleryItems();
        }

        function renderGalleryItems() {
            if (!galleryList) {
                return;
            }

            galleryList.innerHTML = '';

            var renderedItems = uploadEntries.slice(1).map(function (entry) {
                return {
                    id: entry.id,
                    kind: 'upload',
                    previewUrl: entry.previewUrl,
                    title: entry.file.name,
                    description: Math.max(1, Math.round(entry.file.size / 1024)) + ' KB',
                    caption: entry.caption || ''
                };
            }).concat(persistedGalleryItems.map(function (item) {
                return {
                    id: item.id,
                    kind: 'existing',
                    previewUrl: item.url,
                    title: item.url,
                    description: item.url,
                    caption: item.caption || ''
                };
            }));

            if (renderedItems.length === 0) {
                galleryList.appendChild(createGalleryEmptyState());
                syncGalleryInput();
                return;
            }

            renderedItems.forEach(function (item, index) {
                var article = document.createElement('article');
                article.className = 'posts-gallery-card';

                var preview = document.createElement('div');
                preview.className = 'posts-gallery-card__preview';

                var order = document.createElement('span');
                order.className = 'posts-gallery-card__order';
                order.textContent = String(index + 1).padStart(2, '0');

                var image = document.createElement('img');
                image.className = 'posts-gallery-card__image';
                image.alt = 'Xem trước thư viện ảnh ' + (index + 1);
                image.src = item.previewUrl || '';

                preview.appendChild(order);
                preview.appendChild(image);

                var body = document.createElement('div');
                body.className = 'posts-gallery-card__body';

                var meta = document.createElement('div');
                meta.className = 'posts-gallery-card__meta';

                var title = document.createElement('strong');
                title.textContent = item.title;

                var badge = document.createElement('span');
                badge.className = 'posts-gallery-card__badge';
                badge.textContent = item.kind === 'upload' ? 'Tự lưu từ upload chính' : 'Nguồn thủ công / đã có sẵn';

                var description = document.createElement('span');
                description.textContent = item.description;

                meta.appendChild(title);
                meta.appendChild(badge);
                meta.appendChild(description);

                var field = document.createElement('label');
                field.className = 'posts-gallery-card__field';

                var fieldLabel = document.createElement('span');
                fieldLabel.textContent = 'Caption ảnh';

                var captionInput = document.createElement('input');
                captionInput.type = 'text';
                captionInput.className = 'posts-input';
                captionInput.value = item.caption;
                captionInput.placeholder = 'Nhập caption cho ảnh này';
                captionInput.addEventListener('input', function () {
                    if (item.kind === 'upload') {
                        uploadEntries.forEach(function (entry) {
                            if (entry.id === item.id) {
                                entry.caption = captionInput.value || '';
                            }
                        });
                    }
                    else {
                        persistedGalleryItems.forEach(function (existingItem) {
                            if (existingItem.id === item.id) {
                                existingItem.caption = captionInput.value || '';
                            }
                        });
                    }

                    syncGalleryInput();
                });

                field.appendChild(fieldLabel);
                field.appendChild(captionInput);

                var removeButton = document.createElement('button');
                removeButton.type = 'button';
                removeButton.className = 'btn-ghost-posts posts-gallery-card__remove';
                removeButton.textContent = 'Xoá ảnh';
                removeButton.addEventListener('click', function () {
                    if (item.kind === 'upload') {
                        removeUploadEntry(item.id);
                        return;
                    }

                    removePersistedGalleryItem(item.id);
                });

                body.appendChild(meta);
                body.appendChild(field);
                body.appendChild(removeButton);

                article.appendChild(preview);
                article.appendChild(body);
                galleryList.appendChild(article);
            });

            syncGalleryInput();
        }

        function appendUploadFiles(fileList) {
            var files = Array.prototype.slice.call(fileList || []).filter(function (file) {
                return !!file;
            });

            if (files.length === 0) {
                return;
            }

            files.forEach(function (file) {
                uploadEntries.push({
                    id: createItemId('upload'),
                    file: file,
                    previewUrl: URL.createObjectURL(file),
                    caption: ''
                });
            });

            syncImageFiles();
            setManualModeState();
            updateCoverPreview();
            renderSelectedFiles();
            renderGalleryItems();
        }

        function clearSelectedUploads() {
            uploadEntries.forEach(function (entry) {
                if (entry.previewUrl && entry.previewUrl.indexOf('blob:') === 0) {
                    URL.revokeObjectURL(entry.previewUrl);
                }
            });

            uploadEntries = [];
            syncImageFiles();
            setManualModeState();
            updateCoverPreview();
            renderSelectedFiles();
            renderGalleryItems();
        }

        document.querySelectorAll('.js-posts-section-trigger[data-section-target]').forEach(function (trigger) {
            var href = trigger.getAttribute('href') || '';
            var isInPageLink = href === '' || href.charAt(0) === '#';

            if (!isInPageLink) {
                return;
            }

            trigger.addEventListener('click', function (event) {
                event.preventDefault();
                activateSection(trigger.getAttribute('data-section-target'), true);
            });
        });

        if (titleInput && slugInput) {
            ['input', 'change'].forEach(function (eventName) {
                titleInput.addEventListener(eventName, function () {
                    if (!hasManualSlugOverride || !slugInput.value.trim()) {
                        syncSlugFromTitle();
                    }
                });
            });

            ['input', 'change', 'blur'].forEach(function (eventName) {
                slugInput.addEventListener(eventName, function () {
                    refreshSlugOverrideState();

                    if (!hasManualSlugOverride) {
                        syncSlugFromTitle();
                    }
                });
            });
        }

        if (coverFileInput) {
            coverFileInput.addEventListener('change', function () {
                appendUploadFiles(coverFileInput.files);
            });
        }

        if (coverUrlInput) {
            ['input', 'change'].forEach(function (eventName) {
                coverUrlInput.addEventListener(eventName, function () {
                    if (uploadEntries.length === 0) {
                        updateCoverPreview();
                    }
                });
            });
        }

        if (manualGalleryInput) {
            ['input', 'change'].forEach(function (eventName) {
                manualGalleryInput.addEventListener(eventName, function () {
                    if (uploadEntries.length > 0) {
                        return;
                    }

                    persistedGalleryItems = parseLegacyGalleryInput(manualGalleryInput.value);
                    renderGalleryItems();
                });
            });
        }

        if (clearUploadButton) {
            clearUploadButton.addEventListener('click', clearSelectedUploads);
        }

        categoryCheckboxes.forEach(function (checkbox) {
            checkbox.addEventListener('change', syncPrimaryCategorySelect);
        });

        relatedProductCheckboxes.forEach(function (checkbox) {
            checkbox.addEventListener('change', updateRelatedProductsSummary);
        });

        if (relatedProductsChips) {
            relatedProductsChips.addEventListener('click', function (event) {
                var trigger = event.target;

                while (trigger && trigger !== relatedProductsChips && !trigger.getAttribute('data-related-products-remove')) {
                    trigger = trigger.parentElement;
                }

                if (!trigger || trigger === relatedProductsChips) {
                    return;
                }

                relatedProductCheckboxes.forEach(function (checkbox) {
                    if (checkbox.value === trigger.getAttribute('data-related-products-remove')) {
                        checkbox.checked = false;
                    }
                });

                updateRelatedProductsSummary();
            });
        }

        if (relatedProductsOpenButton) {
            relatedProductsOpenButton.addEventListener('click', function () {
                toggleRelatedProductsModal(true);
            });
        }

        relatedProductsCloseButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                toggleRelatedProductsModal(false);
            });
        });

        if (relatedProductsModal) {
            relatedProductsModal.addEventListener('click', function (event) {
                if (event.target === relatedProductsModal) {
                    toggleRelatedProductsModal(false);
                }
            });
        }

        if (relatedProductsDialog) {
            relatedProductsDialog.addEventListener('click', function (event) {
                event.stopPropagation();
            });
        }

        if (relatedProductsApplyButton) {
            relatedProductsApplyButton.addEventListener('click', function () {
                toggleRelatedProductsModal(false);
            });
        }

        document.addEventListener('keydown', function (event) {
            if (event.key !== 'Escape' || !relatedProductsModal || relatedProductsModal.hidden) {
                return;
            }

            event.preventDefault();
            toggleRelatedProductsModal(false);
        });

        if (mediaDropzone && coverFileInput) {
            ['dragenter', 'dragover'].forEach(function (eventName) {
                mediaDropzone.addEventListener(eventName, function (event) {
                    event.preventDefault();
                    mediaDropzone.classList.add('is-dragover');
                });
            });

            ['dragleave', 'dragend', 'drop'].forEach(function (eventName) {
                mediaDropzone.addEventListener(eventName, function (event) {
                    event.preventDefault();
                    mediaDropzone.classList.remove('is-dragover');
                });
            });

            mediaDropzone.addEventListener('drop', function (event) {
                var droppedFiles = event.dataTransfer ? event.dataTransfer.files : null;
                appendUploadFiles(droppedFiles);
            });

            mediaDropzone.addEventListener('click', function (event) {
                if (event.target === coverFileInput) {
                    return;
                }

                coverFileInput.click();
            });

            mediaDropzone.addEventListener('keydown', function (event) {
                if (event.key !== 'Enter' && event.key !== ' ') {
                    return;
                }

                event.preventDefault();
                coverFileInput.click();
            });
        }

        if (editorForm) {
            editorForm.addEventListener('submit', function () {
                if (typeof tinymce !== 'undefined') {
                    tinymce.triggerSave();
                }

                syncImageFiles();
                syncGalleryInput();
            });
        }

        persistedGalleryItems = parseLegacyGalleryInput(manualGalleryInput ? manualGalleryInput.value : (galleryInput ? galleryInput.value : ''));
        initializeRichEditor();
        refreshSlugOverrideState();
        syncSlugFromTitle();
        syncPrimaryCategorySelect();
        updateRelatedProductsSummary();

        var hashSection = normalizeSectionName(window.location.hash);
        var initialSection = normalizeSectionName(shell.getAttribute('data-initial-section')) || 'posts';
        activateSection(hashSection || initialSection, false);
        setManualModeState();
        updateCoverPreview();
        renderSelectedFiles();
        renderGalleryItems();

        window.addEventListener('hashchange', function () {
            var changedSection = normalizeSectionName(window.location.hash);
            if (changedSection) {
                activateSection(changedSection, false);
            }
        });

        window.addEventListener('beforeunload', function () {
            uploadEntries.forEach(function (entry) {
                if (entry.previewUrl && entry.previewUrl.indexOf('blob:') === 0) {
                    URL.revokeObjectURL(entry.previewUrl);
                }
            });
        });
    });
</script>
