@model WebThuMuaPheLieu.ViewModels.AdminPricesViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var selectedProduct = Model.CurrentPriceEditor;
    var hasSelectedProduct = selectedProduct.ProductId > 0;
}

<header class="topbar" id="price-overview-header" 
        style="position: relative; z-index: 0;">
    <div class="topbar__title-wrap">
        <button class="sidebar-toggle" type="button" aria-label="Mở menu">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <div>
            <p class="eyebrow">Admin / Prices</p>
            <h2>Quản lý bảng giá</h2>
            <div class="topbar__subtitle">
                <span>@Model.Products.Count sản phẩm</span>
                <span>@Model.PriceHistories.Count lịch sử giá</span>
            </div>
        </div>
    </div>
    <div class="topbar__actions admin-prices-top-actions"></div>
</header>

@if (TempData["AdminPricesSuccess"] is string successMessage)
{
    <div class="admin-feedback admin-feedback--success">@successMessage</div>
}

@if (TempData["AdminPricesError"] is string errorMessage)
{
    <div class="admin-feedback admin-feedback--error">@errorMessage</div>
}

<section class="admin-prices-layout">
    <div class="admin-prices-layout__current">
        <section class="panel admin-price-panel admin-price-panel--current-highlight">
            <div class="panel__head admin-price-panel__head">
                <div>
                    <p class="eyebrow">Giá hiện tại</p>
                    <h3>Thông tin đang áp dụng</h3>
                </div>
                <div class="panel__head-actions admin-history-actions">
                    @if (hasSelectedProduct)
                    {
                        <a class="admin-prices-action-button admin-prices-action-button--current"
                           asp-controller="Admin"
                           asp-action="Prices"
                           asp-route-productId="@selectedProduct.ProductId"
                           asp-route-editCurrent="true">
                            <span class="admin-prices-action-button__icon">↗</span>
                            <span>
                                <strong>Cập nhật giá</strong>
                                <small>Chỉnh nhanh giá hiện tại</small>
                            </span>
                        </a>
                    }
                </div>
            </div>

            @if (!hasSelectedProduct)
            {
                <div class="admin-empty-state">
                    <strong>Chưa chọn sản phẩm.</strong>
                    <span>Chọn một sản phẩm ở danh sách bên dưới để xem giá hiện tại.</span>
                </div>
            }
            else
            {
                <div class="admin-price-summary">
                    <div class="admin-price-summary__main">
                        <strong>@selectedProduct.ProductName</strong>
                        <span>@selectedProduct.CategoryName</span>
                    </div>
                    <div class="admin-price-summary__price">
                        <strong>@(selectedProduct.PriceValue?.ToString("N0") ?? "Chưa có giá")</strong>
                        <span>@(string.IsNullOrWhiteSpace(selectedProduct.Unit) ? "Chưa có đơn vị" : $"/{selectedProduct.Unit}")</span>
                    </div>
                    <dl class="admin-price-summary__meta">
                        <div>
                            <dt>Nhãn giá</dt>
                            <dd>@(string.IsNullOrWhiteSpace(selectedProduct.PriceLabel) ? "-" : selectedProduct.PriceLabel)</dd>
                        </div>
                        <div>
                            <dt>Trạng thái</dt>
                            <dd>@(string.IsNullOrWhiteSpace(selectedProduct.Status) ? "Không rõ" : selectedProduct.Status)</dd>
                        </div>
                        <div>
                            <dt>Cập nhật lần cuối</dt>
                            <dd>@(selectedProduct.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")</dd>
                        </div>
                    </dl>
                </div>
            }
        </section>

        <section class="panel admin-price-panel admin-price-panel--product-selector">
            <div class="panel__head admin-price-panel__head">
                <div>
                    <p class="eyebrow">Danh sách chọn nhanh</p>
                    <h3>Giá theo sản phẩm</h3>
                </div>
                <span class="admin-price-selector-count">@Model.Products.Count sản phẩm</span>
            </div>

            <div class="admin-price-product-list">
                @if (Model.Products.Count == 0)
                {
                    <div class="admin-empty-state">
                        <strong>Chưa có sản phẩm.</strong>
                        <span>Hãy thêm sản phẩm trước khi quản lý bảng giá.</span>
                    </div>
                }
                else
                {
                    @foreach (var product in Model.Products)
                    {
                        <a class="admin-price-product-card @(product.IsSelected ? "is-selected" : string.Empty)"
                           asp-controller="Admin"
                           asp-action="Prices"
                           asp-route-productId="@product.Id">
                            <div>
                                <strong>@product.Name</strong>
                                <span>@product.CategoryName</span>
                            </div>
                            <div class="admin-price-product-card__actions">
                                <div class="admin-price-product-card__value">
                                    <strong>@(product.PriceValue?.ToString("N0") ?? "Chưa có giá")</strong>
                                    <span>@(string.IsNullOrWhiteSpace(product.Unit) ? "" : $"/{product.Unit}")</span>
                                </div>
                                <span class="admin-price-product-card__cta">Chọn sản phẩm</span>
                            </div>
                        </a>
                    }
                }
            </div>
        </section>

        @if (Model.ShowCurrentPriceEditor)
        {
            <div class="admin-modal-backdrop" aria-hidden="true"></div>
            <section class="admin-modal-card admin-modal-card--compact admin-modal-card--current-price">
                <div class="admin-modal-card__hero admin-modal-card__hero--emerald">
                    <div>
                        <p class="eyebrow">Chỉnh sửa giá hiện tại</p>
                        <h4>Cập nhật giá cho @selectedProduct.ProductName</h4>
                        <span>Điều chỉnh giá đang áp dụng với bố cục rõ ràng và thao tác nhanh hơn.</span>
                    </div>
                    <a class="admin-modal-card__close"
                       asp-controller="Admin"
                       asp-action="Prices"
                       asp-route-productId="@selectedProduct.ProductId"
                       aria-label="Đóng popup cập nhật giá">
                        ×
                    </a>
                </div>

                <form asp-controller="Admin" asp-action="SaveCurrentPrice" method="post" class="admin-price-form admin-price-form--modal">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProductId" value="@selectedProduct.ProductId" />

                    <div class="admin-form-section admin-form-section--compact">
                        <div class="admin-form-grid admin-form-grid--single admin-form-grid--modal-current">
                            <label class="admin-form-field">
                                <span>Sản phẩm</span>
                                <input value="@selectedProduct.ProductName" type="text" readonly />
                            </label>
                            <label class="admin-form-field">
                                <span>Loại sản phẩm</span>
                                <input value="@selectedProduct.CategoryName" type="text" readonly />
                            </label>
                            <label class="admin-form-field">
                                <span>Giá hiện tại</span>
                                <input name="PriceValue" value="@selectedProduct.PriceValue" type="number" step="0.01" placeholder="Nhập giá hiện tại" />
                            </label>
                            <label class="admin-form-field">
                                <span>Đơn vị</span>
                                <input name="Unit" value="@selectedProduct.Unit" type="text" placeholder="kg, tấn..." />
                            </label>
                            <label class="admin-form-field">
                                <span>Nhãn giá</span>
                                <input name="PriceLabel" value="@selectedProduct.PriceLabel" type="text" placeholder="Ví dụ: Giá thu mua hôm nay" />
                            </label>
                            <label class="admin-form-field">
                                <span>Trạng thái</span>
                                <input value="@(string.IsNullOrWhiteSpace(selectedProduct.Status) ? "Không rõ" : selectedProduct.Status)" type="text" readonly />
                            </label>
                            <label class="admin-form-field">
                                <span>Cập nhật lần cuối</span>
                                <input value="@(selectedProduct.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")" type="text" readonly />
                            </label>
                        </div>
                    </div>

                    <div class="admin-form-actions admin-form-actions--split">
                        <a class="admin-modal-cancel-button"
                           asp-controller="Admin"
                           asp-action="Prices"
                           asp-route-productId="@selectedProduct.ProductId">
                            Hủy
                        </a>
                        <button class="admin-prices-submit-button admin-prices-submit-button--current" type="submit">
                            <span>Lưu giá hiện tại</span>
                            <small>Cập nhật ngay cho sản phẩm này</small>
                        </button>
                    </div>
                </form>
            </section>
        }
    </div>

    <section class="panel admin-price-panel admin-price-panel--history">
        <div class="panel__head admin-price-panel__head">
            <div>
                <p class="eyebrow">Lịch sử giá</p>
                <h3>Toàn bộ thuộc tính của PriceHistory</h3>
            </div>
            <div class="panel__head-actions admin-history-actions">
                @if (hasSelectedProduct)
                {
                    <a class="admin-prices-action-button admin-prices-action-button--history"
                       asp-controller="Admin"
                       asp-action="Prices"
                       asp-route-productId="@selectedProduct.ProductId"
                       asp-route-createHistory="true">
                        <span class="admin-prices-action-button__icon">＋</span>
                        <span>
                            <strong>Thêm lịch sử</strong>
                            <span>Lưu mốc giá cho @selectedProduct.ProductName</span>
                        </span>
                    </a>
                }
            </div>
        </div>

        <div class="admin-history-grid">
            <div class="table-shell admin-history-table-shell">
                <table class="product-table admin-history-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Sản phẩm</th>
                            <th>Giá</th>
                            <th>Đơn vị</th>
                            <th>Loại giá</th>
                            <th>Ghi chú</th>
                            <th>Hiệu lực</th>
                            <th>Ghi nhận</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PriceHistories.Count == 0)
                        {
                            <tr>
                                <td colspan="9">
                                    <div class="admin-empty-state admin-empty-state--table">
                                        <strong>Chưa có bản ghi lịch sử giá.</strong>
                                        <span>@(hasSelectedProduct ? "Sản phẩm này chưa có lịch sử giá nào." : "Chọn sản phẩm để xem hoặc thêm lịch sử giá.")</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var history in Model.PriceHistories)
                            {
                                <tr class="@(history.IsSelected ? "is-selected" : string.Empty)">
                                    <td>#@history.Id</td>
                                    <td>@history.ProductName</td>
                                    <td>@(history.PriceValue?.ToString("N0") ?? "-")</td>
                                    <td>@(history.PriceUnit ?? "-")</td>
                                    <td>@(history.PriceType ?? "-")</td>
                                    <td>@(string.IsNullOrWhiteSpace(history.Note) ? "-" : history.Note)</td>
                                    <td>@(history.EffectiveDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td>@(history.RecordedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                    <td>
                                        <div class="table-actions table-actions--stack">
                                            <a class="table-action"
                                               asp-controller="Admin"
                                               asp-action="Prices"
                                               asp-route-productId="@(history.ProductId ?? selectedProduct.ProductId)"
                                               asp-route-historyId="@history.Id">
                                                Sửa
                                            </a>
                                            <form asp-controller="Admin"
                                                  asp-action="DeletePriceHistory"
                                                  asp-route-id="@history.Id"
                                                  asp-route-productId="@(history.ProductId ?? selectedProduct.ProductId)"
                                                  method="post"
                                                  onsubmit="return confirm('Xóa lịch sử giá này?');">
                                                @Html.AntiForgeryToken()
                                                <button class="table-action table-action--delete" type="submit">Xóa</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.ShowHistoryEditor)
            {
                <div class="admin-modal-backdrop" aria-hidden="true"></div>
                <section class="admin-modal-card admin-history-editor admin-modal-card--history">
                    <div class="admin-modal-card__hero admin-modal-card__hero--violet">
                        <div>
                            <p class="eyebrow">@(Model.IsHistoryCreateMode ? "Thêm mới" : "Chỉnh sửa")</p>
                            <h4>@(Model.IsHistoryCreateMode ? "Tạo bản ghi lịch sử giá" : $"Cập nhật lịch sử giá #{Model.HistoryEditor.Id}")</h4>
                            <span>Lưu lại mốc giá quan trọng với giao diện rõ ràng hơn và dễ thao tác hơn.</span>
                        </div>
                        <div class="admin-history-editor-actions">
                            @if (!Model.IsHistoryCreateMode && Model.HistoryEditor.ProductId > 0)
                            {
                                <a class="admin-toolbar-button admin-toolbar-button--ghost"
                                   asp-controller="Admin"
                                   asp-action="Prices"
                                   asp-route-productId="@Model.HistoryEditor.ProductId"
                                   asp-route-createHistory="true">
                                    Tạo mới
                                </a>
                            }
                            @if (Model.HistoryEditor.ProductId > 0)
                            {
                                <a class="admin-modal-card__close"
                                   asp-controller="Admin"
                                   asp-action="Prices"
                                   asp-route-productId="@Model.HistoryEditor.ProductId"
                                   aria-label="Đóng popup lịch sử giá">
                                    ×
                                </a>
                            }
                        </div>
                    </div>

                    <form asp-controller="Admin" asp-action="SavePriceHistory" method="post" class="admin-price-form admin-price-form--modal">
                        @Html.AntiForgeryToken()
                        <input asp-for="HistoryEditor.Id" type="hidden" />

                        <div class="admin-form-grid admin-form-grid--modal-history">
                            <label class="admin-form-field">
                                <span>Sản phẩm *</span>
                                <select asp-for="HistoryEditor.ProductId" asp-items="Model.ProductOptions"></select>
                            </label>
                            <label class="admin-form-field">
                                <span>Giá lịch sử *</span>
                                <input asp-for="HistoryEditor.PriceValue" type="number" step="0.01" placeholder="Nhập giá cần lưu" />
                            </label>
                            <label class="admin-form-field">
                                <span>Đơn vị</span>
                                <input asp-for="HistoryEditor.PriceUnit" type="text" placeholder="kg, tấn..." />
                            </label>
                            <label class="admin-form-field">
                                <span>Loại giá</span>
                                <input asp-for="HistoryEditor.PriceType" type="text" placeholder="initial, previous, market..." />
                            </label>
                            <label class="admin-form-field admin-form-field--full">
                                <span>Ghi chú</span>
                                <textarea asp-for="HistoryEditor.Note" rows="4" placeholder="Mô tả thêm cho lần cập nhật giá"></textarea>
                            </label>
                            <label class="admin-form-field">
                                <span>Ngày hiệu lực</span>
                                <input asp-for="HistoryEditor.EffectiveDate" type="date" />
                            </label>
                            <label class="admin-form-field">
                                <span>Ngày ghi nhận</span>
                                <input asp-for="HistoryEditor.RecordedAt" type="datetime-local" />
                            </label>
                        </div>

                        <div class="admin-form-actions admin-form-actions--split admin-form-actions--history">
                            <a class="admin-modal-cancel-button"
                               asp-controller="Admin"
                               asp-action="Prices"
                               asp-route-productId="@Model.HistoryEditor.ProductId">
                                Hủy
                            </a>
                            <button class="admin-prices-submit-button admin-prices-submit-button--history" type="submit">
                                <span>@(Model.IsHistoryCreateMode ? "Thêm lịch sử giá" : "Lưu chỉnh sửa")</span>
                                <small>@(Model.IsHistoryCreateMode ? "Lưu nhanh mốc giá mới cho sản phẩm đã chọn" : "Cập nhật lại bản ghi lịch sử đang chọn")</small>
                            </button>
                        </div>
                    </form>
                </section>
            }
        </div>
    </section>
</section>

<style>
    .admin-prices-action-button {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        border-radius: 18px;
        color: #fff;
        text-decoration: none;
        box-shadow: 0 16px 34px rgba(15, 23, 42, 0.16);
        transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
    }

    .admin-prices-action-button:hover {
        transform: translateY(-1px);
        filter: brightness(1.03);
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.2);
    }

    .admin-prices-action-button--current {
        background: linear-gradient(135deg, #0f766e 0%, #14b8a6 55%, #5eead4 100%);
    }

    .admin-prices-action-button--history {
        background: linear-gradient(135deg, #6d28d9 0%, #8b5cf6 55%, #c4b5fd 100%);
    }

    .admin-prices-action-button__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.18);
        font-size: 1rem;
        font-weight: 800;
    }

    .admin-prices-action-button strong,
    .admin-prices-action-button small {
        display: block;
        color: inherit;
    }

    .admin-prices-action-button small {
        opacity: 0.86;
        font-size: 0.75rem;
        margin-top: 2px;
    }
    .admin-prices-top-actions {
        margin-left: auto;
    }

    .admin-prices-layout {
        display: grid;
        grid-template-columns: minmax(360px, 0.95fr) minmax(0, 1.55fr);
        gap: 20px;
        align-items: start;
    }

    .admin-prices-layout__current {
        display: grid;
        gap: 20px;
        align-content: start;
        position: sticky;
        top: 20px;
    }

    .admin-price-panel {
        overflow: hidden;
    }

    .admin-price-panel__head {
        align-items: start;
        gap: 12px;
    }

    .admin-price-product-list {
        display: grid;
        gap: 12px;
        padding: 0 22px 22px;
        max-height: 420px;
        overflow: auto;
    }

    .admin-price-panel--current-highlight {
        border: 1px solid rgba(20, 184, 166, 0.16);
        box-shadow: 0 20px 48px rgba(20, 184, 166, 0.1);
    }

    .admin-price-panel--product-selector {
        border: 1px solid rgba(148, 163, 184, 0.14);
    }

    .admin-price-selector-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(99, 102, 241, 0.08);
        color: #4338ca;
        font-size: 0.82rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .admin-price-product-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 18px;
        border: 1px solid rgba(148, 163, 184, 0.24);
        background: rgba(255, 255, 255, 0.78);
        color: inherit;
        text-decoration: none;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .admin-price-product-card__actions {
        display: grid;
        gap: 8px;
        justify-items: end;
    }

    .admin-price-product-card__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(22, 101, 52, 0.1);
        color: #166534;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .admin-price-product-card:hover,
    .admin-price-product-card.is-selected {
        transform: translateY(-1px);
        border-color: rgba(22, 101, 52, 0.35);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
    }

    .admin-price-product-card strong,
    .admin-price-product-card span {
        display: block;
    }

    .admin-price-product-card span {
        color: #64748b;
        font-size: 0.88rem;
    }

    .admin-price-product-card__value {
        text-align: right;
    }

    .admin-price-form {
        padding: 0 22px 22px;
    }

    .admin-price-form--modal {
        display: grid;
        gap: 18px;
    }

    .admin-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .admin-form-grid--single {
        grid-template-columns: 1fr;
    }

    .admin-form-grid--modal-current,
    .admin-form-grid--modal-history {
        gap: 18px;
    }

    .admin-form-field {
        display: grid;
        gap: 8px;
    }

    .admin-form-field--full {
        grid-column: 1 / -1;
    }

    .admin-form-field > span {
        font-size: 0.9rem;
        font-weight: 700;
        color: #334155;
    }

    .admin-form-field input,
    .admin-form-field select,
    .admin-form-field textarea {
        width: 100%;
        padding: 14px 16px;
        border-radius: 18px;
        border: 1px solid rgba(203, 213, 225, 0.95);
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        color: #0f172a;
        font-size: 1rem;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
    }

    .admin-form-field input:focus,
    .admin-form-field select:focus,
    .admin-form-field textarea:focus {
        border-color: rgba(124, 58, 237, 0.45);
        box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
        background: #fff;
    }

    .admin-form-grid--modal-current .admin-form-field input:focus,
    .admin-form-grid--modal-current .admin-form-field select:focus,
    .admin-form-grid--modal-current .admin-form-field textarea:focus {
        border-color: rgba(20, 184, 166, 0.45);
        box-shadow: 0 0 0 4px rgba(45, 212, 191, 0.14);
    }

    .admin-form-field input[readonly] {
        background: linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
        color: #475569;
        font-weight: 600;
        border-style: dashed;
    }

    .admin-form-field textarea {
        min-height: 116px;
        resize: vertical;
    }

    .admin-form-section--compact {
        padding: 0;
        background: transparent;
        border: 0;
        box-shadow: none;
    }

    .admin-price-summary {
        display: grid;
        gap: 14px;
        padding: 0 22px 22px;
    }

    .admin-price-summary__main {
        display: grid;
        gap: 4px;
    }

    .admin-price-summary__main strong,
    .admin-price-summary__price strong {
        display: block;
        color: #0f172a;
    }

    .admin-price-summary__main span,
    .admin-price-summary__price span,
    .admin-price-summary__meta dt,
