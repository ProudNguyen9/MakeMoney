@model WebThuMuaPheLieu.ViewModels.AdminProductsViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var successMessage = TempData["AdminProductsSuccess"] as string;
    var errorMessage = TempData["AdminProductsError"] as string;
    var editor = Model.Editor;
    var routeProductId = !Model.IsCreateMode && editor.Id.HasValue ? editor.Id : null;
    var routeCategoryId = Model.IsCreateMode ? editor.CategoryId : null;
    var routeCategoryEditId = Model.CategoryEditor.Id;
    var routeCreate = Model.ShowEditor && Model.IsCreateMode;
    var searchTerm = Model.SearchTerm;
    var pageWindowStart = Math.Max(1, Model.CurrentPage - 2);
    var pageWindowEnd = Math.Min(Model.TotalPages, pageWindowStart + 4);
    pageWindowStart = Math.Max(1, pageWindowEnd - 4);
}

<header class="topbar" id="products-section">
    <div class="topbar__title-wrap">
        <button class="sidebar-toggle" type="button" aria-label="Mở menu">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <div>
            <p class="eyebrow">Admin / Products</p>
            <h2>Quản lý sản phẩm</h2>
            <div class="overview-hero__chips">
                <span>@Model.Products.Count sản phẩm</span>
                <span>@Model.Categories.Count loại sản phẩm</span>
                <span>@(Model.Products.Count(product => product.IsFeatured)) nổi bật</span>
             
            </div>
        </div>
    </div>
    <div class="topbar__actions admin-products-top-actions">
        <a class="admin-toolbar-button admin-toolbar-button--ghost"
           asp-controller="Admin"
           asp-action="Products"
           asp-route-search="@searchTerm"
           asp-route-manageCategories="true">
            <span class="admin-toolbar-button__icon">▦</span>
            <span>
                <strong>Quản lý loại</strong>
                <small>Thêm, sửa, xóa loại sản phẩm</small>
            </span>
        </a>
        <a class="admin-toolbar-button admin-toolbar-button--primary"
           asp-controller="Admin"
           asp-action="Products"
           asp-route-search="@searchTerm"
           asp-route-create="true">
            <span class="admin-toolbar-button__icon">＋</span>
            <span>
                <strong>Thêm sản phẩm</strong>
                <small>Mở popup tạo sản phẩm mới</small>
            </span>
        </a>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="admin-products-alert admin-products-alert--success">@successMessage</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="admin-products-alert admin-products-alert--error">@errorMessage</div>
}

<div class="admin-products-layout">
    <section class="panel panel--products admin-products-panel admin-products-list-panel">
        <div class="panel__head admin-products-panel__head">
            <div>
                <p class="eyebrow">Danh sách</p>
                <h3>Tất cả sản phẩm</h3>
            </div>
            <div class="admin-products-summary">
                <span class="admin-products-summary__item">Có ảnh: @Model.Products.Count(product => product.ImageCount > 0)</span>
                <span class="admin-products-summary__item">Ẩn: @Model.Products.Count(product => product.Status == "inactive")</span>
                <span class="admin-products-summary__item">Hiển thị @Model.StartItemIndex-@Model.EndItemIndex / @Model.TotalProducts</span>
            </div>
        </div>

        <form method="get" asp-controller="Admin" asp-action="Products" class="admin-filter-toolbar">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="id" value="@routeProductId" />
            <input type="hidden" name="categoryId" value="@routeCategoryId" />
            <input type="hidden" name="categoryEditId" value="@routeCategoryEditId" />
            <input type="hidden" name="manageCategories" value="@Model.ShowCategoryManager" />
            <input type="hidden" name="create" value="@routeCreate" />

            <label class="search-box admin-filter-toolbar__search" aria-label="Tìm sản phẩm">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="7"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text"
                       name="search"
                       value="@searchTerm"
                       placeholder="Tìm theo tên, slug, category, trạng thái, mô tả..." />
            </label>

            <div class="admin-filter-toolbar__buttons">
                <button type="submit" class="admin-filter-toolbar__submit">Lọc dữ liệu</button>
                <a asp-controller="Admin"
                   asp-action="Products"
                   asp-route-id="@routeProductId"
                   asp-route-categoryId="@routeCategoryId"
                   asp-route-categoryEditId="@routeCategoryEditId"
                   asp-route-manageCategories="@Model.ShowCategoryManager"
                   asp-route-create="@routeCreate"
                   class="admin-filter-toolbar__reset">Làm mới</a>
            </div>
        </form>

        <div class="table-shell">
            <table class="product-table admin-products-table">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá</th>
                        <th>Ảnh</th>
                        <th>Trạng thái</th>
                        <th>Cập nhật</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Products.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="admin-products-empty">
                                    <strong>Chưa có sản phẩm nào</strong>
                                    <span>Hãy bấm nút thêm sản phẩm ở phía trên để mở popup tạo sản phẩm đầu tiên.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in Model.Products)
                        {
                            var statusClass = product.Status switch
                            {
                                "active" => "status status--success",
                                "inactive" => "status status--warning",
                                _ => "status status--accent"
                            };

                            var statusText = product.Status switch
                            {
                                "active" => "Đang hiển thị",
                                "inactive" => "Tạm ẩn",
                                _ => "Nháp"
                            };

                            <tr class="@(editor.Id == product.Id ? "is-selected" : string.Empty)">
                                <td>
                                    <div class="product-info admin-product-item">
                                        <div class="admin-product-item__thumb">
                                            @if (!string.IsNullOrWhiteSpace(product.PrimaryImage))
                                            {
                                                <img src="@Url.Content(product.PrimaryImage)" alt="@product.Name" />
                                            }
                                            else
                                            {
                                                <span>IMG</span>
                                            }
                                        </div>
                                        <div>
                                            <strong>@product.Name</strong>
                                            <span>Slug: @product.Slug</span>
                                            @if (product.IsFeatured)
                                            {
                                                <span class="tag tag--copper">Nổi bật</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(product.CategoryName) ? "Chưa phân loại" : product.CategoryName)</td>
                                <td>
                                    <strong>@(product.PriceValue?.ToString("N0") ?? "Chưa có")</strong>
                                    <span>@(string.IsNullOrWhiteSpace(product.Unit) ? string.Empty : $"/{product.Unit}")</span>
                                    @if (!string.IsNullOrWhiteSpace(product.PriceLabel))
                                    {
                                        <div class="admin-products-price-label">@product.PriceLabel</div>
                                    }
                                </td>
                                <td>@product.ImageCount ảnh</td>
                                <td><span class="@statusClass">@statusText</span></td>
                                <td>@(product.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")</td>
                                <td>
                                    <div class="admin-products-actions">
                                        <a class="table-action table-action--edit"
                                           asp-controller="Admin"
                                           asp-action="Products"
                                           asp-route-id="@product.Id">Chi tiết / Sửa</a>
                                        <form asp-controller="Admin"
                                              asp-action="DeleteProduct"
                                              asp-route-id="@product.Id"
                                              method="post"
                                              onsubmit="return confirm('Xóa sản phẩm này?');">
                                            @Html.AntiForgeryToken()
                                            <button class="table-action table-action--delete" type="submit">Xóa</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="admin-products-pagination">
                <div class="admin-products-pagination__summary">
                    <span class="admin-products-pagination__eyebrow">Điều hướng danh sách</span>
                    <strong>Trang @Model.CurrentPage / @Model.TotalPages</strong>
                    <span>Đang hiển thị @Model.StartItemIndex-@Model.EndItemIndex trong tổng số @Model.TotalProducts sản phẩm</span>
                </div>
                <div class="admin-products-pagination__actions">
                    <a class="admin-products-pagination__button @(Model.HasPreviousPage ? string.Empty : "is-disabled")"
                       asp-controller="Admin"
                       asp-action="Products"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-id="@routeProductId"
                       asp-route-categoryId="@routeCategoryId"
                       asp-route-manageCategories="@Model.ShowCategoryManager"
                       asp-route-create="@routeCreate"
                       asp-route-search="@searchTerm"
                       asp-route-categoryEditId="@routeCategoryEditId"
                       aria-disabled="@(!Model.HasPreviousPage)">
                        <span class="admin-products-pagination__button-icon">←</span>
                        <span>Trước</span>
                    </a>

                    @for (var pageNumber = pageWindowStart; pageNumber <= pageWindowEnd; pageNumber++)
                    {
                        <a class="admin-products-pagination__button @(pageNumber == Model.CurrentPage ? "is-active" : string.Empty)"
                           asp-controller="Admin"
                           asp-action="Products"
                           asp-route-page="@pageNumber"
                           asp-route-id="@routeProductId"
                           asp-route-categoryId="@routeCategoryId"
                           asp-route-manageCategories="@Model.ShowCategoryManager"
                           asp-route-create="@routeCreate"
                           asp-route-search="@searchTerm"
                           asp-route-categoryEditId="@routeCategoryEditId">
                            @pageNumber
                        </a>
                    }

                    <a class="admin-products-pagination__button @(Model.HasNextPage ? string.Empty : "is-disabled")"
                       asp-controller="Admin"
                       asp-action="Products"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-id="@routeProductId"
                       asp-route-categoryId="@routeCategoryId"
                       asp-route-manageCategories="@Model.ShowCategoryManager"
                       asp-route-create="@routeCreate"
                       asp-route-search="@searchTerm"
                       asp-route-categoryEditId="@routeCategoryEditId"
                       aria-disabled="@(!Model.HasNextPage)">
                        <span>Sau</span>
                        <span class="admin-products-pagination__button-icon">→</span>
                    </a>
                </div>
            </div>
        }
    </section>

    @if (Model.ShowEditor)
    {
        <div class="admin-products-modal" id="admin-products-modal" role="dialog" aria-modal="true" aria-labelledby="admin-products-modal-title">
            <div class="admin-products-modal__backdrop">
                <a class="admin-products-modal__close-hit" asp-controller="Admin" asp-action="Products" aria-label="Đóng popup"></a>
            </div>
            <section class="panel panel--products admin-products-panel admin-products-editor-panel admin-products-modal__dialog">
                <div class="panel__head admin-products-panel__head admin-products-modal-hero admin-products-modal-hero--emerald">
                    <div>
                        <p class="eyebrow">Biểu mẫu quản lý</p>
                        <h3 id="admin-products-modal-title">@(Model.IsCreateMode ? "Thêm sản phẩm mới" : "Xem chi tiết / chỉnh sửa")</h3>
                        <span>Điền và cập nhật thông tin sản phẩm với bố cục nổi bật, dễ nhìn hơn.</span>
                    </div>
                    <div class="panel__head-actions">
                        <a class="admin-products-modal-button admin-products-modal-button--ghost-light" asp-controller="Admin" asp-action="Products">Đóng</a>
                    </div>
                </div>

                <form asp-controller="Admin"
                      asp-action="SaveProduct"
                      method="post"
                      enctype="multipart/form-data"
                      class="admin-products-form">
                    @Html.AntiForgeryToken()
                    <input asp-for="Editor.Id" type="hidden" />
                    <input asp-for="Editor.PrimaryImage" type="hidden" />

                    <div class="admin-form-section">
                        <div class="admin-form-section__head">
                            <h4>Thông tin cơ bản</h4>
                            <p>Nhập đầy đủ các thuộc tính chính của sản phẩm theo model hiện tại.</p>
                        </div>
                        <div class="admin-form-grid admin-form-grid--2">
                            <label class="admin-field">
                                <span>Tên sản phẩm *</span>
                                <input asp-for="Editor.Name" type="text" placeholder="Ví dụ: Đồng đỏ loại 1" />
                            </label>
                            <label class="admin-field">
                                <span>Slug</span>
                                <input asp-for="Editor.Slug" type="text" placeholder="Tự tạo nếu để trống" />
                            </label>
                            <label class="admin-field admin-field--full">
                                <span>Mô tả ngắn</span>
                                <textarea asp-for="Editor.ShortDescription" rows="3" placeholder="Tóm tắt ngắn gọn để hiển thị trong danh sách"></textarea>
                            </label>
                            <label class="admin-field admin-field--full">
                                <span>Mô tả chi tiết</span>
                                <textarea asp-for="Editor.Description" rows="5" placeholder="Thông tin chi tiết về sản phẩm"></textarea>
                            </label>
                        </div>
                    </div>

                    <div class="admin-form-section">
                        <div class="admin-form-section__head">
                            <h4>Giá & trạng thái</h4>
                            <p>Khi thay đổi giá trị giá, hệ thống sẽ tự lưu giá cũ vào lịch sử giá.</p>
                        </div>
                        <div class="admin-form-grid admin-form-grid--3">
                            <label class="admin-field">
                                <span>Giá trị giá (PriceValue)</span>
                                <input asp-for="Editor.PriceValue" type="number" step="0.01" min="0" placeholder="0" />
                            </label>
                            <label class="admin-field">
                                <span>Đơn vị</span>
                                <input asp-for="Editor.Unit" type="text" placeholder="kg, tấn, chiếc..." />
                            </label>
                            <label class="admin-field">
                                <span>Nhãn giá</span>
                                <input asp-for="Editor.PriceLabel" type="text" placeholder="Ví dụ: Giá thu mua hôm nay" />
                            </label>
                            <label class="admin-field">
                                <span>Trạng thái</span>
                                <select asp-for="Editor.Status" asp-items="Model.StatusOptions"></select>
                            </label>
                            <label class="admin-field admin-field--checkbox">
                                <span>Đánh dấu nổi bật</span>
                                <input asp-for="Editor.IsFeatured" type="checkbox" />
                            </label>
                        </div>
                    </div>

                    <div class="admin-form-section">
                        <div class="admin-form-section__head">
                            <h4>Loại sản phẩm / danh mục</h4>
                            <p>Chọn loại sản phẩm có sẵn cho sản phẩm này. Quản lý thêm, sửa, xóa loại ở nút riêng trên đầu trang.</p>
                        </div>
                        <div class="admin-form-grid admin-form-grid--2">
                            <label class="admin-field">
                                <span>Loại sản phẩm</span>
                                <select asp-for="Editor.CategoryId" asp-items="Model.CategoryOptions"></select>
                            </label>
                            <div class="admin-inline-card admin-inline-card--hint">
                                <h5>Quản lý loại riêng</h5>
                                <p>Muốn thêm loại mới hoặc chỉnh sửa danh mục hiện có, hãy mở mục <strong>Quản lý loại</strong> ở góc phải phía trên.</p>
                                <div class="admin-products-actions">
                                    <a class="admin-products-modal-button admin-products-modal-button--secondary"
                                       asp-controller="Admin"
                                       asp-action="Products"
                                       asp-route-manageCategories="true">Mở quản lý loại</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="admin-form-section">
                        <div class="admin-form-section__head">
                            <h4>Ảnh sản phẩm</h4>
                            <p>Kéo/thả nhiều ảnh hoặc bấm để chọn. Ảnh sẽ được lưu tự động vào thư mục <code>~/assets/images/products/</code>.</p>
                        </div>

                        <label class="admin-upload-dropzone" id="product-upload-dropzone">
                            <input asp-for="Editor.UploadedImages" id="product-upload-input" type="file" accept=".jpg,.jpeg,.png,.webp" multiple />
                            <span class="admin-upload-dropzone__title">Kéo & thả nhiều ảnh vào đây</span>
                            <span class="admin-upload-dropzone__hint">Hoặc bấm để chọn ảnh. Tên file sẽ tự đổi theo tên sản phẩm không dấu và số thứ tự 1, 2, 3...</span>
                        </label>

                        <div class="admin-upload-preview" id="product-upload-preview"></div>

                        @if (editor.ExistingImages.Count > 0)
                        {
                            <div class="admin-existing-images">
                                <h5>Ảnh hiện có</h5>
                                <div class="admin-existing-images__grid">
                                    @foreach (var image in editor.ExistingImages.OrderBy(image => image.OrderIndex))
                                    {
                                        <div class="admin-existing-image-card">
                                            <img src="@Url.Content(image.ImageUrl)" alt="@(image.Caption ?? editor.Name ?? "Product image")" />
                                            <div>
                                                <strong>@(image.IsPrimary ? "PrimaryImage" : $"ProductImage #{image.OrderIndex}")</strong>
                                                <span>@image.ImageUrl</span>

                                                @if (image.IsPrimary)
                                                {
                                                    <label class="admin-image-toggle">
                                                        <input asp-for="Editor.RemovePrimaryImage" type="checkbox" />
                                                        <span>Xóa ảnh chính hiện tại</span>
                                                    </label>
                                                }
                                                else if (image.Id.HasValue)
                                                {
                                                    <label class="admin-image-toggle">
                                                        <input type="checkbox" name="Editor.RemovedImageIds" value="@image.Id" />
                                                        <span>Xóa ảnh này</span>
                                                    </label>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="admin-form-actions admin-form-actions--product-editor">
                        @if (!Model.IsCreateMode)
                        {
                            <a class="admin-products-modal-button admin-products-modal-button--secondary" asp-controller="Admin" asp-action="Products" asp-route-id="@editor.Id">Tải lại chi tiết</a>
                        }
                        <button class="admin-products-modal-button admin-products-modal-button--primary" type="submit">
                            @(Model.IsCreateMode ? "Lưu sản phẩm mới" : "Cập nhật sản phẩm")
                        </button>
                    </div>
                </form>

                <div class="admin-products-side-grid">
                    <div class="admin-inline-card">
                        <h5>Lịch sử giá</h5>
                        @if (editor.PriceHistories.Count == 0)
                        {
                            <p class="admin-muted">Chưa có lịch sử giá cho sản phẩm này.</p>
                        }
                        else
                        {
                            <div class="admin-price-history">
                                @foreach (var history in editor.PriceHistories)
                                {
                                    <div class="admin-price-history__item">
                                        <strong>@(history.PriceValue?.ToString("N0") ?? "N/A") @(string.IsNullOrWhiteSpace(history.PriceUnit) ? string.Empty : $"/ {history.PriceUnit}")</strong>
                                        <span>Loại: @(history.PriceType ?? "N/A")</span>
                                        <span>Ngày hiệu lực: @(history.EffectiveDate?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                                        <span>Ghi chú: @(string.IsNullOrWhiteSpace(history.Note) ? "-" : history.Note)</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    }
@if (Model.ShowCategoryManager)
{
    <div class="admin-products-modal" id="admin-category-modal" role="dialog" aria-modal="true" aria-labelledby="admin-category-modal-title">
        <div class="admin-products-modal__backdrop">
            <a class="admin-products-modal__close-hit" asp-controller="Admin" asp-action="Products" aria-label="Đóng popup quản lý loại"></a>
        </div>
        <section class="panel panel--products admin-products-panel admin-products-modal__dialog admin-category-modal__dialog">
            <div class="panel__head admin-products-panel__head admin-products-modal-hero admin-products-modal-hero--violet">
                <div>
                    <p class="eyebrow">Quản lý loại sản phẩm</p>
                    <h3 id="admin-category-modal-title">@(Model.IsCategoryCreateMode ? "Thêm loại sản phẩm mới" : $"Chỉnh sửa loại: {Model.CategoryEditor.Name}")</h3>
                    <span>Tạo, cập nhật và sắp xếp nhóm sản phẩm trong một popup trực quan hơn.</span>
                </div>
                <div class="panel__head-actions">
                    <a class="admin-products-modal-button admin-products-modal-button--ghost-light" asp-controller="Admin" asp-action="Products">Đóng</a>
                </div>
            </div>

            <div class="admin-category-manager-grid">
                <section class="admin-form-section">
                    <div class="admin-form-section__head">
                        <h4>Biểu mẫu loại sản phẩm</h4>
                        <p>Tạo mới, cập nhật hoặc xóa loại sản phẩm riêng biệt mà không trộn vào form sản phẩm.</p>
                    </div>

                    <form asp-controller="Admin" asp-action="SaveCategory" method="post" class="admin-products-category-form">
                        @Html.AntiForgeryToken()
                        <input asp-for="CategoryEditor.Id" type="hidden" />

                        <label class="admin-field">
                            <span>Tên loại sản phẩm *</span>
                            <input asp-for="CategoryEditor.Name" type="text" placeholder="Ví dụ: Phế liệu nhôm" />
                        </label>

                        <label class="admin-field">
                            <span>Mô tả</span>
                            <textarea asp-for="CategoryEditor.Description" rows="4" placeholder="Mô tả ngắn gọn cho loại sản phẩm"></textarea>
                        </label>

                        <div class="admin-form-actions admin-form-actions--product-editor">
                            <a class="admin-products-modal-button admin-products-modal-button--secondary"
                               asp-controller="Admin"
                               asp-action="Products"
                               asp-route-manageCategories="true">Tạo form mới</a>
                            <button class="admin-products-modal-button admin-products-modal-button--primary" type="submit">
                                @(Model.IsCategoryCreateMode ? "Lưu loại sản phẩm" : "Cập nhật loại sản phẩm")
                            </button>
                        </div>
                    </form>

                    @if (!Model.IsCategoryCreateMode)
                    {
                        <form asp-controller="Admin"
                              asp-action="DeleteCategory"
                              asp-route-id="@Model.CategoryEditor.Id"
                              method="post"
                              class="admin-category-delete-form"
                              onsubmit="return confirm('Xóa loại sản phẩm này?');">
                            @Html.AntiForgeryToken()
                            <button class="table-action table-action--delete" type="submit">Xóa loại</button>
                        </form>
                    }
                </section>

                <section class="admin-form-section admin-category-list-section">
                    <div class="admin-form-section__head">
                        <h4>Danh sách loại sản phẩm</h4>
                        <p>Chọn một loại để chỉnh sửa nhanh hoặc kiểm tra số sản phẩm đang sử dụng.</p>
                    </div>

                    <div class="admin-category-list">
                        @if (Model.Categories.Count == 0)
                        {
                            <p class="admin-muted">Chưa có loại sản phẩm nào.</p>
                        }
                        else
                        {
                            @foreach (var category in Model.Categories)
                            {
                                <div class="admin-category-item @(Model.CategoryEditor.Id == category.Id ? "is-selected" : string.Empty)">
                                    <div>
                                        <strong>@category.Name</strong>
                                        <span>Slug: @category.Slug</span>
                                        <span>@(string.IsNullOrWhiteSpace(category.Description) ? "Chưa có mô tả" : category.Description)</span>
                                    </div>
                                    <div class="admin-category-item__meta">
                                        <span>@category.ProductCount sản phẩm</span>
                                        <span>@(category.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")</span>
                                        <a class="table-action table-action--edit"
                                           asp-controller="Admin"
                                           asp-action="Products"
                                           asp-route-manageCategories="true"
                                           asp-route-categoryEditId="@category.Id"
                                           asp-route-categoryId="@category.Id">Sửa loại</a>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </section>
            </div>
        </section>
    </div>
}
