@model WebThuMuaPheLieu.Models.BlogDetailViewModel
@using System.Text.RegularExpressions
@using System.Text.Json

@{
    Layout = "_HomeLayout";
    ViewData["Title"] = Model.Post.Title;
    ViewData["BodyClass"] = "blog-detail-page blog-detail-mobile-page";

    string StripHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
        {
            return string.Empty;
        }

        return Regex.Replace(html, "<.*?>", string.Empty).Trim();
    }

    string BuildPlainSummary()
    {
        var source = !string.IsNullOrWhiteSpace(Model.Post.Excerpt)
            ? Model.Post.Excerpt
            : Model.Post.Content;

        var plainText = StripHtml(source);

        if (string.IsNullOrWhiteSpace(plainText))
        {
            return "Nội dung bài viết đang được cập nhật.";
        }

        return plainText.Length > 220 ? $"{plainText[..217]}..." : plainText;
    }

    string BuildReadingTime()
    {
        var plainText = StripHtml(Model.Post.Content);
        var wordCount = string.IsNullOrWhiteSpace(plainText)
            ? 0
            : plainText.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;

        var minutes = Math.Max(1, (int)Math.Ceiling(wordCount / 220d));
        return $"{minutes} phút đọc";
    }

    string TruncateText(string? text, int maxLength)
    {
        var normalizedText = StripHtml(text);

        if (string.IsNullOrWhiteSpace(normalizedText))
        {
            return "Nội dung đang được cập nhật.";
        }

        return normalizedText.Length > maxLength
            ? $"{normalizedText[..(maxLength - 3)].TrimEnd()}..."
            : normalizedText;
    }

    var publishDate = Model.Post.PublishedAt ?? Model.Post.CreatedAt;
    var publishDateValue = publishDate ?? DateTime.Now;
    var publishDateOffset = new DateTimeOffset(publishDateValue);
    var plainSummary = BuildPlainSummary();
    var readingTime = BuildReadingTime();
    var displayCategory = string.IsNullOrWhiteSpace(Model.PrimaryCategoryName) ? "Tin tức" : Model.PrimaryCategoryName;
    var authorName = string.IsNullOrWhiteSpace(Model.AuthorName) ? "Ban biên tập Phế Liệu Hoàng Doanh" : Model.AuthorName;

    ViewData["Description"] = plainSummary;
    ViewData["Canonical"] = !string.IsNullOrWhiteSpace(Model.CurrentUrl)
        ? Model.CurrentUrl
        : $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";
    ViewData["OgType"] = "article";

    var articleSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Article",
        ["headline"] = Model.Post.Title,
        ["description"] = plainSummary,
        ["author"] = new Dictionary<string, object?>
        {
            ["@type"] = "Person",
            ["name"] = authorName
        },
        ["datePublished"] = publishDateOffset.ToString("yyyy-MM-ddTHH:mm:ssK"),
        ["dateModified"] = new DateTimeOffset(Model.Post.UpdatedAt ?? publishDateValue).ToString("yyyy-MM-ddTHH:mm:ssK"),
        ["mainEntityOfPage"] = ViewData["Canonical"],
        ["image"] = (Model.GalleryImages?.Any() == true ? Model.GalleryImages : new List<string> { Model.CoverImage })
    };
    var articleSchemaJson = JsonSerializer.Serialize(articleSchema);
}

@section Styles {
    <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet" />
    <style>
        body.blog-detail-page {
            background: #ffffff;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #1f2937;
        }

        body.blog-detail-page h1,
        body.blog-detail-page h2,
        body.blog-detail-page h3,
        body.blog-detail-page h4,
        body.blog-detail-page h5 {
            font-family: 'Manrope', sans-serif;
        }

        .blog-detail-main {
            padding: 22px 0 56px;
        }

        .blog-detail-shell {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
            padding-left: 35px;
            padding-right: 35px;
        }

        .blog-detail-breadcrumb {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
            color: #6b7280;
            font-size: 0.94rem;
        }
        @@media (max-width: 768px) {
            .section-header h2:before,
            .section-header h2:after {
                display: none;
            }
        }

        .blog-detail-breadcrumb a {
            color: #15803d;
            text-decoration: none;
            font-weight: 700;
        }

        .blog-detail-breadcrumb i {
            font-size: 0.75rem;
            color: #9ca3af;
        }

        .blog-detail-head {
            position: relative;
            width: 100%;
            margin: 0 0 34px;
            padding: 28px 32px 24px;
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 28px;
            background:
                radial-gradient(circle at top left, rgba(34, 197, 94, 0.12), transparent 32%),
                linear-gradient(180deg, #ffffff 0%, #f8fbf8 100%);
            box-shadow: 0 22px 48px rgba(15, 23, 42, 0.08);
            overflow: hidden;
        }

        .blog-detail-head::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 6px;
            background: linear-gradient(180deg, #16a34a 0%, #facc15 100%);
        }

        .blog-detail-head::after {
            content: "";
            position: absolute;
            top: 18px;
            right: 22px;
            width: 120px;
            height: 120px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(34, 197, 94, 0.14) 0%, rgba(34, 197, 94, 0) 70%);
            pointer-events: none;
        }

        .blog-detail-eyebrow {
            position: relative;
            z-index: 1;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(220, 252, 231, 0.92);
            color: #15803d;
            font-size: 0.76rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .blog-detail-eyebrow::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: currentColor;
            box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.14);
        }

        .blog-detail-title {
            position: relative;
            z-index: 1;
            max-width: none;
            width: 100%;
            margin: 0;
            color: #0f172a;
            font-size: clamp(2.2rem, 3.5vw, 4.15rem);
            font-weight: 800;
            line-height: 1.08;
            letter-spacing: -0.045em;
            text-wrap: normal;
            white-space: normal;
            overflow-wrap: break-word;
            word-break: break-word;
        }

        .blog-detail-lead {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 820px;
            margin: 18px 0 0;
            padding-left: 18px;
            border-left: 3px solid rgba(34, 197, 94, 0.28);
            color: #475569;
            font-size: clamp(1rem, 1.08vw, 1.12rem);
            line-height: 1.82;
        }

        .blog-detail-top-meta {
            position: relative;
            z-index: 1;
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-start;
            gap: 12px;
            align-items: center;
            margin-top: 22px;
        }

        .blog-detail-top-meta-item {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            min-height: 44px;
            padding: 10px 14px;
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.9);
            color: #475569;
            font-size: 0.93rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
        }

        .blog-detail-top-meta-item i {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 999px;
            background: rgba(220, 252, 231, 0.95);
            color: #15803d;
            font-size: 0.9rem;
        }

        .blog-detail-top-meta-separator {
            display: none;
        }


