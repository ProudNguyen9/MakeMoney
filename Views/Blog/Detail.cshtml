        .blog-detail-overview-stat span {
            display: block;
            color: #64748b;
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .blog-detail-section-head {
            padding: 0 2px;
        }

        .blog-detail-section-head h2 {
            margin-bottom: 10px;
            color: #1f2937;
            font-size: clamp(1.7rem, 2.2vw, 2.5rem);
        }

        .blog-detail-section-head p {
            margin: 0;
            color: #6b7280;
            line-height: 1.8;
        }

        .blog-detail-feature-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .blog-detail-feature-card {
            padding: 22px;
        }

        .blog-detail-feature-icon {
            width: 48px;
            height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: rgba(22, 163, 74, 0.12);
            color: #16a34a;
            font-size: 1.25rem;
            margin-bottom: 14px;
        }

        .blog-detail-feature-card h3 {
            margin-bottom: 10px;
            color: #1f2937;
            font-size: 1.15rem;
        }

        .blog-detail-feature-card p {
            margin: 0;
            color: #6b7280;
            line-height: 1.75;
        }

        .blog-detail-content-card {
            position: relative;
            overflow: hidden;
            padding: clamp(22px, 2.8vw, 38px);
            border: 1px solid rgba(226, 232, 240, 0.9);
            background: #ffffff;
            box-shadow: 0 18px 42px rgba(15, 23, 42, 0.07);
        }

        .blog-detail-content-card::before {
            content: none;
        }

        .blog-detail-content-header {
            display: none;
        }

        .blog-detail-body {
            max-width: none;
            padding: 0;
            color: #1f2937;
            font-size: 1.04rem;
            line-height: 1.9;
        }

        .blog-detail-body > * {
            max-width: 100%;
        }

        .blog-detail-body>*:first-child {
            margin-top: 0;
        }

        .blog-detail-body>*:last-child {
            margin-bottom: 0;
        }

        .blog-detail-body p {
            margin: 0 0 1.35rem;
            color: #334155;
        }

        .blog-detail-body>p:first-of-type {
            color: #1f2937;
            font-size: 1.12rem;
            line-height: 1.95;
        }

        .blog-detail-body h1,
        .blog-detail-body h2,
        .blog-detail-body h3,
        .blog-detail-body h4 {
            margin-top: 2.4rem;
            margin-bottom: 1rem;
            color: #0f172a;
            font-weight: 800;
            line-height: 1.28;
            letter-spacing: -0.025em;
        }

        .blog-detail-body h1 {
            font-size: clamp(1.75rem, 2.3vw, 2.45rem);
        }

        .blog-detail-body h2 {
            font-size: clamp(1.55rem, 2vw, 2.1rem);
        }

        .blog-detail-body h3 {
            font-size: clamp(1.3rem, 1.5vw, 1.65rem);
        }

        .blog-detail-body h4 {
            font-size: 1.12rem;
        }

        .blog-detail-body h2+h3,
        .blog-detail-body h3+h4 {
            margin-top: 1.2rem;
        }

        .blog-detail-body ul,
        .blog-detail-body ol {
            margin-bottom: 1.3rem;
            padding-left: 1.3rem;
        }

        .blog-detail-body ul ul,
        .blog-detail-body ol ol,
        .blog-detail-body ul ol,
        .blog-detail-body ol ul {
            width: 100%;
            margin-left: 0;
            margin-right: 0;
        }

        .blog-detail-body li {
            margin-bottom: 0.55rem;
            padding-left: 0.18rem;
        }

        .blog-detail-body strong {
            color: #0f172a;
            font-weight: 800;
        }

        .blog-detail-body hr {
            margin: 2rem 0;
            border: 0;
            border-top: 1px solid rgba(203, 213, 225, 0.8);
        }

        .blog-detail-body img,
        .post-content img {
            display: block;
            max-width: 100%;
            height: auto;
            margin: 1.9rem auto;
            border-radius: 14px;
            border: 0;
            box-shadow: none;
        }

        .blog-detail-body figure,
        .post-content figure {
            display: block;
            width: fit-content;
            max-width: 100%;
            margin: 2rem auto;
        }

        .blog-detail-body figure.image,
        .blog-detail-body figure.image_resized,
        .post-content figure.image,
        .post-content figure.image_resized {
            width: fit-content;
            max-width: 100% !important;
            margin-left: auto;
            margin-right: auto;
        }

        .blog-detail-body figure.image.image-style-align-left,
        .blog-detail-body figure.image_resized.image-style-align-left,
        .post-content figure.image.image-style-align-left,
        .post-content figure.image_resized.image-style-align-left {
            margin-left: 0;
            margin-right: auto;
        }

        .blog-detail-body figure.image.image-style-align-right,
        .blog-detail-body figure.image_resized.image-style-align-right,
        .post-content figure.image.image-style-align-right,
        .post-content figure.image_resized.image-style-align-right {
            margin-left: auto;
            margin-right: 0;
        }

        .blog-detail-body figure img,
        .post-content figure img {
            margin: 0;
            max-width: 100%;
            height: auto;
        }

        .blog-detail-body figure:not(.image):not(.image_resized) img,
        .post-content figure:not(.image):not(.image_resized) img {
            width: auto;
        }

        .blog-detail-body figure[style*="width"],
        .post-content figure[style*="width"] {
            width: min(100%, fit-content) !important;
            max-width: 100% !important;
        }

        .blog-detail-body img[style*="width"],
        .post-content img[style*="width"] {
            width: auto;
            max-width: 100% !important;
            height: auto !important;
        }

        .blog-detail-body figure.image img[style*="width"],
        .blog-detail-body figure.image_resized img[style*="width"],
        .post-content figure.image img[style*="width"],
        .post-content figure.image_resized img[style*="width"] {
            width: 100% !important;
        }

        .blog-detail-body figcaption {
            margin-top: 10px;
            color: #64748b;
            font-size: 0.9rem;
            line-height: 1.7;
            text-align: center;
        }

        .blog-detail-body blockquote {
            margin: 1.9rem 0;
            padding: 0 0 0 18px;
            border-left: 3px solid #cbd5e1;
            border-radius: 0;
            background: transparent;
            color: #475569;
            font-weight: 600;
            box-shadow: none;
        }

        .blog-detail-body blockquote p:last-child {
            margin-bottom: 0;
        }

        .blog-detail-body a {
            color: #15803d;
            font-weight: 700;
            text-decoration-thickness: 1px;
            text-underline-offset: 3px;
        }

        .blog-detail-body table {
            width: 100%;
            margin: 1.6rem 0;
            overflow: hidden;
            border-collapse: separate;
            border-spacing: 0;
            border: 1px solid rgba(226, 232, 240, 0.92);
            border-radius: 18px;
            background: #ffffff;
        }

        .blog-detail-body th,
        .blog-detail-body td {
            padding: 14px 16px;
            border-bottom: 1px solid rgba(226, 232, 240, 0.9);
            text-align: left;
            vertical-align: top;
        }

        .blog-detail-body th {
            color: #0f172a;
            font-size: 0.9rem;
            font-weight: 800;
            background: #f8fafc;
        }

        .blog-detail-body tr:last-child td {
            border-bottom: 0;
        }

        .blog-detail-share-card {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
            padding: 18px 22px;
        }

        .blog-detail-share-label {
            margin-right: 4px;
            color: #1f2937;
            font-weight: 800;
        }

        .blog-detail-share-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 999px;
            background: #f2f5ee;
            color: #334155;
            text-decoration: none;
            font-weight: 700;
            transition: all 0.25s ease;
        }

        .blog-detail-share-link:hover {
            background: #dcfce7;
            color: #166534;
            transform: translateY(-1px);
        }

        .blog-detail-sidebar {
            position: sticky;
            top: 110px;
            display: grid;
            gap: 18px;
            padding-top: 4px;
        }

        .blog-detail-sidebar .sidebar-card {
            margin-bottom: 0;
            padding: 22px;
            border-radius: 22px;
            background: #ffffff;
            box-shadow: 0 16px 34px rgba(15, 23, 42, 0.08);
            border: 1px solid rgba(226, 232, 240, 0.88);
        }

        .blog-detail-sidebar .sidebar-card h4 {
            margin: 0 0 18px;
            color: #0f172a;
            font-size: 1rem;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .blog-detail-sidebar-intro {
            margin: 0 0 16px;
            color: #64748b;
            font-size: 0.9rem;
            line-height: 1.7;
        }

        .blog-detail-category-list {
            display: grid;
            gap: 10px;
        }

        .blog-detail-category-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 14px 16px;
            border-radius: 16px;
            background: #f8fafc;
            border: 1px solid rgba(226, 232, 240, 0.92);
            color: inherit;
            text-decoration: none;
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, background 0.2s ease;
        }

        .blog-detail-category-item:hover {
            transform: translateY(-1px);
            border-color: rgba(21, 128, 61, 0.2);
            box-shadow: 0 10px 20px rgba(15, 23, 42, 0.06);
            background: #ffffff;
        }

        .blog-detail-category-item.is-active {
            border-color: rgba(21, 128, 61, 0.28);
            background: linear-gradient(135deg, rgba(220, 252, 231, 0.72), rgba(240, 253, 244, 0.95));
        }

        .blog-detail-category-item strong {
            display: block;
            margin-bottom: 4px;
            color: #0f172a;
            font-size: 0.96rem;
            line-height: 1.45;
        }

        .blog-detail-category-item span {
            display: block;
            color: #64748b;
            font-size: 0.82rem;
            line-height: 1.5;
        }

        .blog-detail-category-item-count {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 42px;
            height: 42px;
            padding: 0 10px;
            border-radius: 999px;
            background: rgba(21, 128, 61, 0.1);
            color: #15803d;
            font-size: 0.88rem;
            font-weight: 800;
        }

        .blog-detail-sidebar .mini-post {
            display: grid;
            grid-template-columns: 96px minmax(0, 1fr);
            align-items: start;
            gap: 14px;
            padding: 0;
            color: inherit;
            text-decoration: none;
            transition: opacity 0.2s ease;
        }

        .blog-detail-sidebar .mini-post+.mini-post {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid rgba(226, 232, 240, 0.9);
        }

        .blog-detail-sidebar .mini-post:hover {
            opacity: 0.86;
        }

        .blog-detail-sidebar .mini-thumb {
            width: 96px;
            height: 72px;
            overflow: hidden;
            border-radius: 12px;
            background: #f1f5f9;
            border: 0;
            box-shadow: none;
        }

        .blog-detail-sidebar .mini-thumb img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .blog-detail-sidebar .mini-post-content {
            min-width: 0;
        }

        .blog-detail-sidebar .mini-post span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 6px;
            color: #64748b;
            font-size: 0.76rem;
            font-weight: 700;
        }

        .blog-detail-sidebar .mini-post h5 {
            margin: 0 0 5px;
            color: #0f172a;
            font-size: 0.96rem;
            line-height: 1.45;
